---
// Purpose: Component - src/components/Blog/BlogHeader.astro (Blog post header: title, date, description)
import Title from "../UI/Title.astro";
import Body from "../UI/Body.astro";
import Icon from "../shared/Icon.astro";
import { patternForTheme } from "../../config/patterns";

interface Props {
  title: string;
  description: string;
  date: Date;
  theme?: string;
}

const { title, description, date, theme = "orange" } = Astro.props as Props;

/* The masthead wears the post's pattern at MID size: a card-sized tile behind
   a title would compete with the letters, and the reading column below
   already carries the huge one. The accent strip keeps its own small tile. */
const panelStyle = `--plate-pattern: url('${patternForTheme(theme)}')`;
---

<header
  class="blog-masthead pixel-frame pattern-plate pattern-plate--medium"
  style={panelStyle}
>
  <span
    class="blog-masthead-strip pattern-plate pattern-plate--small"
    aria-hidden="true"></span
  >

  {/* Eyebrow: what this is, then when it was written. */}
  <div class="blog-masthead-meta">
    <span class="blog-masthead-kicker">Article</span>
    <span class="blog-masthead-rule" aria-hidden="true"></span>

    <time datetime={date.toISOString()}>
      <Icon name="Calendar" theme={theme} class="h-5 w-5" />
      {date.toLocaleDateString()}
    </time>
  </div>

  <Title level={1} theme={theme} class="blog-masthead-title">
    {title}
  </Title>

  {
    description && (
      <Body theme={theme} class="blog-masthead-desc">
        {description}
      </Body>
    )
  }
</header>
