---
// Purpose: Component - src/components/shared/PageBackdrop.astro (Day / night page backdrop)
//
// Each listing page owns a daytime and a night-time artwork. The layer below
// carries both URLs and CSS paints whichever one matches `data-mode` on <html>
// — which the inline script in MyLayout.astro sets before first paint — so a
// page never flashes the wrong artwork and needs no JavaScript of its own.
//
// ONE LAYER, ONE DOWNLOAD: only the artwork for the current mode is requested.
// This used to be two stacked <img> elements, one per mode, and an `<img src>`
// is fetched however transparent it is — so every visitor downloaded the
// invisible half of the pair. See `styles/foundation/layoutPrimitives.css`.
//
// The blur stays on this wrapper, so it applies to the artwork without the
// image itself being pre-blurred.
import { asset } from "../../utils/asset";

interface Props {
  /** Path inside public/, e.g. "images/pageBackgrounds/BlogDay.webp". */
  day: string;
  night: string;
}

const { day, night } = Astro.props as Props;

const artStyle = `--art-day: url('${asset(day)}'); --art-night: url('${asset(night)}')`;
---

<div
  class="fixed inset-0 z-0 pointer-events-none style3d blurred-bg-layer page-backdrop"
  aria-hidden="true"
>
  <div class="mode-art page-backdrop-art" style={artStyle} />
</div>
