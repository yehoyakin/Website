---
// Purpose: Component - src/components/shared/Icon.astro (Pixel icon by name)
//
// Usage: <Icon name="Handbag" theme="green" />
// Resolves public/images/Icons/Green/Handbag_Green.png — the colour follows the
// theme name, so an icon always matches the accents of the page or card it sits
// in. Without a theme (site chrome) it uses the mode base colours assigned in
// styles/foundation/designTokens.css: --theme-main-day by day, --theme-main-night at
// night. `color` overrides both.
import {
  defaultIconColor,
  defaultIconColorNight,
  iconColorForTheme,
  iconPath,
  isIconColor,
  type IconColor,
} from "../../config/icons";
import { asset } from "../../utils/asset";

interface Props {
  name: string;
  class?: string;
  alt?: string;
  /** Theme name ("green", "orange", …) — picks the matching icon colour. */
  theme?: string;
  /** Explicit icon colour; wins over `theme`. */
  color?: IconColor;
}

const {
  name,
  class: extraClass = "h-5 w-5",
  alt = "",
  theme,
  color,
} = Astro.props as Props;

const explicitColor = color && isIconColor(color) ? color : undefined;
const hasTheme = typeof theme === "string" && theme.trim() !== "";

/* Unthemed icons are chrome, so they follow the mode: one image per base
   colour, swapped by the same data-mode attribute as the artwork. Themed icons
   keep a single file — their colour is the page / card theme. */
const modeAware = !explicitColor && !hasTheme;

const iconColor: IconColor = explicitColor ?? iconColorForTheme(theme);
const nightColor: IconColor = explicitColor ?? defaultIconColorNight;

const src = iconPath(name, iconColor);
const nightSrc = modeAware ? iconPath(name, nightColor) : undefined;

const classes = [
  "inline-block shrink-0 object-contain [image-rendering:pixelated]",
  extraClass,
]
  .filter(Boolean)
  .join(" ");

const modeImg =
  "icon-mode-img block h-full w-full object-contain [image-rendering:pixelated]";
---

{
  src && modeAware && nightSrc ? (
    <span class={`icon-mode ${extraClass}`}>
      <img
        src={asset(src)}
        alt={alt}
        aria-hidden={alt ? undefined : "true"}
        width="120"
        height="120"
        loading="lazy"
        decoding="async"
        data-icon-color={iconColor}
        class={`${modeImg} icon-mode-img--day`}
      />
      <img
        src={asset(nightSrc)}
        alt=""
        aria-hidden="true"
        width="120"
        height="120"
        loading="lazy"
        decoding="async"
        data-icon-color={nightColor}
        class={`${modeImg} icon-mode-img--night`}
      />
    </span>
  ) : (
    src && (
      <img
        src={asset(src)}
        alt={alt}
        aria-hidden={alt ? undefined : "true"}
        width="120"
        height="120"
        loading="lazy"
        decoding="async"
        data-icon-color={iconColor ?? defaultIconColor}
        class={classes}
      />
    )
  )
}
