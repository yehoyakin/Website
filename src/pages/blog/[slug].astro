---
// Purpose: Page - src/pages/blog/[slug].astro (Blog post template)

import MyLayout from "../../layouts/MyLayout.astro";

import BackLink from "../../components/shared/BackLink.astro";

import BlogBackgrounds from "../../components/Blog/BlogBackgrounds.astro";

import BlogHeader from "../../components/Blog/BlogHeader.astro";

import BlogContent from "../../components/Blog/BlogContent.astro";

import BlogSidebar from "../../components/Blog/BlogSidebar.astro";

import RailPanel from "../../components/shared/RailPanel.astro";

import { getCollection } from "astro:content";

import { asset, isRemoteUrl } from "../../utils/asset";

import { resolveThemeToken, toThemeName } from "../../config/uiDictionary";

import { patternForTheme } from "../../config/patterns";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.id },
  }));
}

const slug = Astro.params.slug;

const posts = await getCollection("blog");

const post = posts.find((entry) => entry.id === slug);

if (!post) {
  throw new Response("Post not found", { status: 404 });
}

const markdownSource = post.body ?? "";

const IMAGE_RE = /!\[([^\]]*)\]\(((?:[^()]+|\([^)]*\))*)\)/g;

const parseMarkdownImage = (src: string, alt = "") => ({
  src: isRemoteUrl(src.trim()) ? src.trim() : asset(src.trim()),
  alt: alt.trim(),
});

const parseMarkdownBlocks = (text: string) => {
  const blocks = [];
  const lines = text.replace(/\r\n/g, "\n").split("\n");
  let paragraphBuffer: string[] = [];
  let galleryBuffer: Array<{ src: string; alt: string }> = [];
  let listBuffer: { ordered: boolean; items: string[] } | null = null;

  const parseInlineDescription = (raw: string | undefined) => {
    if (!raw) return "";
    return raw
      .trim()
      .replace(/^['"“”]+/, "")
      .replace(/['"“”]+$/, "")
      .trim();
  };

  const flushParagraph = () => {
    if (!paragraphBuffer.length) return;
    const value = paragraphBuffer.join(" ").trim();
    if (value) {
      blocks.push({ type: "paragraph", text: value });
    }
    paragraphBuffer = [];
  };

  const flushGallery = () => {
    if (!galleryBuffer.length) return;
    if (galleryBuffer.length === 1) {
      blocks.push({ type: "image", ...galleryBuffer[0] });
    } else {
      blocks.push({ type: "gallery", images: galleryBuffer });
    }
    galleryBuffer = [];
  };

  const flushList = () => {
    if (!listBuffer || !listBuffer.items.length) {
      listBuffer = null;
      return;
    }

    blocks.push({
      type: "list",
      ordered: listBuffer.ordered,
      items: listBuffer.items,
    });
    listBuffer = null;
  };

  for (let i = 0; i < lines.length; i += 1) {
    const line = lines[i].trim();

    if (!line) {
      flushParagraph();
      flushGallery();
      flushList();
      continue;
    }

    const markdownBulletMatch = line.match(/^[-*+]\s+(.+)$/);
    if (markdownBulletMatch) {
      flushParagraph();
      flushGallery();
      if (!listBuffer || listBuffer.ordered) {
        flushList();
        listBuffer = { ordered: false, items: [] };
      }
      listBuffer.items.push(markdownBulletMatch[1].trim());
      continue;
    }

    const markdownOrderedMatch = line.match(/^(\d+)[.)]\s+(.+)$/);
    if (markdownOrderedMatch) {
      flushParagraph();
      flushGallery();
      if (!listBuffer || !listBuffer.ordered) {
        flushList();
        listBuffer = { ordered: true, items: [] };
      }
      listBuffer.items.push(markdownOrderedMatch[2].trim());
      continue;
    }

    const htmlListMatch = line.match(/^<(ol|ul)>$/i);
    if (htmlListMatch) {
      flushParagraph();
      flushGallery();
      flushList();

      const ordered = htmlListMatch[1].toLowerCase() === "ol";
      const htmlItems: string[] = [];
      let j = i + 1;

      while (j < lines.length) {
        const htmlLine = lines[j].trim();
        if (!htmlLine) {
          j += 1;
          continue;
        }

        if (htmlLine.toLowerCase() === `</${ordered ? "ol" : "ul"}>`) {
          break;
        }

        const htmlListItemMatch = htmlLine.match(/^<li\b[^>]*>\s*(.*?)\s*<\/li>\s*$/i);
        if (htmlListItemMatch) {
          const text = htmlListItemMatch[1].trim();
          if (text) htmlItems.push(text);
          j += 1;
          continue;
        }

        const htmlListItemOpenMatch = htmlLine.match(/^<li\b[^>]*>\s*(.*)$/i);
        if (htmlListItemOpenMatch) {
          const text = htmlListItemOpenMatch[1].trim();
          if (text) htmlItems.push(text);
          j += 1;
          continue;
        }

        const htmlListItemCloseMatch = htmlLine.match(/^(.*)<\/li>\s*$/i);
        if (htmlListItemCloseMatch) {
          const text = htmlListItemCloseMatch[1].trim();
          if (text) htmlItems.push(text);
          j += 1;
          continue;
        }

        break;
      }

      i = j;
      if (htmlItems.length) {
        blocks.push({
          type: "list",
          ordered,
          items: htmlItems,
        });
      }
      continue;
    }

    if (listBuffer) {
      if (line === "</ol>" || line === "</ul>") {
        flushList();
        continue;
      }

      const listItemMatch = line.match(/^<li>\s*(.*?)\s*<\/li>$/i);
      if (listItemMatch) {
        const text = listItemMatch[1].trim();
        if (text) {
          listBuffer.items.push(text);
        }
        continue;
      }

      const listItemOpenMatch = line.match(/^<li>\s*(.*)$/i);
      if (listItemOpenMatch) {
        const text = listItemOpenMatch[1].trim();
        if (text) {
          listBuffer.items.push(text);
        }
        continue;
      }

      const listItemCloseMatch = line.match(/^(.*)<\/li>\s*$/i);
      if (listItemCloseMatch) {
        const text = listItemCloseMatch[1].trim();
        if (text) {
          listBuffer.items.push(text);
        }
        flushList();
        continue;
      }

      flushList();
    }

    const backgroundMatch = line.match(/^\[background\[(\d+)\]\]$/);
    if (backgroundMatch) {
      flushParagraph();
      flushGallery();
      blocks.push({
        type: "background",
        index: Number.parseInt(backgroundMatch[1], 10),
      });
      continue;
    }

    const headingMatch = line.match(/^(#{1,6})\s+(.+)$/);
    if (headingMatch) {
      flushParagraph();
      flushGallery();
      blocks.push({
        type: "heading",
        level: headingMatch[1].length,
        text: headingMatch[2].trim(),
      });
      continue;
    }

    const sceneMatch = line.match(/^\[scene\[((?:\d+\s*,\s*)*\d+)(?:,\s*(wide|large|full))?\](?:,\s*(.*?))?\]$/);
    if (sceneMatch) {
      flushParagraph();
      const rawIndexes = sceneMatch[1]
        .split(",")
        .map((value) => Number.parseInt(value.trim(), 10))
        .filter((value) => Number.isInteger(value) && value >= 0);
      const inlineCaption = parseInlineDescription(sceneMatch[3]);

      if (rawIndexes.length > 0) {
        const images = rawIndexes
          .map((index) => {
            const scene = scenes[index];
            if (!scene) return null;
            return {
              src: scene.image,
              alt: inlineCaption || scene.caption || "",
            };
          })
          .filter(Boolean) as Array<{ src: string; alt: string }>;

        if (images.length > 0) {
          galleryBuffer.push(...images);
          continue;
        }
      }
      continue;
    }

    /* Uploaded clips and embeds. The parser used to skip these markers, so
       `[video[0]]` fell through to the paragraph buffer and a post rendered the
       marker as text instead of the figure — no <video> or <iframe> at all. */
    const videoMatch = line.match(
      /^\[video\[(\d+)(?:,\s*(wide|large|full))?\](?:,\s*(.*?))?\]$/,
    );
    if (videoMatch) {
      flushParagraph();
      flushGallery();
      blocks.push({
        type: "video",
        index: Number.parseInt(videoMatch[1], 10),
        size: videoMatch[2] || undefined,
        caption: parseInlineDescription(videoMatch[3]) || undefined,
      });
      continue;
    }

    const imageMatches = [...line.matchAll(IMAGE_RE)];
    if (imageMatches.length > 0 && line.replace(IMAGE_RE, "").trim() === "") {
      flushParagraph();
      galleryBuffer.push(...imageMatches.map((match) => parseMarkdownImage(match[2], match[1])));
      continue;
    }

    flushGallery();
    paragraphBuffer.push(line);
  }

  flushParagraph();
  flushGallery();
  flushList();
  return blocks;
};

const cards = post.data.cards ?? [];

/* ---------------------------------------------------------
 * Normalize content scenes through asset()
 * --------------------------------------------------------- */

const scenes = Array.isArray(post.data.scenes)
  ? post.data.scenes.map((s) => ({
      image: asset(s.image),
      align: s.align ?? "center",
    }))
  : [];

/* ---------------------------------------------------------
 * Normalize content videos through asset()
 * Remote links (YouTube, Vimeo, hosted files) are kept as-is;
 * everything else is treated as a path inside public/.
 * --------------------------------------------------------- */

const resolveMedia = (path: string) => (isRemoteUrl(path) ? path : asset(path));

const videos = Array.isArray(post.data.videos)
  ? post.data.videos.map((v) => ({
      src: resolveMedia(v.src),
      poster: v.poster ? resolveMedia(v.poster) : undefined,
      align: v.align ?? "center",
      size: v.size ?? "auto",
      caption: v.caption,
      title: v.title,
      type: v.type ?? "auto",
    }))
  : [];

/* ---------------------------------------------------------
 * Normalize backgrounds through asset()
 * --------------------------------------------------------- */

const rawBackgrounds = post.data.backgrounds ?? [];

const backgrounds = Array.isArray(rawBackgrounds)
  ? rawBackgrounds.map((b) => ({
      image: asset(b.image),
    }))
  : [];

/* ---------------------------------------------------------
 * Replace [background[x]] markers in rendered body HTML
 * with invisible runtime anchors.
 * --------------------------------------------------------- */

const bodyBlocks = parseMarkdownBlocks(markdownSource);

/* ---------------------------------------------------------
 * Hero / background settings
 * --------------------------------------------------------- */

const heroImage = post.data.background ? asset(post.data.background) : "";

const backgroundBlur = post.data.backgroundBlur ?? 0;

const backgroundOpacity = post.data.backgroundOpacity ?? 1;

const backgroundParallax = post.data.backgroundParallax ?? 0.2;

/* ---------------------------------------------------------
 * Theme resolution
 * --------------------------------------------------------- */

const themeName = toThemeName(post.data.theme);

const postDynamicToken = resolveThemeToken(themeName);

/* ---------------------------------------------------------
 * Base URL
 * --------------------------------------------------------- */

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

/* ---------------------------------------------------------
 * Preload hero + article backgrounds
 * --------------------------------------------------------- */

const imagesToPreload = [heroImage, ...backgrounds.map((b) => b.image)].filter(
  Boolean,
);
---

<MyLayout
  title={post.data.title}
  theme={themeName}
  page="blog"
  preloadImages={imagesToPreload}
>
  <!-- -----------------------------------------------------
       BACK LINK
       ----------------------------------------------------- -->

  <div class="relative z-30">
    <BackLink href={`${baseUrl}blog/`} text="Back to blog" />
  </div>

  <!-- -----------------------------------------------------
       BLOG CONTENT
       ----------------------------------------------------- -->

  <section
    id="blog-article-section"
    class="pattern-plate pattern-plate--medium pattern-plate--ghost relative py-12 md:py-16 px-4 max-w-4xl mx-auto w-full"
    /* The post's pattern tile is set here so the reading column inside can
       inherit it: the texture belongs to the post's theme, and this section is
       the element that already carries that theme's colour. */
    style={`--project-tag-color: ${postDynamicToken}; --project-tag-color-dark: var(--theme-${themeName}-dark); --plate-pattern: url('${patternForTheme(themeName)}')`}
  >
    <!-- Background rendering layer -->

    <BlogBackgrounds
      backgrounds={backgrounds}
      heroImage={heroImage}
      backgroundBlur={backgroundBlur}
      backgroundOpacity={backgroundOpacity}
    />

    <!-- Article -->

    <div class="mt-12 w-full min-w-0">
      <div class="flex flex-col gap-6 sm:gap-8 w-full min-w-0">
        <BlogHeader
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
          theme={themeName}
        />

        <BlogContent blocks={bodyBlocks} scenes={scenes} videos={videos} theme={themeName} />
      </div>
    </div>

    <!-- ---------------------------------------------------
         End-of-article sentinel
         --------------------------------------------------- -->

    <div id="blog-end-sentinel" class="w-full h-1"></div>
  </section>

  <!-- -----------------------------------------------------
       THAT'S ALL MESSAGE
       ----------------------------------------------------- -->

  <div id="thats-all-msg" class="thats-all-overlay">
    <span class="thats-all-text"> That's all for today folks! </span>
  </div>

  <!-- -----------------------------------------------------
       FLOATING SIDEBAR
       ----------------------------------------------------- -->

  {/* The same rail panel the landing uses for its contacts tab: the handle
      glyph and the panel's accent are the only things this page decides. */}
  <RailPanel
    id="links"
    label="Toggle this post's links"
    icon="document"
    theme={themeName}
    style={`--project-tag-color: ${postDynamicToken}; --project-tag-color-dark: var(--theme-${themeName}-dark); --plate-pattern: url('${patternForTheme(themeName)}')`}
    panelClass="links-panel links-panel--scroll w-80"
  >
    <BlogSidebar cards={cards} theme={themeName} />
  </RailPanel>

  <!-- The overlay's styles live in styles/overlays/articleEndOverlay.css -->

  <!-- -----------------------------------------------------
       BLOG PAGE CONTROLLERS
       -----------------------------------------------------

       IMPORTANT:

       data-astro-rerun makes this script execute again when
       Astro performs a client-side navigation.

       Before creating the new controller we destroy the
       previous page's controller.

       This prevents old blog pages from leaving scroll,
       resize, sidebar, or IntersectionObserver listeners
       behind.
       ----------------------------------------------------- -->

  <script
    define:vars={{
      backgrounds,
      backgroundOpacity,
      backgroundBlur,
      backgroundParallax,
    }}
    data-astro-rerun
  >
    /* =====================================================
       CLEAN UP PREVIOUS BLOG PAGE
       ===================================================== */
    if (window.__blogPageCleanup) {
      try {
        window.__blogPageCleanup();
      } catch (error) {
        console.warn("[Blog] Failed to clean previous page:", error);
      }
    }

    /* =====================================================
       BACKGROUND CONFIGURATION
       ===================================================== */
    const currentBackgrounds = Array.isArray(backgrounds)
      ? backgrounds.map((background) => ({
          image: background.image,
        }))
      : [];
    const bgOpacity = Number(backgroundOpacity ?? 1);
    const bgBlur = Number(backgroundBlur ?? 0);
    const parallaxFactor = Number(backgroundParallax ?? 0.2);

    /* =====================================================
       BACKGROUND STATE
       ===================================================== */
    let markerTops = [];
    let layerRanges = [];
    let resizeFrame = 0;
    let destroyed = false;

    /* =====================================================
       HELPERS
       ===================================================== */
    const clamp = (value, min, max) => {
      return Math.min(max, Math.max(min, value));
    };

    /* =====================================================
       FIND MARKERS
       =====================================================
       Each marker is converted into an absolute document
       position.
       Example:
       [background[0]]
       [background[1]]
       [background[2]]
       becomes:
       marker 0 -> document Y
       marker 1 -> document Y
       marker 2 -> document Y
       ===================================================== */
    const getMarkerTops = () => {
      const markers = document.querySelectorAll(".bg-marker");
      if (!markers.length) {
        return [];
      }
      return Array.from(markers)
        .map((element) => {
          let top = 0;
          let node = element;
          while (node) {
            top += node.offsetTop;
            node = node.offsetParent;
          }
          const index = Number.parseInt(element.dataset.bgIndex ?? "0", 10);
          return {
            top,
            index,
          };
        })
        .filter((marker) => {
          return (
            Number.isInteger(marker.index) &&
            marker.index >= 0 &&
            marker.index < currentBackgrounds.length
          );
        })
        .sort((a, b) => {
          return a.top - b.top;
        });
    };

    /* =====================================================
       CALCULATE EACH BACKGROUND'S PARALLAX RANGE
       ===================================================== */
    const computeLayerRanges = () => {
      const total = currentBackgrounds.length;
      layerRanges = new Array(total).fill(null);
      if (!total) {
        return;
      }
      const documentHeight = Math.max(
        document.body?.scrollHeight ?? 0,
        document.documentElement?.scrollHeight ?? 0,
      );

      /*
       * No markers:
       *
       * Background 0 is used for the whole article.
       */
      if (!markerTops.length) {
        layerRanges[0] = {
          start: 0,
          end: Math.max(1, documentHeight),
        };
        return;
      }

      /*
       * Each background gets its own segment.
       *
       * The first marker for a background determines
       * where that background starts.
       *
       * The next marker belonging to another background
       * determines where it ends.
       */
      for (let i = 0; i < markerTops.length; i++) {
        const { index, top } = markerTops[i];

        /*
         * Duplicate markers for the same background
         * don't reset its range.
         */
        if (layerRanges[index]) {
          continue;
        }
        let end = Math.max(1, documentHeight);
        for (let j = i + 1; j < markerTops.length; j++) {
          if (markerTops[j].index !== index) {
            end = markerTops[j].top;
            break;
          }
        }
        layerRanges[index] = {
          start: index === 0 ? 0 : top,
          end: Math.max(top + 1, end),
        };
      }
    };

    /* =====================================================
       UPDATE BACKGROUNDS
       ===================================================== */
    const updateBackgrounds = () => {
      if (destroyed) {
        return;
      }
      if (!currentBackgrounds.length) {
        return;
      }

      /*
       * The viewport center is used as the focus point.
       *
       * This replaces the old "focus" variable issue and
       * gives us one consistent coordinate system.
       */
      const centerLine = window.scrollY + window.innerHeight * 0.5;

      /* ---------------------------------------------------
         Determine active background
         --------------------------------------------------- */
      let activeIndex = 0;
      for (let i = 0; i < markerTops.length; i++) {
        if (markerTops[i].top <= centerLine) {
          activeIndex = markerTops[i].index;
        } else {
          break;
        }
      }
      activeIndex = clamp(activeIndex, 0, currentBackgrounds.length - 1);

      /* ---------------------------------------------------
         Parallax amplitude
         --------------------------------------------------- */
      const amplitude = clamp(parallaxFactor, 0, 0.19) * window.innerHeight;

      /* ---------------------------------------------------
         Calculate offset for one background
         --------------------------------------------------- */
      const offsetForLayer = (index) => {
        const range = layerRanges[index];

        /*
         * A background without a valid range keeps the
         * maximum positive offset.
         */
        if (!range) {
          return amplitude;
        }
        const segmentLength = Math.max(1, range.end - range.start);
        const progress = clamp(
          (centerLine - range.start) / segmentLength,
          0,
          1,
        );

        /*
         * +A at beginning
         *  0 in middle
         * -A at end
         */
        return amplitude * (1 - 2 * progress);
      };

      /* ---------------------------------------------------
         Apply state to current background elements
         --------------------------------------------------- */
      currentBackgrounds.forEach((background, index) => {
        const backgroundElement = document.getElementById(
          `dynamic-bg-${index}`,
        );
        if (!backgroundElement) {
          return;
        }

        /*
         * Set image every update so the element always
         * belongs to the current page's background data.
         */
        backgroundElement.style.backgroundImage = `url("${background.image}")`;
        /* Blur travels as a custom property, not as an inline `filter`: the
           block dissolve in base/layout.css animates `filter`, and the
           animation's final keyframe would otherwise erase an inline value. */
        backgroundElement.style.setProperty("--bg-blur", `${bgBlur * 24}px`);
        backgroundElement.style.transform = `translate3d(0, ${offsetForLayer(index)}px, 0)`;
        const isActive = index === activeIndex;
        backgroundElement.style.opacity = isActive ? String(bgOpacity) : "0";
        backgroundElement.dataset.active = isActive ? "1" : "0";
      });
    };

    /* =====================================================
       MEASURE EVERYTHING
       ===================================================== */
    const remeasure = () => {
      if (destroyed) {
        return;
      }
      markerTops = getMarkerTops();
      computeLayerRanges();
      updateBackgrounds();
    };

    /* =====================================================
       QUEUED MEASUREMENT
       =====================================================
       ResizeObserver can fire several times while fonts,
       images and layout settle.
       requestAnimationFrame prevents excessive recalculation.
       ===================================================== */
    const queueRemeasure = () => {
      if (destroyed) {
        return;
      }
      if (resizeFrame) {
        return;
      }
      resizeFrame = window.requestAnimationFrame(() => {
        resizeFrame = 0;
        remeasure();
      });
    };

    /* =====================================================
       SCROLL
       ===================================================== */
    const onScroll = () => {
      updateBackgrounds();
    };

    /* =====================================================
       RESIZE
       ===================================================== */
    const onResize = () => {
      queueRemeasure();
    };

    /* =====================================================
       RESIZE OBSERVER
       =====================================================
       `html, body { height: 100% }` (base/rules.css) pins the
       <body> box to the viewport height, so it never changes
       size when the article grows. Observing <body> therefore
       never fires and the measurement taken before the scene
       images decode is never corrected.
       Observe the wrappers that actually grow with the article
       instead, so late layout changes are picked up.
       ===================================================== */
    const resizeTargets = [
      document.querySelector("main"),
      document.getElementById("blog-content"),
    ].filter(Boolean);
    const resizeObserver = new ResizeObserver(() => {
      queueRemeasure();
    });
    resizeTargets.forEach((target) => {
      resizeObserver.observe(target);
    });
    if (!resizeTargets.length && document.body) {
      resizeObserver.observe(document.body);
    }

    /* =====================================================
       EVENT REGISTRATION
       ===================================================== */
    window.addEventListener("scroll", onScroll, {
      passive: true,
    });
    window.addEventListener("resize", onResize);

    /* =====================================================
       INITIAL MEASUREMENT
       ===================================================== */
    remeasure();

    /*
     * Run another measurement on the next frame.
     *
     * This catches layout changes caused by the current
     * page becoming visible during an Astro transition.
     */
    window.requestAnimationFrame(() => {
      if (!destroyed) {
        remeasure();
      }
    });

    /*
     * Cold-load safety net.
     *
     * On an uncached first load the scene images and webfonts
     * are still decoding when the script runs, so the article is
     * far shorter than its final layout. The ResizeObserver above
     * catches most of the growth, but a font swap can shift marker
     * positions without changing any observed box, and the last
     * image to decode can land after the observer's final frame.
     *
     * Re-measure once every image has loaded and once the webfonts
     * are ready so the first load always matches a reload.
     */
    if (document.readyState === "complete") {
      /* Script re-ran after load — measure on the next frame. */
      queueRemeasure();
    } else {
      window.addEventListener("load", queueRemeasure, {
        once: true,
      });
    }
    if (document.fonts?.ready) {
      document.fonts.ready
        .then(() => {
          queueRemeasure();
        })
        .catch(() => {
          /* Font loading API unavailable — the load event covers us. */
        });
    }

    /* The rail panel's own behaviour (hover peek, tap to select, click-away to
       close) is shared with the landing's contacts tab and lives in
       scripts/railPanel.js, loaded once by layouts/MyLayout.astro. */

    /* =====================================================
       THAT'S ALL MESSAGE
       ===================================================== */
    const sentinel = document.getElementById("blog-end-sentinel");
    const thatsAllMessage = document.getElementById("thats-all-msg");
    let thatsAllObserver = null;
    let thatsAllTimeout = 0;
    if (sentinel && thatsAllMessage) {
      let hasShown = false;
      thatsAllObserver = new IntersectionObserver(
        (entries) => {
          if (destroyed) {
            return;
          }
          entries.forEach((entry) => {
            if (entry.isIntersecting && !hasShown) {
              hasShown = true;
              thatsAllMessage.classList.add("visible");
              thatsAllTimeout = window.setTimeout(() => {
                if (!destroyed) {
                  thatsAllMessage.classList.remove("visible");
                }
              }, 2500);
              thatsAllObserver?.unobserve(sentinel);
            }
          });
        },
        {
          threshold: 0.5,
        },
      );
      thatsAllObserver.observe(sentinel);
    }

    /* =====================================================
       PAGE CLEANUP
       ===================================================== */
    const cleanup = () => {
      if (destroyed) {
        return;
      }
      destroyed = true;

      /* Cancel queued measurement */
      if (resizeFrame) {
        window.cancelAnimationFrame(resizeFrame);
        resizeFrame = 0;
      }

      /* Remove background listeners */
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onResize);

      /* Remove cold-load measurement hooks */
      window.removeEventListener("load", queueRemeasure);

      /* Remove ResizeObserver */
      resizeObserver.disconnect();

      /* Remove "That's all" observer */
      if (thatsAllObserver) {
        thatsAllObserver.disconnect();
        thatsAllObserver = null;
      }

      /* Remove timeout */
      if (thatsAllTimeout) {
        window.clearTimeout(thatsAllTimeout);
        thatsAllTimeout = 0;
      }

      /*
       * Clear active state from the page's background
       * elements before the next page takes over.
       */
      currentBackgrounds.forEach((_background, index) => {
        const backgroundElement = document.getElementById(
          `dynamic-bg-${index}`,
        );
        if (!backgroundElement) {
          return;
        }
        backgroundElement.style.opacity = "0";
        backgroundElement.style.transform = "";
        backgroundElement.dataset.active = "0";
      });
    };

    /* =====================================================
       REGISTER GLOBAL CLEANUP
       ===================================================== */
    window.__blogPageCleanup = cleanup;
  </script>
</MyLayout>
