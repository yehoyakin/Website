---
// Purpose: Component - src/components/shared/ModeToggle.astro (Day / night switch)
//
// Pinned to the top-right corner of every page by MyLayout.astro. The sun is
// shown in night mode (click it to go back to day), the moon in day mode.
// Behaviour lives in scripts/modeToggle.js; colours in
// styles/components/modeToggle.css + styles/base/timeColors.css.
//
// The sun / moon are pixel icons from the shared registry (config/icons.ts),
// not inline SVGs, so they match the artwork used across the site.
import Icon from "./Icon.astro";

// Page theme, passed down from MyLayout, so the sun / moon use the same icon
// colour as the rest of the page. No theme (site pages) keeps the default blue.
interface Props {
  theme?: string;
}

const { theme } = Astro.props as Props;
---

<button
  id="mode-toggle"
  class="mode-toggle"
  type="button"
  aria-label="Switch to night mode"
  aria-pressed="false"
  title="Switch to night mode"
>
  <Icon name="sun" theme={theme} class="mode-toggle-icon mode-toggle-icon--sun" />

  <Icon name="moon" theme={theme} class="mode-toggle-icon mode-toggle-icon--moon" />
</button>
