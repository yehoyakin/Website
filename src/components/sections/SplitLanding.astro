---
// Purpose: Section - src/components/sections/SplitLanding.astro (Split hero landing component)
import Portrait from "../shared/MyImage.astro";
import Card from "./Card.astro";
import Link from "../shared/Link.astro";
import { patternForTheme } from "../../config/patterns";

interface CardData {
  href: string;
  tag: string;
  title: string;
  description: string;
  actionText: string;
  theme?: string;
  imageSrc: string;
  /** Artwork shown instead of imageSrc while the page is in night mode. */
  imageSrcNight?: string;
}

interface Credit {
  href: string;
  text: string;
}

interface Props {
  /** Optional backdrop image. Omit it to use the flat overlay only. */
  background?: string;
  left: CardData;
  right: CardData;
  /** Outbound credits in the footer bar, one button each, split by a pipe. */
  credits?: Credit[];
}

const { background, left, right, credits = [] } = Astro.props as Props;
---

{/* Allow the landing section to grow vertically as content expands. */}
<section class="relative flex-1 w-full h-full">
  {
    background && (
      <div
        class="absolute inset-0 bg-cover bg-center opacity-20 pointer-events-none"
        style={`background-image: url('${background}')`}
      />
    )
  }

  <div class="absolute inset-0 bg-[var(--time-scrim)] pointer-events-none"></div>

  <div class="relative z-10 flex min-h-full flex-col justify-between">
    <div class="grid grid-cols-1 gap-0 md:grid-cols-2 flex-1 w-full min-h-0">
      <div class="w-full h-full min-h-[12rem] md:min-h-[22rem]">
        <Card
          href={left.href}
          tag={left.tag}
          title={left.title}
          description={left.description}
          actionText={left.actionText}
          theme={left.theme ?? "orange"}
          class="h-full w-full border-b-[var(--outline-width)] border-[color:var(--time-border-soft)] md:border-b-0 md:border-r-[var(--outline-width)]"
        >
          <Portrait
            slot="background"
            src={left.imageSrc}
            srcNight={left.imageSrcNight}
            size="xl"
          />
        </Card>
      </div>

      {/* RIGHT CARD CONTAINER */}
      <div class="w-full h-full min-h-[12rem] md:min-h-[22rem]">
        <Card
          href={right.href}
          tag={right.tag}
          title={right.title}
          description={right.description}
          actionText={right.actionText}
          theme={right.theme ?? "orange"}
          class="h-full w-full"
        >
          <Portrait
            slot="background"
            src={right.imageSrc}
            srcNight={right.imageSrcNight}
            size="xl"
          />
        </Card>
      </div>
    </div>

    {
      /* FOOTER BAR — credits, patterned like every other panel.

         This bar is site chrome, not a project panel, so its buttons wear the
         MODE base colour (`--icon-accent`: white by day, the night shade after
         dark) instead of a theme, exactly like the contact links. The texture
         is the day base motif for the same reason: the tiles are black-and-white
         silhouettes blended in `screen`, so the panel underneath supplies the
         colour and the motif stays chrome-flavoured. The plate fill is the
         shared one, so it follows the day / night tint like every pattern. */
    }
    <div
      class="pattern-plate pattern-plate--small relative shrink-0 border-t border-[color:var(--time-border-soft)] px-3 py-3 sm:px-8 sm:py-5 backdrop-blur-md"
      style={`--project-tag-color: var(--icon-accent); --plate-pattern: url('${patternForTheme("white")}')`}
    >
      <div class="credits-row">
        {
          credits.map((credit, index) => (
            <>
              {index > 0 && (
                <span
                  class="text-sm text-[color:var(--time-ink-muted)]"
                  aria-hidden="true"
                >
                </span>
              )}
              <Link
                href={credit.href}
                text={credit.text}
                external
                class="whitespace-nowrap"
              />
            </>
          ))
        }
      </div>
    </div>
  </div>
</section>
