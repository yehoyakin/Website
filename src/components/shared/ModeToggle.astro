---
// Purpose: Component - src/components/shared/ModeToggle.astro (Day / night switch)
//
// Pinned to the top-right corner of every page by MyLayout.astro. The sun is
// shown in night mode (click it to go back to day), the moon in day mode.
// Behaviour lives in scripts/modeToggle.js; colours in
// styles/components/modeToggle.css + styles/base/timeColors.css.
//
// The sun / moon are pixel icons from the shared registry (config/icons.ts),
// not inline SVGs, so they match the artwork used across the site.
import Icon from "./Icon.astro";
import { defaultIconColor, defaultIconColorNight } from "../../config/icons";

// The switch does NOT follow a page theme: it is the control that changes the
// mode, so it wears that mode's base colour. Both base colours are assigned in
// styles/base/tokens.css (--theme-main-day / --theme-main-night). The moon is
// only visible by day and the sun only at night (see modeToggle.css), so each
// draws in the colour of the mode it belongs to and is never the wrong shade.
---

<button
  id="mode-toggle"
  class="mode-toggle icon-button"
  type="button"
  aria-label="Switch to night mode"
  aria-pressed="false"
  title="Switch to night mode"
>
  <Icon
    name="sun"
    color={defaultIconColorNight}
    class="mode-toggle-icon mode-toggle-icon--sun"
  />

  <Icon
    name="moon"
    color={defaultIconColor}
    class="mode-toggle-icon mode-toggle-icon--moon"
  />
</button>
