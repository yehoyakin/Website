---
// Purpose: Section - src/components/sections/ContactPanel.astro (Top-right contact quicklinks)
// See: file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/chrome/pixelChrome/linkPanels.css, file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/chrome/sideRails.css
//
// A rail panel (shared/RailPanel.astro) filled with the site's contact links.
// It is the same control a blog post uses for its links: one component, one
// behaviour (scripts/railPanel.js), one stylesheet (chrome/sideRails.css).
import SocialLink from "../shared/Link.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/shared/Link.astro
import RailPanel from "../shared/RailPanel.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/shared/RailPanel.astro
import { patternForTheme } from "../../config/patterns";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/config/patterns.ts

// This panel is site chrome, not content, so it wears the MODE base colour
   // rather than a theme: `--icon-accent` is the day base colour by day and the
   // night one at night (base/timeColors.css), the same token the unthemed icons
   // are drawn in. A fixed theme here painted the links purple in both modes and
   // on every page it floated over.

const links = [
  { href: "mailto:joaquinignacio.herrerabriones@email.com", text: "Email", external: false, icon: "email" },
  { href: "https://github.com/yehoyakin", text: "GitHub", external: true, icon: "github" },
  { href: "https://gitlab.com/yehoyakin", text: "GitLab", external: true, icon: "internet" },
  { href: "https://www.linkedin.com/in/joaquín-herrera-366b2a175", text: "LinkedIn", external: true, icon: "internet" },
  { href: "discord://discord.com/users/399731844825874432", text: "Discord", external: true, icon: "discord" }
];
---

<RailPanel
  id="contacts"
  label="Toggle contact links"
  icon="contacts"
  /* The same plate as a post's links panel (chrome/pixelChrome/linkPanels.css): the pixel frame and the white motif, tinted by the mode base colour, so the panel follows day / night rather than a page theme. The dark half is a real shade of the accent, so the frame and the chips band the way the themed panels do. */
  style={`--project-tag-color: var(--icon-accent); --project-tag-color-dark: color-mix(in srgb, var(--icon-accent) 55%, var(--time-black)); --plate-pattern: url('${patternForTheme("white")}')`}
  /* Same panel shape as the post's links rail: the scroll-capped plate at the same width, and the buttons in one merged column of full-width chips. */
  panelClass="links-panel links-panel--scroll w-80"
>
  <div class="links-panel-links links-panel-links--merged">
    {
      links.map((link) => (
        <SocialLink
          href={link.href}
          text={link.text}
          external={link.external}
          icon={link.icon}
          tinted
          /* The accent pair above inherits in: `--icon-accent` is the day colour by day and the night colour at night, so the tiles keep following the mode with the themed tile's white outline. */
        />
      ))
    }
  </div>
</RailPanel>
