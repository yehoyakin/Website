---
// Purpose: Component - src/components/shared/BackLink.astro (Top-left back link)
import Icon from "./Icon.astro";

interface Props {
  href?: string;
  text?: string;
}

const { href, text = "Back to home" } = Astro.props;

// Resolve the base URL so links work correctly in production builds.
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

// Prefer an explicit link when provided; otherwise fall back to the site root.
const resolvedHref = href || baseUrl;

/* Site chrome, not page content: the control follows the mode base colours
   the same way the day / night switch does. The plate comes from
   --time-button-fill / --time-button-ink (styles/base/responsive.css), and the
   arrow is left unthemed so Icon.astro renders its day / night pair. */
const classes = [
  "back-link fixed top-6 left-6 z-50 text-base uppercase tracking-wider",
  "transition-all duration-75 ease-[var(--ease-press)]",
  "hover:scale-[1.03] hover:brightness-110",
].join(" ");
---

<a href={resolvedHref} class={classes}>
  {/* The arrow is artwork now, so the label is text only. */}
  <span class="flex items-center gap-2">
    <Icon name="arrow-left" class="h-5 w-5" />
    <span>{text}</span>
  </span>
</a>
