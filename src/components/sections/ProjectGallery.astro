---
// Purpose: Component - src/components/sections/ProjectGallery.astro (Project cards on the portfolio listing)
// See: file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/portfolio/galleryThumbnailSlide.css, file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/carousel/carouselLayout.css, file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/card/retroCard.css
import { asset } from "../../utils/asset";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/utils/asset.ts
import { resolveThemeToken, toThemeName } from "../../config/uiDictionary";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/config/uiDictionary.ts
import { patternForTheme } from "../../config/patterns";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/config/patterns.ts
import Title from "../UI/Title.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/UI/Title.astro
import Body from "../UI/Body.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/UI/Body.astro

interface Props {
  projects: {
    id: string;
    data: any;
  }[];
}

const { projects } = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<div id="project-gallery" class="project-gallery">
  {/* `data-carousel-nav="on"` is this strip's own switch — see scripts/cardCarousel.js. It builds the arrow + numbered navigator and hides the browser's scrollbar for this strip (styles/carousel/carouselLayout.css). Set it to "off" to hand the strip back to the native scrollbar. */}
  <div
    class="card-carousel card-carousel--listing"
    data-carousel
    data-carousel-nav="on"
    data-carousel-item=".card-carousel-item"
    data-carousel-label="Projects"
  >
    <div class="card-carousel-track" data-carousel-track>
      {
        projects.map((project, index) => {
          const themeName = toThemeName(project.data.theme);
          const themeToken = resolveThemeToken(themeName);
          const projectHref = `${baseUrl}portfolio/${project.id}/`;

          const hasDescription = Boolean(
            project.data.description && project.data.description.trim().length > 0,
          );

          return (
            <div class="card-carousel-item">
              <a
                href={projectHref}
                class="retro-card pixel-frame group"
                aria-label={`Open project ${project.data.title ?? index + 1}`}
                title={project.data.title}
                style={`--thumb-theme-color: ${themeToken}; --project-tag-color: ${themeToken}; --project-tag-color-dark: var(--theme-${themeName}-dark); --plate-pattern: url('${patternForTheme(themeName)}')`}
              >
                <div class="retro-card-bar pattern-plate pattern-plate--small flex items-center gap-2">
                  <Body theme={themeName} class="retro-card-meta text-xs sm:text-sm">
                    {project.data.tag}
                  </Body>
                </div>

                <div class="retro-card-media">
                  <div class="thumb-carousel">
                    <img
                      src={asset(project.data.cardBackground)}
                      alt={project.data.title ?? `Project ${index + 1}`}
                      class="thumb-carousel-media thumb-carousel-img active"
                      decoding="async"
                    />
                  </div>
                  <div class="thumb-overlay" />
                </div>

                {hasDescription && (
                  <div class="retro-card-bar retro-card-info-bar pattern-plate pattern-plate--small">
                    <Title level={3} theme={themeName} class="retro-card-title">
                      {project.data.title}
                    </Title>

                    <Body
                      theme={themeName}
                      class="retro-card-desc mt-2 text-sm sm:text-base text-[color:var(--time-ink-muted)] group-hover:text-[color:var(--time-ink)] readable-text"
                    >
                      {project.data.description}
                    </Body>
                  </div>
                )}
              </a>
            </div>
          );
        })
      }
    </div>
  </div>
</div>

<script>
  import { initCardCarousels } from "../../scripts/cardCarousel.js";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/scripts/cardCarousel.js

  // The strip is server-rendered above; build its controls on load. The module
     // registers its own `astro:page-load` listener, so client-side navigations
     // back to the listing rebuild them too.
  initCardCarousels();
</script>
