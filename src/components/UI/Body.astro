---
// Purpose: Component - src/components/UI/Body.astro (UI Body / paragraph styling)
// See: file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/site/fluidTypeScale.css
import {
  getThemeConfig,
  resolveThemeToken,
  toThemeName,
  toThemeToken,
} from "../../config/uiDictionary";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/config/uiDictionary.ts

interface Props {
  class?: string;
  // Theme name — controls font, color and transition. Any string works.
  theme?: string;
   // Readability shadow. ON by default: body copy sits over artwork as often as
   // over a flat tile, and the two-layer shadow in
   // styles/foundation/pixelTypeHierarchy.css keeps white text legible on the
   // bright patches without ringing the letters. Pass `shadow={false}` on a dark
   // plate where it is not wanted.
  shadow?: boolean;
}

const {
  class: customClass = "",
  theme: rawTheme,
  shadow = true,
} = Astro.props;
const themeName = toThemeName(rawTheme);
const config = getThemeConfig(themeName || "");
const themeToken = themeName ? resolveThemeToken(themeName) : undefined;

// Only an explicitly assigned theme swaps the typeface. Without one the text
// keeps inheriting the page's font, which is the previous behaviour.
const hasTheme = typeof rawTheme === "string" && rawTheme.trim() !== "";
const themeAttribute = hasTheme ? toThemeToken(themeName) : undefined;
---

<p
  class:list={[
    config.text.base,
    config.text.hover,
    "transition-colors",
    "text-sm sm:text-base leading-relaxed break-words max-w-prose",
    "theme-color",
    shadow && "readable-text",
    customClass,
  ]}
  data-theme={themeAttribute}
  style={themeToken ? `--project-tag-color: ${themeToken}` : undefined}
>
  <slot />
</p>
