---
// Purpose: Page - src/pages/index.astro (Home / landing)
import MyLayout from "../layouts/MyLayout.astro";
import PageCards from "../components/sections/PageCards.astro";
import ContactPanel from "../components/sections/ContactPanel.astro";
import HeaderInfo from "../components/sections/InfoHeader.astro";
import PageBackdrop from "../components/shared/PageBackdrop.astro";
import { asset } from "../utils/asset";
import type { PageCard, PageCredit } from "../types/page";

/* THE SITE'S PAGES — ONE ENTRY EACH.

   This list is the whole landing. Each object becomes a card (PageCards), and
   the grid fits as many cards per row as the screen allows, so publishing a new
   section means adding one object here: no markup, no new component, no second
   layout to keep in sync. Order is the order the cards are read in.

   `theme` is a name from styles/foundation/designTokens.css — it colours the
   card's frame, its button, its tag and its pattern plate. */
const pages: PageCard[] = [
  {
    href: `${import.meta.env.BASE_URL}portfolio/`,
    tag: "My projects",
    title: "Portfolio",
    description: "Take a look at my Unity and Unreal Engine projects.",
    actionText: "View projects",
    theme: "purple",
    imageSrc: asset("images/pageBackgrounds/PortfolioDay.webp"),
    imageSrcNight: asset("images/pageBackgrounds/PortfolioNight.webp"),
  },
  {
    href: `${import.meta.env.BASE_URL}blog/`,
    tag: "My thoughts",
    title: "Blog",
    description:
      "Just my thoughts on videogames, game development and movies.",
    actionText: "Read articles",
    theme: "green",
    imageSrc: asset("images/pageBackgrounds/BlogDay.webp"),
    imageSrcNight: asset("images/pageBackgrounds/BlogNight.webp"),
  },
];

/** Outbound credits shown in the bar under the cards. */
const credits: PageCredit[] = [
  { href: "https://www.deviantart.com/kirokaze/gallery", text: "Pixel-art by Kirokaze" },
  { href: "https://yukipixels.itch.io", text: "Font by Yukipixels" },
  { href: "https://kenney-assets.itch.io", text: "Patterns by Kenney" },
];
---

<MyLayout title="Home">
  {/* SCROLLS AT EVERY SIZE. The landing aims to fit one screen, but a short or
      very wide viewport falls back to scrolling rather than hiding the cards or
      the credits, so nothing on this page can become unreachable. */}
  <div
    id="landing-viewport"
    class="fixed inset-0 w-full overflow-y-auto bg-[var(--time-page)]"
  >
    {/* Full-screen backdrop for the landing experience. */}
    <PageBackdrop
      day="images/pageBackgrounds/MainDay.webp"
      night="images/pageBackgrounds/MainNight.webp"
    />

    {/* A column that grows with its content (`min-h-full`, no fixed height and
        no clipping): the hero keeps its natural size and the card grid takes
        whatever height is left. */}
    <div
      id="landing-content"
      class="relative z-20 flex min-h-full w-full flex-col pb-6 md:pb-0"
    >
      <header class="absolute top-0 right-0 z-50 px-8 py-6">
        <ContactPanel />
      </header>

      {/* HERO — never squeezed, never clipped. */}
      <div
        class="flex w-full shrink-0 items-center justify-center px-2 pb-2 pt-16 md:pt-2"
      >
        <HeaderInfo
          name="Joaquin Herrera"
          description="Game Dev: Unreal Engine C++ & Unity"
          portraitSrc={asset("images/frontPage/mypixelart.webp")}
          theme=""
        />
      </div>

      {/* CARD GRID — one card per entry in `pages` above. */}
      <div
        class="flex w-full min-h-0 flex-1 items-stretch justify-center px-2 pb-2 md:p-2"
      >
        <PageCards pages={pages} credits={credits} />
      </div>
    </div>
  </div>
</MyLayout>
