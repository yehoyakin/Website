---
// Purpose: Page - src/pages/portfolio/[slug].astro (Project write-up: masthead, gallery, links, reading panel)
// See: file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/portfolio/galleryThumbnailSlide.css, file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/portfolio/galleryPanelShell.css, file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/chrome/pixelChrome/patternPlates.css
import MyLayout from "../../layouts/MyLayout.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/layouts/MyLayout.astro
import BackLink from "../../components/shared/BackLink.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/shared/BackLink.astro
import Masthead from "../../components/shared/Masthead.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/shared/Masthead.astro
import CompactBody from "../../components/UI/CompactBody.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/UI/CompactBody.astro
import Link from "../../components/shared/Link.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/shared/Link.astro
import PageBackdrop from "../../components/shared/PageBackdrop.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/shared/PageBackdrop.astro

import { getCollection } from "astro:content";
import { asset } from "../../utils/asset";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/utils/asset.ts
import { isExternalUrl, videoEmbedUrl } from "../../utils/video";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/utils/video.ts
import { resolveThemeToken, toThemeName } from "../../config/uiDictionary";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/config/uiDictionary.ts
import { patternForTheme } from "../../config/patterns";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/config/patterns.ts
import { defaultIconColor, defaultIconColorNight, iconColorForTheme } from "../../config/icons";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/config/icons.ts
import "../../styles/portfolio/galleryThumbnailSlide.css";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/portfolio/galleryThumbnailSlide.css
import "../../styles/portfolio/galleryPanelShell.css";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/portfolio/galleryPanelShell.css
// The whole carousel sheet, not just its layout: this page's galleries opt in to
   // the built navigator (arrows + numbered index), and that artwork is
   // carouselArrows.css / carouselDots.css — both pulled in by carousel.css.
import "../../styles/carousel/carousel.css";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/carousel/carousel.css

type ProjectRole =
  | "lead_programmer"
  | "ui"
  | "game_design"
  | "art"
  | "audio"
  | "tech_art"
  | "systems"
  | "tools"
  | "developer";

const roleLabels: Record<ProjectRole, string> = {
  lead_programmer: "Lead Programmer",
  ui: "UI",
  game_design: "Game Design",
  art: "Art",
  audio: "Audio",
  tech_art: "Tech Art",
  systems: "Systems",
  tools: "Tools",
  developer: "Developer",
};

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { slug: project.id },
  }));
}

const slug = Astro.params.slug;
const projects = await getCollection("projects");
const project = projects.find((entry) => entry.id === slug);

if (!project) {
  throw new Response("Project not found", { status: 404 });
}

const themeName = toThemeName(project.data.theme);
const themeToken = resolveThemeToken(themeName);
const galleryThemeIconColor = iconColorForTheme(themeName);
const galleryStyle = `--thumb-theme-color: ${themeToken}; --project-tag-color: ${themeToken}; --project-tag-color-dark: var(--theme-${themeName}-dark); --plate-pattern: url('${patternForTheme(themeName)}')`;

const projectScenes = (project.data.scenes ?? []).map((scene) => ({
  image: asset(scene.image),
  caption: scene.caption ?? "",
}));
const scenes = projectScenes.map((s) => s.image);
const videos = project.data.videos ?? [];
const projectLinks = project.data.links ?? [];

 // Clean up a caption string: strip quotes (straight or curly), HTML entities, trim.
function cleanCaption(raw: string): string {
  return raw
    .replace(/^[\s,]*/, "")
    .replace(/&quot;/g, '"')
    .replace(/&ldquo;/g, '"')
    .replace(/&rdquo;/g, '"')
    .replace(/&apos;/g, "'")
    .replace(/&lsquo;/g, "'")
    .replace(/&rsquo;/g, "'")
    .replace(/&amp;/g, "&")
    .replace(/^["""\u201c\u201d]/, "")
    .replace(/["""\u201c\u201d]$/, "")
    .replace(/^['''\u2018\u2019]/, "")
    .replace(/['''\u2018\u2019]$/, "")
    .trim();
}

 // Extract captions from [scene[N], "caption"] markers in the raw Markdown body
 // so gallery thumbnails can display them, then remove the markers from the body
 // so images only appear in the right-side gallery.
const markdownBody = project.body ?? "";
const SCENE_MARKER_RE = /\[scene\[([0-9,\s]+)(?:,\s*(wide|large|full))?\](?:,\s*([^\]]*))?\]/g;
const GALLERY_VIDEO_MARKER_RE = /\[gallery:video\[(\d+)\](?:,\s*([^\]]*))?\]/g;

const bodySceneCaptions = {};
const bodyGalleryVideoCaptions = {};
const bodyCaptionRe = /\[scene\[([0-9,\s]+)(?:,\s*(wide|large|full))?\](?:,\s*([^\]]*))?\]/g;
let captionMatch;
let sceneMarkerCount = 0;
while ((captionMatch = bodyCaptionRe.exec(markdownBody)) !== null) {
  sceneMarkerCount++;
  const [, rawIndexes = "", , rawCaption = ""] = captionMatch;
  const caption = cleanCaption(rawCaption);
  if (caption) {
    rawIndexes.split(",")
      .map((v) => Number.parseInt(v.trim(), 10))
      .filter((v) => Number.isInteger(v) && v >= 0)
      .forEach((idx) => { bodySceneCaptions[idx] = caption; });
  }
}

// Parse [gallery:video[N]] and [gallery:video[N], "caption"] markers so we can
   // strip them from the body HTML and use their inline captions for gallery items.
const galleryVideoRe = /\[gallery:video\[(\d+)\](?:,\s*([^\]]*))?\]/g;
let galleryVideoMatch;
let galleryVideoMarkerCount = 0;
while ((galleryVideoMatch = galleryVideoRe.exec(markdownBody)) !== null) {
  galleryVideoMarkerCount++;
  const index = Number.parseInt(galleryVideoMatch[1], 10);
  const rawCaption = galleryVideoMatch[2];
  const caption = cleanCaption(rawCaption);
  if (caption) {
    bodyGalleryVideoCaptions[index] = caption;
  }
}

// Only show gallery if there are scene markers, gallery video markers, or videos in frontmatter
const hasGalleryContent = sceneMarkerCount > 0 || galleryVideoMarkerCount > 0 || videos.length > 0;

// Remove scene and gallery:video markers from the body HTML so they only appear in the gallery
let processedHtml = (project.rendered?.html ?? "").replace(SCENE_MARKER_RE, "").replace(GALLERY_VIDEO_MARKER_RE, "");

// Wrap ##### (h5) heading sections in <div class="retro-contribution">
// This allows markdown files to use "##### Contribution" instead of explicit div wrappers
function wrapH5Sections(html) {
  const result = [];
  let remaining = html;
  
  while (true) {
    const h5Match = remaining.match(/<h5[^>]*>.*?<\/h5>/);
    if (!h5Match) {
      // No more h5 tags, append the rest
      result.push(remaining);
      break;
    }
    
    // Append everything before the h5
    const beforeH5 = remaining.slice(0, h5Match.index);
    result.push(beforeH5);
    
    // Get the h5 tag
    const h5Tag = h5Match[0];
    const afterH5 = remaining.slice(h5Match.index + h5Tag.length);
    
    // Find the next heading (h1-h6) in the remaining content
    const nextHeadingMatch = afterH5.match(/<h[1-6][^>]*>.*?<\/h[1-6]>/);
    
    if (nextHeadingMatch) {
      // Content between h5 and next heading
      const bodyContent = afterH5.slice(0, nextHeadingMatch.index).replace(/\s*$/, '');
      result.push(`<div class="retro-contribution">${h5Tag}${bodyContent}</div>`);
      remaining = afterH5.slice(nextHeadingMatch.index);
    } else {
      // No next heading, everything after h5 is the body content
      const bodyContent = afterH5.replace(/\s*$/, '');
      result.push(`<div class="retro-contribution">${h5Tag}${bodyContent}</div>`);
      break;
    }
  }
  
  return result.join('');
}

processedHtml = wrapH5Sections(processedHtml);

const bodyHtml = processedHtml;

const sceneItem = (i: number, inlineCaption?: string) => {
  const s = projectScenes[i];
  if (!s) return null;
  return { kind: "image" as const, src: s.image, alt: inlineCaption || s.caption || `${project.data.title} screenshot ${i + 1}` };
};

const videoItem = (i: number, inlineCaption?: string) => {
  const video = videos[i];
  if (!video) return null;
  const embed = videoEmbedUrl(video.src, video.type);
  const caption = inlineCaption || video.title;

  if (embed) {
    return {
      kind: "embed" as const,
      src: embed,
      title: caption ?? `${project.data.title} video`,
    };
  }

  return {
    kind: "file" as const,
    src: isExternalUrl(video.src) ? video.src : asset(video.src),
    poster: video.poster ? asset(video.poster) : undefined,
    title: caption,
  };
};

type MediaItem = NonNullable<ReturnType<typeof sceneItem> | ReturnType<typeof videoItem>>;

// One gallery per group of markers. Markers on consecutive lines share a
   // gallery; a blank line or any other content starts a new one, the same rule
   // the blog parser uses.
const mediaGroups: MediaItem[][] = [];
{
  let current: MediaItem[] = [];
  const flush = () => {
    if (current.length) mediaGroups.push(current);
    current = [];
  };
  const SCENE_LINE_RE = /^\[scene\[([0-9,\s]+)(?:,\s*(?:wide|large|full))?\](?:,\s*(.*?))?\]$/;
  const VIDEO_LINE_RE = /^\[gallery:video\[(\d+)\](?:,\s*(.*?))?\]$/;

  for (const rawLine of markdownBody.split(/\r?\n/)) {
    const line = rawLine.trim();
    const sceneMatch = line.match(SCENE_LINE_RE);
    const videoMatch = !sceneMatch && line.match(VIDEO_LINE_RE);

    if (sceneMatch) {
      const rawIndexes = sceneMatch[1];
      const caption = cleanCaption(sceneMatch[2] ?? "") || undefined;
      rawIndexes
        .split(",")
        .map((v) => Number.parseInt(v.trim(), 10))
        .filter((v) => Number.isInteger(v) && v >= 0)
        .forEach((idx) => {
          const item = sceneItem(idx, caption);
          if (item) current.push(item);
        });
    } else if (videoMatch) {
      const item = videoItem(Number.parseInt(videoMatch[1], 10), cleanCaption(videoMatch[2] ?? "") || undefined);
      if (item) current.push(item);
    } else {
      flush();
    }
  }
  flush();

  // A project with frontmatter videos but no markers still shows them.
  if (!mediaGroups.length && videos.length) {
    mediaGroups.push(videos.map((_, i) => videoItem(i)).filter(Boolean) as MediaItem[]);
  }
}

// The page backdrop is the project's OWN artwork. It used to fall back to
   // `cardBackground`, which meant a project that never set a backdrop showed its
   // card art blown up behind the page; `background` is required in the schema
   // now, so the two images can never stand in for each other.
const backgroundImage = asset(project.data.background);
// Preload only what this page actually paints: the backdrop and the gallery.
   // The card cover is not shown on a slug, so it is no longer in this list.
const preloadImages = [
  backgroundImage,
  ...scenes,
  ...videos
    .filter((video) => !isExternalUrl(video.src))
    .map((video) => asset(video.src)),
  ...videos
    .map((video) => video.poster)
    .filter(Boolean)
    .map((poster) => asset(poster as string)),
];

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<MyLayout
  title={`${project.data.title} | Portfolio`}
  theme={themeName}
  preloadImages={preloadImages}
>
  <div class="relative w-full min-h-screen bg-[var(--time-page)]">
    <PageBackdrop
      day={project.data.background}
      night={project.data.background}
    />

    <div class="absolute inset-0 z-10 pointer-events-none"></div>

    <div
      class="project-page pattern-plate pattern-plate--medium pattern-plate--ghost relative z-20 mx-auto w-full px-4 sm:px-6 md:px-8"
      style={`--project-tag-color: ${themeToken}; --project-tag-color-dark: var(--theme-${themeName}-dark); --plate-pattern: url('${patternForTheme(themeName)}')`}
    >
      <BackLink href={`${baseUrl}portfolio/`} text="Back to portfolio" />

      <section class="project-page-shell pt-20 pb-8 md:pt-24 md:pb-12">
        <Masthead
          variant="project"
          kicker={project.data.tag}
          title={project.data.title}
          description={project.data.description}
          theme={themeName}
        >
          <div slot="extra" class="retro-masthead-roles">
            {(project.data.roles ?? []).map((role) => (
              <span class="project-role">{roleLabels[role as ProjectRole] ?? role}</span>
            ))}
          </div>
        </Masthead>

        <div class="project-page-lower-grid">
          <section class="project-page-left-stack">
            <section class="links-panel pixel-frame pattern-plate pattern-plate--small">
              <div class="links-panel-links">
                {projectLinks.map((link, index) => (
                  <Link
                    href={link.href}
                    text={link.text?.trim() || `Project link ${index + 1}`}
                    external={true}
                    theme={themeName}
                  />
                ))}
              </div>
            </section>

            <div class="screen-grade-ring screen-grade-ring--hairline">
            <CompactBody
              theme={themeName}
              class="project-page-content-panel blog-article-body pattern-plate pattern-plate--text-backdrop pattern-plate--huge"
            >
              <div id="blog-content" set:html={bodyHtml} />
            </CompactBody>
            </div>
          </section>

          {
            mediaGroups.length > 0 && (
              <div class="project-page-gallery-column">
              {mediaGroups.map((mediaItems) => (
              <div class="project-gallery-group">
                <section class="markdown-gallery--full" aria-label="Project media">
                  <div class={`project-gallery markdown-gallery${mediaItems.length === 1 ? " markdown-gallery--single" : ""}`} data-gallery-ready="false" data-icon-color={galleryThemeIconColor} data-site-base-url={baseUrl}>
                    {/* `data-carousel-nav="on"` is this gallery's own switch — see scripts/cardCarousel.js. Set it to "off" to hand the strip back to the browser's scrollbar. */}
                    <div class="card-carousel" data-carousel data-carousel-nav="on" data-carousel-item=".card-carousel-item" data-carousel-label="Gallery" data-icon-color={galleryThemeIconColor}>
                      <div class="card-carousel-track" data-carousel-track>
                        {mediaItems.map((item, index) => {
                          const titleText = item.kind === "image" ? (item.alt ?? `${project.data.title} screenshot ${index + 1}`) : (item.title ?? `Media ${index + 1}`);
                          const hasTitleText = Boolean(titleText && titleText.length > 0);

                          return (
                            <div class="card-carousel-item">
                              <button
                                class="retro-card pixel-frame retro-card--media"
                                aria-label={hasTitleText ? `View ${titleText}` : `View media ${index + 1}`}
                                title={titleText || undefined}
                                data-thumb-index={0}
                                data-lightbox-index={index}
                                data-lightbox-src={item.src}
                                data-lightbox-kind={item.kind}
                                data-lightbox-alt={titleText}
                                data-lightbox-poster={item.kind === "file" ? (item.poster || "") : ""}
                                style={galleryStyle}
                              >
                                <div class="retro-card-media">
                                  <div class="thumb-carousel">
                                    {item.kind === "image" && (
                                      <img
                                        src={item.src}
                                        alt={titleText || `Image ${index + 1}`}
                                        class="thumb-carousel-media thumb-carousel-img active"
                                        decoding="async"
                                      />
                                    )}
                                    {item.kind === "embed" && (
                                      <iframe
                                        src={item.src}
                                        title={item.title || `Embed ${index + 1}`}
                                        class="thumb-carousel-media thumb-carousel-frame active"
                                        loading="lazy"
                                        allowfullscreen
                                      />
                                    )}
                                    {item.kind === "file" && (
                                      <video
                                        src={item.src}
                                        poster={item.poster}
                                        class="thumb-carousel-media thumb-carousel-video active"
                                        controls
                                        playsinline
                                        preload="metadata"
                                      />
                                    )}
                                  </div>
                                  <div class="thumb-overlay" />
                                </div>
                                {hasTitleText && (
                                  <div class="retro-card-bar retro-card-info-bar pattern-plate pattern-plate--small">
                                    <span class="retro-card-caption">{titleText}</span>
                                  </div>
                                )}
                              </button>
                            </div>
                          );
                        })}
                      </div>
                    </div>
                  </div>
                </section>

                {/* THE SAME OVERLAY A POST'S GALLERY OPENS. Placed outside the gallery container so that position: fixed is never clipped by an ancestor's overflow, transform, or stacking context. One panel per page, holding only this project's media: the list is read from the thumbnails at the moment a thumb is clicked, so it can never show another gallery's picture. The stage is filled in by the script — an image, a <video> or an embed — because this gallery contains all three. */}
                <div class="gallery-panels-container">
                  <div
                    class="blog-gallery-lightbox"
                    aria-hidden="true"
                    data-gallery-lightbox
                    style={galleryStyle}
                  >
                    <div class="blog-gallery-lightbox__backdrop"></div>
                    <div class="blog-gallery-lightbox__panel" role="dialog" aria-modal="true" aria-label="Media preview" style={galleryStyle}>
                      <div class="blog-gallery-lightbox__media">
                        <div class="blog-gallery-lightbox__stage" data-lightbox-stage />
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              ))}
              </div>
            )
          }
        </div>
      </section>
    </div>
  </div>
</MyLayout>

<script>
  // A bundled (not is:inline) script, so Astro resolves and ships these
     // imports. Inline scripts are copied verbatim, and their relative imports
     // 404'd in the browser, which stopped every gallery from opening.
  import { initGalleryEqualHeight } from "../../scripts/galleryEqualHeight.js";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/scripts/galleryEqualHeight.js
  import { initCardCarousels } from "../../scripts/cardCarousel.js";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/scripts/cardCarousel.js
  {
    const initMarkdownGalleries = () => {
      const galleries = document.querySelectorAll(".project-gallery[data-gallery-ready='false']");
      if (!galleries.length) return;

      galleries.forEach((gallery) => {
        gallery.dataset.galleryReady = "true";

        const thumbs = [...gallery.querySelectorAll(".retro-card[data-lightbox-index]")];
        // The lightbox sits outside the gallery container so that position: fixed
           // is never clipped. Find it among the gallery's parent's siblings.
        const lightbox = (gallery.closest(".project-gallery-group") || gallery).querySelector("[data-gallery-lightbox]");
        if (!lightbox || !thumbs.length) return;

        const stage = lightbox.querySelector("[data-lightbox-stage]");

        let items = [];
        let currentIndex = 0;

        // Build a media list from the thumbnails in this gallery. Each thumb
           // carries data-lightbox-kind ("image", "file", or "embed") so the
           // lightbox stage can render the correct element type.
        const itemsFor = (thumb) => {
          const owner = thumb?.closest(".project-gallery") || gallery;

          return [...owner.querySelectorAll(".retro-card[data-lightbox-index]")].map((node) => ({
            kind: node.dataset.lightboxKind || "image",
            src: node.dataset.lightboxSrc,
            poster: node.dataset.lightboxPoster || "",
            alt: node.dataset.lightboxAlt || node.getAttribute("aria-label") || "Media preview",
          }));
        };

        // Render one media item into the lightbox stage. Mirrors the blog
           // gallery's render() so videos and embeds work identically.
        const render = (index) => {
          const item = items[index];
          if (!item || !stage) return;

          let node;

          if (item.kind === "embed") {
            node = document.createElement("iframe");
            node.src = item.src;
            node.title = item.alt || "Media";
            node.referrerPolicy = "strict-origin-when-cross-origin";
            node.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
            node.setAttribute("allowfullscreen", "");
          } else if (item.kind === "file") {
            node = document.createElement("video");
            node.src = item.src;
            if (item.poster) node.poster = item.poster;
            node.controls = true;
            node.playsInline = true;
            node.preload = "metadata";
          } else {
            node = document.createElement("img");
            node.src = item.src;
            node.alt = item.alt;
            node.loading = "eager";
            node.decoding = "async";
          }

          node.className = "blog-gallery-lightbox__image";
          stage.replaceChildren(node);
        };

        const updateLightbox = (index) => {
          if (!items.length) return;

          const normalizedIndex = ((index % items.length) + items.length) % items.length;
          currentIndex = normalizedIndex;
          render(currentIndex);
        };

        // One panel on screen at a time: a gallery opened while another panel is
           // still up would otherwise show through behind it.
        const closeOtherLightboxes = () => {
          document.querySelectorAll(".blog-gallery-lightbox.is-open").forEach((other) => {
            if (other === lightbox) return;
            other.classList.remove("is-open");
            other.setAttribute("aria-hidden", "true");
          });
        };

        const openLightbox = (index, thumb) => {
          items = itemsFor(thumb);
          closeOtherLightboxes();
          // Opened from <body> so no transformed or clipping ancestor (the
             // gallery strip, a plate, a reveal animation) can trap the
             // fixed-position overlay inside the page.
          if (lightbox.parentElement !== document.body) document.body.appendChild(lightbox);
          lightbox.classList.add("is-open");
          lightbox.setAttribute("aria-hidden", "false");
          document.body.classList.add("lightbox-open");
          updateLightbox(index);
        };

        const closeLightbox = () => {
          lightbox.classList.remove("is-open");
          lightbox.setAttribute("aria-hidden", "true");

          // Unmount the stage to stop any playing video or embed.
          stage?.replaceChildren();

          if (!document.querySelector(".blog-gallery-lightbox.is-open")) {
            document.body.classList.remove("lightbox-open");
          }
        };

        // The thumbnail's own index inside its strip is what opens it, so the
           // number of galleries above it on the page cannot shift the picture.
        thumbs.forEach((thumb) => {
          thumb.addEventListener("click", (event) => {
            event.preventDefault();
            openLightbox(Number(thumb.dataset.lightboxIndex) || 0, thumb);
          });
        });

        // The overlay is image-only: any click anywhere on it — the media or the
           // dimmed surround — closes it. There is no panel, caption or close button.
        lightbox.addEventListener("click", () => closeLightbox());

        document.addEventListener("keydown", (event) => {
          if (!lightbox.classList.contains("is-open")) return;

          if (event.key === "Escape") closeLightbox();
          if (event.key === "ArrowRight") openLightbox(currentIndex + 1);
          if (event.key === "ArrowLeft") openLightbox(currentIndex - 1);
        });
      });
    };

    document.addEventListener("astro:page-load", () => {
      initMarkdownGalleries();
      initCardCarousels();
      initGalleryEqualHeight();
    });
    document.addEventListener("DOMContentLoaded", () => {
      initMarkdownGalleries();
      initCardCarousels();
      initGalleryEqualHeight();
    });
    initMarkdownGalleries();
    initCardCarousels();
    initGalleryEqualHeight();
  }
</script>

<style>
  .project-page-shell {
    max-width: 64rem;
    margin-inline: auto;
  }

  /* THE ONE MASTHEAD. The header is the shared <Masthead> component */
     /* (components/shared/Masthead.astro); the project's tighter type lives in */
     /* styles/article/masthead.css under `.retro-masthead--project`. Nothing is */
     /* scoped here. */

  .project-page-lower-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 0.9rem;
    align-items: start;
    max-width: 64rem;
    margin-inline: auto;
  }

  .project-page-left-stack {
    display: grid;
    gap: 0.65rem;
    align-items: start;
  }

  .project-page-panel-label,
  .project-page-aside-label {
    margin: 0;
    font-size: clamp(0.66rem, 0.9vw, 0.8rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--project-tag-color, var(--theme-orange));
    text-shadow: 1px 2px 0 var(--time-shadow);
  }

  :global(.project-page-content-panel) {
    /* A plate's motif is drawn by its `::before` / `::after`, which are */
       /* absolutely positioned at `inset: 0` — `.pattern-plate` deliberately */
       /* leaves `position` to its host. This panel had none, so those two layers */
       /* anchored to the nearest positioned ancestor, `.project-page`, and the */
       /* write-up's texture painted the WHOLE page (the pattern showing between */
       /* the panels). Relative here keeps the texture inside the panel's box. */
    position: relative;
    padding: 1rem;
    --plate-pattern-size: max(1600px, calc(var(--pattern-size-huge, 1024px) * 1.5));
    /* Keep the loop keyframe in step with this tile (motionCurves.css). The */
       /* pinned backdrop drifts on background-position, not transform. */
    --plate-drift: plate-bg-drift-1600;
    --plate-pattern-opacity: 0.09;
    max-width: none;
    /* The write-up panel keeps a flat accent border at a hairline — the */
       /* light-to-dark grade on it is the shared screen grade */
       /* (styles/site/pageLighting.css), like its fill. */
    border: 1px solid var(--frame-accent) !important;
    border-image: none !important;
    outline: none !important;
    box-shadow: none !important;
  }

  :global(.project-page-content-panel::after) {
    content: none !important;
    display: none !important;
  }

  :global(.project-page-content-panel .retro-contribution) {
    /* The content column suppresses the frame recipe so only the panel owns a */
       /* border. Restore the gradient frame for the contribution sub-panel. */
    --frame-accent: var(--project-tag-color, var(--time-border));
    --frame-edge-light: color-mix(
      in srgb,
      var(--frame-accent) 46%,
      var(--time-white)
    );
    --frame-edge-dark: color-mix(
      in srgb,
      var(--frame-accent) 28%,
      var(--time-black)
    );
    --frame-bevel: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--frame-accent) 98%, var(--time-white) 2%) 0%,
      var(--frame-accent) 12%,
      color-mix(in srgb, var(--frame-accent) 72%, var(--time-black) 28%) 58%,
      color-mix(in srgb, var(--frame-accent) 45%, var(--time-black) 55%) 100%
    );
    border: var(--outline-width) solid transparent;
    border-image: var(--frame-bevel) 1;
    box-shadow:
      inset 1px 1px 0 0 color-mix(in srgb, var(--frame-edge-light) 75%, transparent),
      inset -1px -1px 0 0 color-mix(in srgb, var(--frame-edge-dark) 75%, transparent);
  }

  :global(.project-page-content-panel.compact-body) {
    font-size: clamp(calc(0.74rem + 6px), calc(0.8vw + 6px), calc(0.86rem + 6px)) !important;
    line-height: 1.46 !important;
  }

  :global(.project-page-content-panel #blog-content) {
    /* The content sits inside the panel's border; it does not carry a frame of */
       /* its own, and neither do the figures nested in it. */
    --frame-bevel: none;
    font-size: inherit;
    line-height: inherit;
  }

  :global(.project-page-content-panel #blog-content p) {
    font-size: inherit;
    line-height: inherit;
  }

  .project-page-panel-label {
    margin-bottom: 0.65rem;
  }

  .project-page-content-panel :global(#blog-content h2) {
    font-size: clamp(2rem, 2.35vw, 2.5rem);
  }

  .project-page-content-panel :global(#blog-content h3) {
    font-size: clamp(1.7rem, 2vw, 2.1rem);
  }

  .project-page-gallery-column {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-width: 0;
  }

  /* The slug gallery's full-width sizing moved to the shared sheet */
     /* (styles/portfolio/galleryThumbnailSlide.css) under `.markdown-gallery--full` */
     /* — the one carousel family, no page-scoped !important stack. */

  /* The overlay's stage. The blog's panel sizes one <img>; this one is filled by */
     /* the script, so an embed needs its own shape. */
  .blog-gallery-lightbox__stage {
    display: grid;
    place-items: center;
    width: 100%;
  }

  .blog-gallery-lightbox__stage :global(iframe.blog-gallery-lightbox__image) {
    border: 0;
  }

  /* The arrow / index artwork this page used to size is gone: the navigator is */
     /* built from the site's themed buttons, and their sizes come with them */
     /* (styles/carousel/carouselArrows.css, carouselDots.css). */

  @media (max-width: 767px) {
    .project-page-shell {
      padding-bottom: 0.5rem;
    }

    /* ONE COLUMN. The desktop split (write-up beside the media) left a phone */
       /* track of ~119px: the write-up panel could not shrink below its own */
       /* min-content width (~192px), so it spilled out of its track and sat on */
       /* top of the gallery column instead of beside it. Stacked, each panel gets */
       /* the whole width, which is the measure the copy reads at on a phone. */
    .project-page-lower-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.8rem;
    }

    .project-page-left-stack,
    .project-page-gallery-column,
    :global(.project-page-content-panel) {
      /* Grid items are min-content sized by default; these panels are text and */
         /* pictures, so they must be allowed to shave down to their track. */
      min-width: 0;
    }

    .project-page-left-stack {
      gap: 0.65rem;
    }

    /* The phone slug-gallery sizing (picture sets the card height) also moved */
       /* to galleryThumbnailSlide.css under `.markdown-gallery--full`. */

    :global(.project-page-content-panel) {
      padding: 0.9rem;
    }

    :global(.project-page-content-panel.compact-body) {
      /* The same 16px grid the article's copy reads at; the write-up used to */
         /* sit a pixel or two above it, which made the two surfaces disagree on */
         /* exactly the page that shows both. */
      font-size: 16px !important;
      line-height: 1.5 !important;
      /* This panel's own inline padding, published so gallery media inside it */
         /* can run to the panel's edges. */
      --reading-inset: 0.9rem;
    }
  }
</style>
