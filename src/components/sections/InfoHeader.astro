---
// Purpose: Section - src/components/sections/InfoHeader.astro (Hero header info block)
import Title from "../UI/Title.astro";
import Portrait from "../shared/MyImage.astro";
import Body from "../UI/Body.astro";
import { resolveThemeToken } from "../../config/uiDictionary";

interface Props {
  name: string;
  description: string;
  portraitSrc: string;
  theme?: string;
}

const { name, description, portraitSrc, theme = "orange" } = Astro.props;

const dynamicStyle = `--project-tag-color: ${resolveThemeToken(theme)};`;
---

<div
  class="landing-hero flex w-full flex-col items-center justify-center px-4 py-2 text-center theme-color md:px-6 md:py-3"
  style={dynamicStyle}
>
  <Title
    level={1}
    theme={theme}
    class="text-xl md:text-3xl tracking-[0.12em] uppercase"
  >
    {name}
  </Title>

  {/* `hero` sizes the portrait from the viewport HEIGHT (see
      shared/MyImage.astro) so the landing page can fit without scrolling. */}
  <div class="mt-3 flex justify-center">
    <Portrait src={portraitSrc} size="hero" frame />
  </div>

  <Body theme={theme} class="mt-2 text-xs tracking-widest uppercase md:text-sm">
    {description}
  </Body>
</div>
