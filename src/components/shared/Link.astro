---
// Purpose: Component - src/components/shared/Link.astro (Retro link button)
import Icon from "./Icon.astro";

interface Props {
  href: string;
  text?: string;
  external?: boolean;
  class?: string;
  /** Icon name from the shared registry, e.g. "Handbag". */
  icon?: string;
  /** Theme name — picks the icon colour that matches the card/page. */
  theme?: string;
}

const {
  href,
  text = "",
  external,
  class: extraClass = "",
  icon,
  theme,
} = Astro.props;

// Buttons with an icon pin it to the left edge so icons line up in a stack,
// even when the labels are different lengths. Text-only buttons stay centred.
const alignment = icon ? "justify-start" : "justify-center";

const classes = [
  "retro-link group relative overflow-hidden flex items-center gap-2",
  alignment,
  "rounded-none px-4 py-2 text-sm uppercase tracking-[0.25em] text-[color:var(--time-ink)]",
  "bg-[var(--time-surface)] border-[5px] border-[color:var(--time-border)]",
  "transition-all duration-100 ease-[var(--ease-press)]",
  "hover:bg-[var(--time-highlight)] hover:text-[color:var(--time-black)] hover:border-[color:var(--time-highlight)]",
  "hover:translate-x-[-0.125rem] hover:translate-y-[-0.125rem]",
  "hover:shadow-[0.375rem_0.375rem_0px_0px_var(--time-highlight)]",
  extraClass,
]
  .filter(Boolean)
  .join(" ");
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class={classes}
>
  {icon && <Icon name={icon} theme={theme} class="relative z-10 h-8 w-8 shrink-0" />}
  <span class="relative z-10">{text}</span>
  <span class="pixel-highlight"></span>
</a>
