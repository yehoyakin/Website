---
// Purpose: Component - src/components/shared/Link.astro (Retro link button)
// See: file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/article/articleMasthead.css, file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/chrome/pixelChrome/linkPanels.css, file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/chrome/pixelChrome/tintedButtons.css
import Icon from "./Icon.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/shared/Icon.astro
import { netIconForUrl } from "../../config/icons";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/config/icons.ts
import { resolveThemeToken, toThemeName } from "../../config/uiDictionary";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/config/uiDictionary.ts

interface Props {
  href: string;
  text?: string;
  external?: boolean;
  class?: string;
  style?: string;
  // Icon name from the shared registry, e.g. "Handbag".
  icon?: string;
  // Theme name — picks the icon colour that matches the card/page.
  theme?: string;
   // Take the themed tile — accent fill, white outline — when the host has no
   // theme of its own and paints the accent through `style` instead (the
   // landing's contacts panel). `theme` does the same thing by naming one.
  tinted?: boolean;
}

const {
  href,
  text = "",
  external,
  class: extraClass = "",
  style,
  icon,
  theme,
  tinted,
} = Astro.props;

// Buttons with an icon pin it to the left edge so icons line up in a stack,
// even when the labels are different lengths. Text-only buttons stay centred.
// Prefer an explicit icon so themed pages keep their own icon language.
// Outbound brand glyph detection is only a fallback when no icon was provided.
const resolvedIcon = icon ?? netIconForUrl(href);

const alignment = resolvedIcon ? "justify-start" : "justify-center";

// The button must take the host's contextual accent when placed in a themed
   // card or panel, while still accepting an explicit theme override when a link
   // is used outside that context.
const themeName = theme ? toThemeName(theme) : undefined;
const themeToken = themeName ? resolveThemeToken(themeName) : undefined;
const linkThemeMode = theme ? (themeName ?? "tinted") : (tinted ? "tinted" : undefined);
// ONE BUTTON VISUAL EVERYWHERE. The themed-tile recipe (chrome/pixelChrome/
   // tintedButtons.css) is keyed to the `data-link-theme` attribute, so EVERY
   // link carries it — named when a theme was asked for, empty otherwise, in
   // which case the tile just inherits the host's `--project-tag-color` (the
   // carousel's navigator buttons set the same empty attribute). The theme
   // vars are only emitted when they name a real theme: an inline
   // `--project-tag-color: undefined` is not a fallback, it is an invalid
   // value that blanks the whole plate — which is how the credits row lost
   // its buttons.
const inlineThemeStyle = [
  themeToken
    ? `--project-tag-color: ${themeToken}; --project-tag-color-dark: var(--theme-${themeName}-dark);`
    : "",
  style,
].filter(Boolean).join("; ") || undefined;

const classes = [
  "retro-link pixel-frame group relative overflow-hidden flex items-center gap-2",
  alignment,
  "rounded-none px-2.5 py-1 text-xs uppercase tracking-[0.12em] text-[color:var(--time-ink)]",
  "bg-transparent",
  "transition-all duration-100 ease-[var(--ease-press)]",
  extraClass,
]
  .filter(Boolean)
  .join(" ");
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class={classes}
  style={inlineThemeStyle}
  data-link-theme={linkThemeMode ?? ""}
>
  {
    resolvedIcon && (
      <Icon
        name={resolvedIcon}
        theme={theme}
        color={tinted && !themeName ? "White" : undefined}
        class="relative z-10 h-5 w-5 shrink-0"
      />
    )
  }
  <span class="relative z-10">{text}</span>
  <span class="pixel-highlight"></span>
</a>
