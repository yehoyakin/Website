---
// Purpose: Layout - src/layouts/MyLayout.astro (Shell around every page: head, theme stamps, styles entry)
// See: file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/chrome/modeToggleSwitch.css, file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/chrome/pixelChrome/controlHover.css, file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/chrome/pixelChrome/iconButtons.css
import "../styles/site.css";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/site.css
import { ClientRouter } from "astro:transitions";
import { toThemeName, toThemeToken } from "../config/uiDictionary";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/config/uiDictionary.ts
import { asset } from "../utils/asset";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/utils/asset.ts
import { isRemoteUrl } from "../utils/asset";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/utils/asset.ts
import ModeToggle from "../components/shared/ModeToggle.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/shared/ModeToggle.astro
import Icon from "../components/shared/Icon.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/shared/Icon.astro
import { defaultIconColor, defaultIconColorNight } from "../config/icons";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/config/icons.ts
import { CUSTOM_CAROUSEL_CONTROLS } from "../config/carousel";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/config/carousel.ts

const { title = "JoacoDev", theme, page, preloadImages = [] } = Astro.props;

// THE PRELOAD WIRE-UP — the listing galleries' covers and the slug pages' media
   // are handed in `preloadImages`; emitting them as `<link rel="preload">` starts
   // their fetch during HTML parse, before the CSS/JS/font queue eats the
   // connection — the gap that made a first visit take seconds per gallery picture
   // while a refresh (HTTP cache) showed them instantly. See
   // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/pages/portfolio.astro
   // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/pages/blog.astro
   // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/pages/portfolio/[slug].astro
   // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/pages/blog/[slug].astro
const preloadList = [...new Set(preloadImages.filter(Boolean))];
// A caller may hand the raw path (blog.astro) or one already through `asset()`
   // (portfolio.astro, the slugs) — a leading `/` is already root-absolute, so it
   // must not be prefixed twice.
const preloadHref = (src: string) =>
  isRemoteUrl(src) || src.startsWith("/") ? src : asset(src);

// A page that assigns a theme carries the tokens.css token in `data-theme`,
// which is what fonts.css keys the page's font set off.
const themeAttribute =
  typeof theme === "string" && theme.trim() !== ""
    ? toThemeToken(toThemeName(theme))
    : undefined;

---

<html
  lang="en"
  data-theme={themeAttribute}
  data-page={page}
  data-icon-day={defaultIconColor}
  data-icon-night={defaultIconColorNight}
  data-carousel-controls={CUSTOM_CAROUSEL_CONTROLS ? "custom" : "native"}
>
  <head>
    <meta charset="UTF-8" />
    {/* ONE LAYOUT, EVERY SCREEN — laid out at the device's real width. This used to be `width=1280, shrink-to-fit=yes`, which laid every page out at desktop width on a phone and scaled the whole thing down. That made the site unreadable on mobile AND disabled the phone rules the stylesheets are full of: a fixed layout width means `max-width` queries never match, so styles/responsive/, the 768px gallery and card widths and the split-card block at 900px were all dead code. `viewport-fit=cover` is what makes the env(safe-area-inset-*) values used by the chrome rails and panels resolve on iOS. */}
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>

    {/* Apply the day / night choice before first paint so the page never flashes the other mode. A stored choice wins; a first visit follows the OS colour-scheme preference. Kept in sync with scripts/modeToggle.js (resolveMode). */}
    <script is:inline>
      try {
        var storedMode = localStorage.getItem("time-mode");
        document.documentElement.dataset.mode =
          storedMode === "night" || storedMode === "day"
            ? storedMode
            : window.matchMedia?.("(prefers-color-scheme: dark)").matches
              ? "night"
              : "day";

        // THE DESKTOP-VIEW REQUEST is applied here too, before first paint.
           // The site lays out for the device by default; swapping the viewport
           // meta is what makes a phone lay it out at 1280px and scale it, so a
           // visitor who asked for the desktop layout never sees the mobile one
           // first. Kept in sync with scripts/viewMode.js.
        var desktopView = false;
        try {
          desktopView = localStorage.getItem("site-view") === "desktop";
        } catch {}

        document.documentElement.dataset.view = desktopView
          ? "desktop"
          : "mobile";

        if (desktopView) {
          var viewportMeta = document.querySelector('meta[name="viewport"]');
          if (viewportMeta) {
            viewportMeta.setAttribute(
              "content",
              "width=1280, shrink-to-fit=yes",
            );
          }
        }
      } catch {
        document.documentElement.dataset.mode = "day";
      }
    </script>

    {/* Favicons live in public/ and are prefixed with BASE_URL so they resolve under the configured base path (see astro.config.mjs). */}
    <link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />
    <link rel="icon" type="image/x-icon" href={asset("favicon.ico")} sizes="32x32" />
    <link rel="apple-touch-icon" href={asset("apple-touch-icon.png")} />
    <meta name="theme-color" content="#1E9AEC" />

    {/* One preload line per key image, deduped; remote URLs are fetched as-is. */}
    {preloadList.map((src) => (
      <link
        rel="preload"
        as="image"
        href={preloadHref(src)}
        fetchpriority="high"
      />
    ))}

    <ClientRouter />
  </head>

  <body
    class="bg-[var(--time-page)] text-[color:var(--time-ink)] antialiased selection:bg-amber-500/30 selection:text-white"
  >
    <ModeToggle />

    {/* DESKTOP-VIEW REQUEST — the site adapts to the screen by default; this is the explicit opt-in to the old fixed-width desktop layout, one control down the same chrome rail as the day / night switch. */}
    <button
      id="view-toggle"
      class="mode-toggle view-toggle icon-button"
      type="button"
      aria-label="Switch to desktop view"
      aria-pressed="false"
      title="Switch to desktop view"
    >
      {/* One glyph per direction, both in the markup and swapped by `data-view` (styles/chrome/modeToggleSwitch.css): a laptop means "go desktop", a phone means "go back to mobile". */}
      <Icon name="laptop" class="chrome-icon view-toggle-icon view-toggle-icon--laptop" />
      <Icon name="phone" class="chrome-icon view-toggle-icon view-toggle-icon--phone" />
    </button>

    <div
      class="fixed inset-0 bg-[linear-gradient(to_right,var(--time-border-soft)_1px,transparent_1px),linear-gradient(to_bottom,var(--time-border-soft)_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none"
    >
    </div>

    <main
      class="relative z-10 min-h-screen w-full flex flex-col overflow-x-hidden"
    >
      <div class="w-full flex-1 px-4 sm:px-6 md:px-8 mx-auto">
        <slot />
      </div>
    </main>

    {
      /* Imported inside a script tag so Astro bundles it — a `src="/src/..."` reference is left untouched and 404s in a static build. */
    }
    <script>
      import "../scripts/railPanel.js";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/scripts/railPanel.js
      import "../scripts/modeToggle.js";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/scripts/modeToggle.js
      import "../scripts/viewMode.js";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/scripts/viewMode.js
      import "../scripts/patternTransition.js";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/scripts/patternTransition.js
    </script>
  </body>
</html>
