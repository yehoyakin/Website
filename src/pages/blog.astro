---
// Purpose: Page - src/pages/blog.astro (Blog listing)
// See: file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/carousel/carouselLayout.css, file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/blogCard/blogCardStrip.css, file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/site/fluidTypeScale.css
import MyLayout from "../layouts/MyLayout.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/layouts/MyLayout.astro
import Title from "../components/UI/Title.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/UI/Title.astro
import Body from "../components/UI/Body.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/UI/Body.astro
import { getCollection } from "astro:content";
import type { BlogPost } from "../types/blog";
import BlogCard from "../components/sections/BlogCard.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/sections/BlogCard.astro
import BackLink from "../components/shared/BackLink.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/shared/BackLink.astro
import PageBackdrop from "../components/shared/PageBackdrop.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/shared/PageBackdrop.astro

const posts = (await getCollection("blog")) as BlogPost[];

// Sort posts: newest first (left), oldest last (right)
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
// The strip's card covers join the backgrounds in the head's preload list — the
   // wiring MyLayout.astro emits; without it a first visit fetches them only
   // after the render queue, seconds per picture, while a refresh reads the
   // HTTP cache instantly. See
   // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/layouts/MyLayout.astro
const cardCovers = sortedPosts.map((post) => post.data.cardBackground).filter(Boolean);
---

<MyLayout
  title="Blog"
  page="blog"
  preloadImages={[
    "images/pageBackgrounds/BlogDay.webp",
    "images/pageBackgrounds/BlogNight.webp",
    ...cardCovers,
  ]}
>
  {/* Layered page background for the blog listing. */}
  <div
    class="absolute inset-0 w-full min-h-screen overflow-x-hidden"
  >
    {/* Background image layer with soft blur. */}
    <PageBackdrop
      day="images/pageBackgrounds/BlogDay.webp"
      night="images/pageBackgrounds/BlogNight.webp"
    />

    {/* Overlay to improve contrast over the background image. */}
    <div class="absolute inset-0 z-10 pointer-events-none"></div>

    {/* Main content layer. */}
    <section class="listing-shell relative z-20 px-4 sm:px-6 md:px-8 w-full">
      <div class="text-center">
        <BackLink />

        <Title class="mt-2 text-4xl md:text-6xl" level={1} theme="orange">
          Blog
        </Title>

        <Body theme="purple" class="mt-2 max-w-2xl mx-auto" shadow={true}>
          Thoughts on my favorite art. Click on the cards for more details!
        </Body>
      </div>

      <div class="listing-gap"></div>

      {
        /* On phones this becomes a one-card-at-a-time carousel (see styles/responsive/responsive.css + scripts/cardCarousel.js). */
      }
      {/* `data-carousel-nav="on"` is this strip's own switch — see scripts/cardCarousel.js. It builds the arrow + numbered navigator and hides the browser's scrollbar for this strip (styles/carousel/carouselLayout.css). Set it to "off" to hand the strip back to the native scrollbar. */}
      <div
        class="blog-cards-wrapper"
        data-carousel
        data-carousel-nav="on"
        data-carousel-item=".blog-card-item"
        data-carousel-label="Blog posts"
      >
        <div class="blog-cards-scroll" data-carousel-track>
          {
            sortedPosts.map((post) => (
              <div class="blog-card-item">
                <BlogCard post={post} />
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  <script>
    import { initCardCarousels } from "../scripts/cardCarousel.js";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/scripts/cardCarousel.js

    // The strip is server-rendered above; build its controls on load. The
       // module registers its own `astro:page-load` listener, so client-side
       // navigations back to the listing rebuild them too.
    initCardCarousels();
  </script>
</MyLayout>
