---
import CallCard from "./CallCard.astro";
import SocialLink from "../shared/Link.astro";
import { asset } from "../../utils/asset";
import { resolveThemeToken, toThemeName } from "../../config/uiDictionary";

interface Props {
  projects: {
    data: any;
    rendered: string;
  }[];
}

const { projects } = Astro.props;
---

<div id="project-gallery" class="project-gallery">
  <div id="gallery-bg" class="gallery-bg" aria-hidden="true">
    <img
      id="gallery-bg-img"
      class="gallery-bg-img"
      src={projects[0] ? asset(projects[0].data.images[0]) : ""}
      alt=""
    />
    <div class="gallery-bg-overlay"></div>
  </div>

  <!-- Scrollable thumbnail grid. On phones this becomes a one-card-at-a-time
       carousel (see styles/base/responsive.css + scripts/cardCarousel.js). -->
  <div
    class="gallery-thumbnails-wrapper"
    data-carousel
    data-carousel-item=".gallery-project-item"
    data-carousel-label="Projects"
  >
    <div class="gallery-thumbnails" data-carousel-track>
      {
        projects.map((project, index) => {
          const themeName = toThemeName(project.data.theme);
          const themeToken = resolveThemeToken(themeName);
          return (
            <div class="gallery-project-item">
              {/* Thumbnail button */}
              <button
                class="gallery-thumb"
                aria-label={`Expand project ${project.data.title ?? index + 1}`}
                title={project.data.title}
                data-thumb-index={index}
                style={`--thumb-theme-color: ${themeToken}`}
              >
                {/* Image carousel */}
                <div class="thumb-carousel">
                  {project.data.images.map((img: string, imgIndex: number) => (
                    <img
                      src={asset(img)}
                      alt={`${project.data.title ?? `Project ${index + 1}`} - Image ${imgIndex + 1}`}
                      class={`thumb-carousel-img ${imgIndex === 0 ? "active" : ""}`}
                      loading="lazy"
                      decoding="async"
                    />
                  ))}
                </div>
                <div class="thumb-overlay" />

                {/* Bottom info bar: title + tag */}
                <div class="thumb-info-bar">
                  <span class="thumb-title">{project.data.title}</span>
                  <span class="thumb-tag" style={`color: ${themeToken}`}>
                    {project.data.tag}
                  </span>
                </div>
              </button>
              {/* Links below the thumbnail, always visible */}
              <div class="thumb-links">
                {project.data.links?.map(
                  (link: { href: string; text: string | undefined }) => (
                    <SocialLink
                      href={link.href}
                      text={link.text}
                      external={true}
                    />
                  ),
                )}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>

  <!-- CallCard Panels - positioned outside the scroll container for full width -->
  <div class="gallery-panels-container">
    {
      projects.map((project, index) => (
        <div class="gallery-card-panel" data-panel={index}>
          <button
            class="collapse-btn"
            aria-label="Collapse project"
            data-collapse={index}
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="18 15 12 9 6 15" />
            </svg>
          </button>
          <CallCard
            tag={project.data.tag}
            title={project.data.title}
            shortDescription={project.data.shortDescription}
            fullDescription={project.rendered}
            roles={project.data.roles}
            theme={project.data.theme}
            backgroundImage={asset(project.data.images[0])}
          />
        </div>
      ))
    }
  </div>
</div>

<script is:inline>
  const CAROUSEL_INTERVAL = 3000;

  function initGallery() {
    const gallery = document.getElementById("project-gallery");
    if (!gallery) return;

    if (gallery.dataset.galleryInitialized === "true") return;
    gallery.dataset.galleryInitialized = "true";

    if (gallery._carouselTimers) {
      gallery._carouselTimers.forEach((t) => clearInterval(t));
    }
    gallery._carouselTimers = [];

    const thumbs = [...gallery.querySelectorAll("[data-thumb-index]")];
    const panels = [...gallery.querySelectorAll("[data-panel]")];
    const collapseBtns = [...gallery.querySelectorAll("[data-collapse]")];

    let activeProject = null;

    /*
     * Hover previews are a pointer-only affordance. On a touch screen a tap
     * fires `mouseenter` before `click`, which flashed a semi-visible panel
     * right before the real panel opened. Only wire the preview on devices
     * with a real pointer.
     */
    const canHover = window.matchMedia
      ? window.matchMedia("(hover: hover) and (pointer: fine)").matches
      : false;

    function expandProject(index) {
      // Hide all panels and deactivate all cards
      panels.forEach((p) => {
        p.style.display = "none";
        p.classList.remove("panel-hover-preview");
        p.classList.remove("panel-hover-fadeout");
        const card = p.querySelector(".retro-expandable-card");
        if (card) card.setAttribute("data-active", "false");
      });

      const panel = panels.find((p) => p.dataset.panel === String(index));
      if (panel) {
        panel.style.display = "block";
        activeProject = index;

        const card = panel.querySelector(".retro-expandable-card");
        if (card) card.setAttribute("data-active", "true");

        // Update background
        const bgImg = document.getElementById("gallery-bg-img");
        const thumb = thumbs[index];
        if (bgImg && thumb) {
          const firstImg = thumb.querySelector(".thumb-carousel-img");
          if (firstImg) {
            bgImg.src = firstImg.src;
            bgImg.style.opacity = "1";
          }
        }

        // Scroll thumbnail into view within the horizontal scroller
        const projectItem = thumb?.closest(".gallery-project-item");
        if (projectItem) {
          projectItem.scrollIntoView({
            behavior: "smooth",
            block: "nearest",
            inline: "center",
          });
        }

        // Scroll panel into view below
        panel.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }

    function collapseProject() {
      panels.forEach((p) => {
        p.style.display = "none";
        p.classList.remove("panel-hover-preview");
        p.classList.remove("panel-hover-fadeout");
        const card = p.querySelector(".retro-expandable-card");
        if (card) card.setAttribute("data-active", "false");
      });
      activeProject = null;

      const bgImg = document.getElementById("gallery-bg-img");
      if (bgImg) {
        bgImg.style.opacity = "0";
      }
    }

    thumbs.forEach((thumb) => {
      const index = Number(thumb.dataset.thumbIndex);

      // Hover preview: show CallCard semi-visible on thumbnail hover
      if (canHover) {
        thumb.addEventListener("mouseenter", () => {
          // Don't show hover preview if a panel is already expanded
          if (activeProject !== null) return;

          const panel = panels.find((p) => p.dataset.panel === String(index));
          if (panel) {
            // Clean up any pending fadeout and show preview
            panel.classList.remove("panel-hover-fadeout");
            panel.style.display = "block";
            panel.classList.add("panel-hover-preview");
          }
        });

        thumb.addEventListener("mouseleave", () => {
          // Don't hide if a panel is actively expanded
          if (activeProject !== null) return;

          const panel = panels.find((p) => p.dataset.panel === String(index));
          if (panel) {
            panel.classList.remove("panel-hover-preview");
            panel.classList.remove("panel-hover-fadeout");
            panel.style.display = "none";
          }
        });
      }

      // Click handler
      thumb.addEventListener("click", () => {
        if (activeProject === index) {
          collapseProject();
        } else {
          expandProject(index);
        }
      });
    });

    // Collapse button handlers
    collapseBtns.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        collapseProject();
      });
    });

    // Initialize carousels for all thumbnails
    function initCarousels() {
      const carousels = gallery.querySelectorAll(".thumb-carousel");
      carousels.forEach((carousel) => {
        const images = carousel.querySelectorAll(".thumb-carousel-img");
        if (images.length <= 1) return;

        let imageIndex = 0;
        const timer = setInterval(() => {
          images[imageIndex].classList.remove("active");
          imageIndex = (imageIndex + 1) % images.length;
          images[imageIndex].classList.add("active");
        }, CAROUSEL_INTERVAL);

        gallery._carouselTimers.push(timer);
      });
    }

    initCarousels();
  }

  function destroyGallery() {
    const gallery = document.getElementById("project-gallery");
    if (!gallery) return;
    gallery.dataset.galleryInitialized = "false";
    if (gallery._carouselTimers) {
      gallery._carouselTimers.forEach((t) => clearInterval(t));
      gallery._carouselTimers = [];
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGallery);
  } else {
    initGallery();
  }

  document.addEventListener("astro:after-swap", () => {
    destroyGallery();
    initGallery();
  });
</script>

<script>
  import { initCardCarousels } from "../../scripts/cardCarousel";

  initCardCarousels();
</script>
