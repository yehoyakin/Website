---
// Purpose: Page - src/pages/portfolio.astro (Portfolio listing)
import MyLayout from "../layouts/MyLayout.astro";
import Title from "../components/UI/Title.astro";
import Body from "../components/UI/Body.astro";
import BackLink from "../components/shared/BackLink.astro";
import ProjectGallery from "../components/sections/ProjectGallery.astro";
import PageBackdrop from "../components/shared/PageBackdrop.astro";

import { getCollection } from "astro:content";
import { asset } from "../utils/asset";

const rawProjects = await getCollection("projects");

const projects = await Promise.all(
  rawProjects.map(async (project) => ({
    ...project,
    rendered: project.rendered?.html ?? "",
  })),
);

const bgDay = asset("images/pageBackgrounds/PortfolioDay.webp");
const bgNight = asset("images/pageBackgrounds/PortfolioNight.webp");

const cardPreviews = projects.map((p) => asset(p.data.cardBackground)).filter(Boolean);

const imagesToPreload = [bgDay, bgNight, ...cardPreviews];
---

<MyLayout title="Portfolio | JoacoDev" preloadImages={imagesToPreload}>
  {/* `relative` (not `absolute inset-0`): the page box has to grow with the
      content so the project band below can run to its real bottom edge. No
      `overflow-x-hidden` here either — the band is wider than this box so it
      can reach past the layout gutter to the viewport edges; `main` above
      already clips that overflow. */}
  <div
    class="relative w-full min-h-screen bg-[var(--time-page)]"
  >
    <PageBackdrop
      day="images/pageBackgrounds/PortfolioDay.webp"
      night="images/pageBackgrounds/PortfolioNight.webp"
    />

    {/* Full-bleed project band. It lives at page level, not inside a panel, so
        its width is the page's width and its `bottom` is the page's bottom;
        the gallery script moves it to the open project and tints it. */}
    <span
      id="project-band"
      class="project-band pattern-plate pattern-plate--medium"
      aria-hidden="true"></span>

    <div class="absolute inset-0 z-10 pointer-events-none"></div>

    <div class="relative z-20 py-16 md:py-24 px-4 sm:px-6 md:px-8 w-full">
      <BackLink />

      <section class="mt-6 w-full text-center">
        <Title class="mt-3 text-5xl md:text-6xl" level={1} theme="orange">
          Portfolio
        </Title>

        <Body theme="purple" class="mt-4 max-w-2xl mx-auto" shadow={true}>
          Browse through my projects. Click any project to expand it and explore
          the full development breakdown.
        </Body>

        <div class="mt-12">
          <ProjectGallery projects={projects} />
        </div>
      </section>
    </div>
  </div>
</MyLayout>
