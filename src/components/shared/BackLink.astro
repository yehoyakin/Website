---
// Purpose: Component - src/components/shared/BackLink.astro (Top-left back arrow: a bare chrome icon button, the left twin of the day / night switch)
// See: file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/chrome/backLink.css, file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/chrome/pixelChrome/iconButtons.css
import Icon from "./Icon.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/shared/Icon.astro

interface Props {
  href?: string;
  // The accessible name only: the control shows just its arrow, like the day /
  // night and desktop-view switches beside and across from it.
  text?: string;
}

const { href, text = "Back to home" } = Astro.props;

// Resolve the base URL so links work correctly in production builds.
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

// Prefer an explicit link when provided; otherwise fall back to the site root.
const resolvedHref = href || baseUrl;

// Site chrome, not page content: this is a bare glyph on the page ink, the
   // same shape as the day / night switch — no plate, no frame, no theme.
   // chrome/backLink.css fixes it to the top-left corner of the shared chrome
   // gutter (directly across from that switch), pixelChrome/iconButtons.css
   // gives it the one bare-icon box and glyph size, and
   // chrome/pixelChrome/controlHover.css gives it the one grow-and-shine hover
   // every button shares. The arrow stays unthemed so Icon.astro renders its
   // day / night pair.
const classes = "back-link icon-button";
---

<a href={resolvedHref} class={classes} aria-label={text} title={text}>
  {/* The arrow is the set's `arrow-left` artwork at the shared chrome glyph size (chrome/pixelChrome/iconButtons.css); `text` is its screen-reader name, never shown. */}
  <Icon name="arrow-left" class="chrome-icon" />
</a>
