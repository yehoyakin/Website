---
// Purpose: Component - src/components/Blog/BlogSidebar.astro (Sidebar content for blog pages)
import LinkCard from "../sections/LinkCard.astro";

interface CardItem {
  href?: string;
  tag?: string;
  title: string;
  description?: string;
  actionText?: string;
  backgroundImage?: string;
  links?: {
    href: string;
    text?: string;
    /** Icon name from the shared registry, e.g. "Handbag". */
    icon?: string;
  }[];
}

interface Props {
  cards: CardItem[];
  /** Theme name — picks the icon colour that matches the post. */
  theme?: string;
}

const { cards = [], theme } = Astro.props as Props;
---

{
  /* No scroll frame of its own: this sits inside the rail panel
     (components/shared/RailPanel.astro), which already caps its height and
     scrolls. A second `overflow-y: auto` here gave the panel two scrollbars. */
}
<aside class="relative z-20 w-full retro-scrollbar">
  {
    cards.map((card) => (
      <div class="links-panel-group w-full overflow-hidden">
        <LinkCard
          href={card.href}
          links={card.links}
          theme={theme}
          tag={card.tag}
          title={card.title}
          description={card.description}
          actionText={card.actionText}
          backgroundImage={card.backgroundImage}
          class="h-auto"
        />
      </div>
    ))
  }
</aside>
