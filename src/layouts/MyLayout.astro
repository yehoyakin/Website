---
import "../styles/site.css";
import { ClientRouter } from "astro:transitions";
import { toThemeName, toThemeToken } from "../config/uiDictionary";
import { asset } from "../utils/asset";
import ModeToggle from "../components/shared/ModeToggle.astro";
import { defaultIconColor, defaultIconColorNight } from "../config/icons";

const { title = "JoacoDev", theme, page } = Astro.props;

// A page that assigns a theme carries the tokens.css token in `data-theme`,
// which is what fonts.css keys the page's font set off.
const themeAttribute =
  typeof theme === "string" && theme.trim() !== ""
    ? toThemeToken(toThemeName(theme))
    : undefined;

---

<html
  lang="en"
  data-theme={themeAttribute}
  data-page={page}
  data-icon-day={defaultIconColor}
  data-icon-night={defaultIconColorNight}
>
  <head>
    <meta charset="UTF-8" />
    {/* ONE LAYOUT, EVERY SCREEN.

        A fixed layout width means a phone lays the page out at the desktop
        width and scales the whole thing down to fit, instead of switching to
        the phone rules — so the computer layout and sizes are what you get on
        mobile too (and the max-width media queries never fire). `shrink-to-fit`
        is what makes Safari scale it rather than showing a 1280px slice. */}
    <meta name="viewport" content="width=1280, shrink-to-fit=yes" />
    <title>{title}</title>

    {/* Apply the day / night choice before first paint so the page never
        flashes the other mode. A stored choice wins; a first visit follows the
        OS colour-scheme preference. Kept in sync with scripts/modeToggle.js
        (resolveMode). */}
    <script is:inline>
      try {
        var storedMode = localStorage.getItem("time-mode");
        document.documentElement.dataset.mode =
          storedMode === "night" || storedMode === "day"
            ? storedMode
            : window.matchMedia?.("(prefers-color-scheme: dark)").matches
              ? "night"
              : "day";
      } catch {
        document.documentElement.dataset.mode = "day";
      }
    </script>

    {/* Favicons live in public/ and are prefixed with BASE_URL so they resolve
        under the configured base path (see astro.config.mjs). */}
    <link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />
    <link rel="icon" type="image/x-icon" href={asset("favicon.ico")} sizes="32x32" />
    <link rel="apple-touch-icon" href={asset("apple-touch-icon.png")} />
    <meta name="theme-color" content="#1E9AEC" />

    <ClientRouter />
  </head>

  <body
    class="bg-[var(--time-page)] text-[color:var(--time-ink)] antialiased selection:bg-amber-500/30 selection:text-white"
  >
    <ModeToggle />

    <div
      class="fixed inset-0 bg-[linear-gradient(to_right,var(--time-border-soft)_1px,transparent_1px),linear-gradient(to_bottom,var(--time-border-soft)_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none"
    >
    </div>

    <main
      class="relative z-10 min-h-screen w-full flex flex-col overflow-x-hidden"
    >
      <div class="w-full flex-1 px-4 sm:px-6 md:px-8 mx-auto">
        <slot />
      </div>
    </main>

    {
      /* Imported inside a script tag so Astro bundles it — a `src="/src/..."`
        reference is left untouched and 404s in a static build. */
    }
    <script>
      import "../scripts/socialsHook.js";
      import "../scripts/modeToggle.js";
      import "../scripts/patternTransition.js";
    </script>
  </body>
</html>
