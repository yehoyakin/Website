---
// Purpose: Component - src/components/shared/BackLink.astro (Top-left back arrow: the site's one themed button tile, the left twin of the day / night switch)
// See: file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/chrome/backLink.css, file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/chrome/pixelChrome/buttons.css, file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/chrome/pixelChrome/tintedButtons.css

interface Props {
  href?: string;
  // The accessible name only: the control shows just its arrow, like the day /
  // night and desktop-view switches beside and across from it.
  text?: string;
}

const { href, text = "Back to home" } = Astro.props;

// Resolve the base URL so links work correctly in production builds.
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

// Prefer an explicit link when provided; otherwise fall back to the site root.
const resolvedHref = href || baseUrl;

// Site chrome wearing the site's ONE button visual: the themed gradient tile
   // every button gets (`retro-link pixel-frame` + `data-link-theme`, the same
   // recipe the Link panels use and the gallery navigator builds in
   // scripts/cardCarousel.js). `icon-button` keeps the shared chrome box so it
   // stays the same size and row as the day / night switch, and
   // chrome/backLink.css pins it to the top-left corner and restates the
   // square so the button family's label sizing cannot stretch it. The arrow
   // is its own glyph — ↩ ("return"), deliberately NOT the navigator's ◄ / ▶
   // triangles — so nobody mistakes the corner for the strip's prev button.
const classes = "back-link retro-link pixel-frame icon-button";
---

<a href={resolvedHref} class={classes} data-link-theme="" aria-label={text} title={text}>
  {/* Its own return arrow, not the carousel's direction triangles (scripts/cardCarousel.js emits ◄ U+25C4 / ▶ U+25BA there); `text` is the screen-reader name, never shown. */}
  <span class="back-link-arrow" aria-hidden="true">&#x21A9;</span>
</a>
