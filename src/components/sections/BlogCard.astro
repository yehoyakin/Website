---
// Purpose: Component - src/components/sections/BlogCard.astro (Card for blog posts and projects)
// See: file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/card/retroCard.css, file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/carousel/carouselLayout.css, file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/card/pageCards.css
import type { BlogPost } from "../../types/blog";
import type { ProjectEntry } from "../../types/project";
import Title from "../UI/Title.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/UI/Title.astro
import Body from "../UI/Body.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/UI/Body.astro
import Icon from "../shared/Icon.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/shared/Icon.astro
import { resolveThemeToken, toThemeName } from "../../config/uiDictionary";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/config/uiDictionary.ts
import { patternForTheme } from "../../config/patterns";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/config/patterns.ts
import { asset } from "../../utils/asset";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/utils/asset.ts

// ONE CARD, TWO COLLECTIONS
   // -------------------------
   // A post and a project carry the same things a card needs: a title, a
   // one-line description, an image and a theme. The portfolio therefore reuses
   // this component instead of keeping a card of its own, so both listings are
   // literally the same markup and cannot drift apart again — both fed through
   // the one gallery (sections/ListingGallery.astro).
   // The two differences live in the meta line and the destination:
     // blog post  date + calendar glyph, links to the article
     // project    its engine / tool tag, links to its write-up page
type Props = {
  post?: BlogPost;
  project?: ProjectEntry;
};

const { post, project } = Astro.props as Props;

if (!post && !project) {
  throw new Error("BlogCard needs a `post` or a `project`.");
}

const themeName = toThemeName((post ?? project)!.data.theme);
const dynamicToken = resolveThemeToken(themeName);

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

// Both destinations are internal: the article, or the project's write-up.
const href = post
  ? `${baseUrl}blog/${post.id}/`
  : `${baseUrl}portfolio/${project!.id}/`;

const metaText = post
  ? new Date(post.data.date).toDateString()
  : project!.data.tag;
const metaIcon = post ? "Calendar" : undefined;

const image = post ? post.data.cardBackground : project!.data.cardBackground;
const title = post ? post.data.title : project!.data.title;
const description = post ? post.data.description : project!.data.description;
const hasDescription = Boolean(description && description.trim().length > 0);

// The card's scrolling texture, in the entry's own theme colour. Declared on
   // the root so both bars inherit it; the drawing lives in
   // styles/chrome/pixelChrome.css under `.pattern-plate`.
const cardStyle = [
  `--project-tag-color: ${dynamicToken}`,
  `--project-tag-color-dark: var(--theme-${themeName}-dark)`,
  `--plate-pattern: url('${patternForTheme(themeName)}')`,
].join("; ");
---

<a href={href} class="retro-card pixel-frame group" style={cardStyle}>
  {/* TOP BAR - date, or the project's engine / tool tag */}
  <div class="retro-card-bar pattern-plate pattern-plate--small flex items-center gap-2">
    {metaIcon && <Icon name={metaIcon} theme={themeName} class="h-8 w-8" />}
    <Body
      theme={themeName}
      class="retro-card-meta text-xs sm:text-sm"
    >
      {metaText}
    </Body>
  </div>

  {/* IMAGE */}
  {
    image && (
      <div class="retro-card-media">
        <img
          class="retro-card-img"
          src={asset(image)}
          alt=""
          decoding="async"
        />
        <div class="retro-card-overlay" />
      </div>
    )
  }

  {/* BOTTOM BAR - Title + Description */}
  {hasDescription && (
    <div class="retro-card-bar retro-card-info-bar pattern-plate pattern-plate--small">
      <Title
        level={3}
        theme={themeName}
        class="retro-card-title"
      >
        {title}
      </Title>

      <Body
        theme={themeName}
        class="retro-card-desc mt-2 text-sm sm:text-base text-[color:var(--time-ink-muted)] group-hover:text-[color:var(--time-ink)] readable-text"
      >
        {description}
      </Body>
    </div>
  )}
</a>
