---
// Purpose: Section - src/components/sections/ContactPanel.astro (Top-right contact quicklinks)
import SocialLink from "../shared/Link.astro";
import Icon from "../shared/Icon.astro";

const links = [
  { href: "mailto:joaquinignacio.herrerabriones@email.com", text: "Email", external: false, icon: "email" },
  { href: "https://github.com/yehoyakin", text: "GitHub", external: true, icon: "internet" },
  { href: "https://gitlab.com/yehoyakin", text: "GitLab", external: true, icon: "internet" },
  { href: "https://www.linkedin.com/in/joaquín-herrera-366b2a175", text: "LinkedIn", external: true, icon: "internet" }
];
---

{/* Hover / tap floating tab. Behaviour lives in scripts/socialsHook.js. */}
<div
  id="socials-container"
  class="group fixed top-1/4 right-0 z-50 flex items-start transition-transform duration-300 translate-x-[calc(100%-2.75rem)] [&.socials-open]:translate-x-0"
>
  {/* The clickable/hoverable contacts tab handle */}
  <button
    id="socials-toggle"
    class="bg-[var(--time-surface)] text-[color:var(--time-ink)] p-3 rounded-none shadow-lg cursor-pointer select-none border border-r-0 border-[color:var(--time-border-soft)] group-[.socials-open]:opacity-0 transition-opacity duration-200 flex items-center justify-center focus:outline-none"
    aria-label="Toggle Social Links"
    type="button"
  >
    <Icon name="contacts" class="h-6 w-6" />
  </button>

  <div
    id="socials-panel"
    class="bg-[var(--time-panel)] backdrop-blur-md p-6 rounded-none border border-[color:var(--time-border-soft)] shadow-2xl w-64 max-h-[70vh] overflow-y-auto"
  >
    <div class="space-y-3">
      {
        links.map((link) => (
          <SocialLink
            href={link.href}
            text={link.text}
            external={link.external}
            icon={link.icon}
          />
        ))
      }
    </div>
  </div>
</div>
