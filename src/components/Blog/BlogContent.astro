---
// Purpose: Component - src/components/Blog/BlogContent.astro (Render post body and scene images)
// See: file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/portfolio/galleryThumbnailSlide.css, file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/portfolio/galleryPanelShell.css, file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/carousel/carouselLayout.css

import CompactBody from "../UI/CompactBody.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/UI/CompactBody.astro
import Icon from "../shared/Icon.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/shared/Icon.astro
import {
  defaultIconColor,
  defaultIconColorNight,
  iconColorForTheme,
} from "../../config/icons";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/config/icons.ts
import { patternForTheme } from "../../config/patterns";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/config/patterns.ts
import { resolveThemeToken } from "../../config/uiDictionary";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/config/uiDictionary.ts
import { asset } from "../../utils/asset";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/utils/asset.ts
import { videoEmbedUrl } from "../../utils/video";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/utils/video.ts
import "../../styles/portfolio/galleryThumbnailSlide.css";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/portfolio/galleryThumbnailSlide.css

interface SceneItem {
  image: string;
  align?: "left" | "right" | "center";
  size?: "auto" | "16:9" | "4:3";
  caption?: string;
}

interface VideoItem {
  src: string;
  poster?: string;
  align?: "left" | "right" | "center";
  size?: "auto" | "16:9" | "4:3" | "9:16";
  caption?: string;
  title?: string;
  type?: "auto" | "file" | "embed";
}

type GalleryMediaItem =
  | { kind: "image"; src: string; alt: string }
  | { kind: "video"; src: string; poster?: string; title?: string }
  | { kind: "embed"; src: string; title?: string };

type MarkdownBlock =
  | { type: "paragraph"; text: string }
  | { type: "heading"; level: number; text: string }
  | { type: "image"; src: string; alt: string }
  | { type: "gallery"; items: GalleryMediaItem[] }
  | { type: "list"; ordered: boolean; items: string[] }
  | { type: "video"; index: number; size?: string; caption?: string }
  | { type: "background"; index: number };

interface Props {
  bodyHtml?: string;
  blocks?: MarkdownBlock[];
  scenes?: SceneItem[];
  videos?: VideoItem[];
  theme?: string;
}

const { bodyHtml = "", blocks = [], scenes = [], videos = [], theme = "orange" } = Astro.props as Props;
const themeToken = resolveThemeToken(theme);
const listIconColor = iconColorForTheme(theme);
const galleryThemeIconColor = iconColorForTheme(theme);
const galleryStyle = `--thumb-theme-color: ${themeToken}; --project-tag-color: ${themeToken}; --project-tag-color-dark: var(--theme-${theme}-dark); --plate-pattern: url('${patternForTheme(theme)}')`;
const siteBaseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

// The lede: the post's opening paragraph, i.e. the first paragraph block that
   // actually has words in it — a [background[x]] marker wraps in its own empty
   // paragraph and must not take the treat. `blog-lede` is what gives it the
   // drop cap; see styles/article/articleProse.css.
const ledeIndex = blocks.findIndex(
  (block) => block.type === "paragraph" && block.text.trim().length > 0,
);

 // Replace [scene[x]] and [scene[x,y,z]] markers with image blocks.
 // SAFE for BOTH raw paths and asset() resolved paths.
const getAspectClass = (size?: SceneItem["size"]) => {
  switch (size) {
    case "16:9":
      return "aspect-video";
    case "4:3":
      return "aspect-[4/3]";
    default:
      return "";
  }
};

const getCaptionAlignmentClass = (align?: string) => {
  switch (align) {
    case "left":
      return "text-left";
    case "right":
      return "text-right";
    default:
      return "text-center";
  }
};

const getSceneSizeClass = (size?: string) => {
  switch (size) {
    case "wide":
      return "max-w-[80vw]";
    case "large":
      return "max-w-[90vw]";
    case "full":
      return "max-w-[95vw]";
    // Default is the READING COLUMN, not a viewport fraction: 60vw made a
       // picture 768px wide beside 976px of text on a desktop, and only 234px
       // wide beside 278px of text on a phone — an image narrower than the
       // paragraph it belongs to, at every size. The column is the measure the
       // figure is part of, so that is the width it takes.
    default:
      return "max-w-full";
  }
};

 // Clean up a caption string: strip quotes (straight or curly), HTML entities, trim.
const cleanCaption = (raw: string): string => {
  return raw
    .replace(/^[\s,]*/, "")
    .replace(/&quot;/g, '"')
    .replace(/&ldquo;/g, '"')
    .replace(/&rdquo;/g, '"')
    .replace(/&apos;/g, "'")
    .replace(/&lsquo;/g, "'")
    .replace(/&rsquo;/g, "'")
    .replace(/&amp;/g, "&")
    .replace(/^["""\u201c\u201d]/, "")
    .replace(/["""\u201c\u201d]$/, "")
    .replace(/^['''\u2018\u2019]/, "")
    .replace(/['''\u2018\u2019]$/, "")
    .trim();
};

const renderScene = (
  sceneIndex: number,
  alignOverride?: string,
  captionOverride?: string,
  sizeOverride?: string,
) => {
  const scene = scenes[sceneIndex];
  if (!scene?.image) return "";

  const align = (alignOverride ?? scene.align ?? "center").toLowerCase();
  const aspectClass = getAspectClass(scene.size ?? "auto");
  const captionText = captionOverride ?? scene.caption ?? "";
  const sizeClass = getSceneSizeClass(sizeOverride || "default");

  let figureClass = `scene-reveal my-6 overflow-hidden rounded-none border border-[color:var(--time-border-soft)] bg-[var(--time-page)] w-full ${sizeClass} mx-auto`;

  let imgClass = "block w-full h-auto";

  if (aspectClass) {
    figureClass += ` ${aspectClass}`;
    imgClass = "block h-full w-full object-cover object-center";
  }

  switch (align) {
    case "left":
      figureClass += " float-left max-w-[45%] mr-6 mb-4";
      break;

    case "right":
      figureClass += " float-right max-w-[45%] ml-6 mb-4";
      break;

    default:
      figureClass += " mb-5";
      break;
  }

  const caption = captionText
    ? `
      <figcaption
        class="blog-figcaption"
      >
        ${captionText}
      </figcaption>
    `
    : "";

  return `
    <figure class="${figureClass}">
      <img
        src="${scene.image}"
        alt="Scene ${sceneIndex}"
        class="${imgClass}"
        loading="lazy"
        decoding="async"
      />
    </figure>
    ${caption}
  `;
};

 // Match scene markers in rendered HTML.
 // Handles: [scene[0]], [scene[0,1,2]], [scene[0, wide]], [scene[0], "caption"]
 // Works regardless of quote type (straight, curly, HTML entities).
 // Pattern: [scene[indexes, optional_size], optional_caption_text]
 // We capture everything after the inner ] as the raw caption text.
const SCENE_MARKER_RE =
  /\[scene\[([0-9,\s]+)(?:,\s*(wide|large|full))?\](?:,\s*([^\]]*))?\]/g;

const parseSceneMarker = (match: string) => {
  const result = SCENE_MARKER_RE.exec(match);
  if (!result) return null;

  const [, rawIndexes = "", sizeToken = "", rawCaption = ""] = result;

  const indexes = rawIndexes
    .split(",")
    .map((v) => Number.parseInt(v.trim(), 10))
    .filter((v): v is number => Number.isInteger(v) && v >= 0);

  const caption = cleanCaption(rawCaption);

  return { indexes, caption, size: sizeToken || undefined };
};

 // Replace [video[x]] and [video[x, "caption"]] markers with video blocks.
const getVideoAspectClass = (size: VideoItem["size"]) => {
  switch (size) {
    case "4:3":
      return "aspect-[4/3]";
    case "9:16":
      return "aspect-[9/16]";
    case "16:9":
      return "aspect-video";
    default:
      return "aspect-video";
  }
};



const renderVideo = (
  videoIndex: number,
  sizeOverride?: string,
  captionOverride?: string,
) => {
  const video = videos[videoIndex];
  if (!video?.src) return "";

  const align = (video.align ?? "center").toLowerCase();
  // `||` (not `??`): an empty marker caption falls back to `caption:`.
  const captionText = cleanCaption(captionOverride || video.caption || "");
  const embedUrl = videoEmbedUrl(video.src, video.type);
  const aspectClass = getVideoAspectClass(video.size);
  const title = video.title || `Video ${videoIndex}`;

  let figureClass =
    "scene-reveal my-6 overflow-hidden rounded-none border border-[color:var(--time-border-soft)] bg-[var(--time-page)] w-full";

  switch (align) {
    case "left":
      figureClass += " float-left max-w-[45%] mr-6 mb-4";
      break;

    case "right":
      figureClass += " float-right max-w-[45%] ml-6 mb-4";
      break;

    default:
      figureClass += ` ${getSceneSizeClass(sizeOverride || "default")} mx-auto mb-5`;
      break;
  }

   // The aspect ratio lives on an inner box so the caption stays
   // outside of it. Embeds always need a ratio; files keep their
   // natural one unless `size` asks otherwise.
  const hasFixedAspect =
    Boolean(embedUrl) || Boolean(video.size && video.size !== "auto");
  const frameClass = hasFixedAspect
    ? `relative w-full ${aspectClass}`
    : "w-full";

  const media = embedUrl
    ? `<iframe
        src="${embedUrl}"
        title="${title}"
        class="absolute inset-0 block h-full w-full border-0"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>`
    : `<video
        src="${video.src}"
        ${video.poster ? `poster="${video.poster}"` : ""}
        class="block w-full ${hasFixedAspect ? "h-full object-cover object-center" : "h-auto"}"
        controls
        playsinline
        preload="metadata"
      ></video>`;

  const caption = captionText
    ? `
      <figcaption class="blog-figcaption blog-figcaption--video blog-card-bar blog-card-info-bar pattern-plate pattern-plate--small ${getCaptionAlignmentClass(align)}">
        ${captionText}
      </figcaption>
    `
    : "";

  return `
    <figure class="${figureClass}">
      <div class="${frameClass}">
        ${media}
      </div>
      ${caption}
    </figure>
  `;
};

 // Match video markers in rendered HTML.
 // Handles: [video[0]], [video[0, wide]], [video[0], "caption"]
const VIDEO_MARKER_RE =
  /\[video\[(\d+)(?:,\s*(wide|large|full))?\](?:,\s*([^\]]*))?\]/g;

const parseVideoMarker = (match: string) => {
  const result = VIDEO_MARKER_RE.exec(match);
  if (!result) return null;

  const [, rawIndex = "", sizeToken = "", rawCaption = ""] = result;
  const index = Number.parseInt(rawIndex, 10);
  if (!Number.isInteger(index) || index < 0) return null;

  return {
    index,
    caption: cleanCaption(rawCaption),
    size: sizeToken || undefined,
  };
};

const videoHtml =
  Array.isArray(videos) && videos.length > 0
    ? bodyHtml.replace(VIDEO_MARKER_RE, (match: string) => {
        VIDEO_MARKER_RE.lastIndex = 0;
        const parsed = parseVideoMarker(match);
        if (!parsed) return match;

        return renderVideo(parsed.index, parsed.size, parsed.caption) || match;
      })
    : bodyHtml;

const sceneHtml =
  Array.isArray(scenes) && scenes.length > 0
    ? videoHtml.replace(SCENE_MARKER_RE, (match: string) => {
        // Reset lastIndex since we're using a global regex
        SCENE_MARKER_RE.lastIndex = 0;
        const parsed = parseSceneMarker(match);
        if (!parsed) return match;

        const { indexes, caption, size } = parsed;
        if (indexes.length === 0) return match;

        if (indexes.length === 1) {
          return renderScene(indexes[0], undefined, caption, size) || match;
        }

        const groupSizeClass =
          size === "wide"
            ? "max-w-[80vw] mx-auto"
            : size === "large"
              ? "max-w-[90vw] mx-auto"
              : size === "full"
                ? "max-w-[95vw] mx-auto"
                : "max-w-[85vw] mx-auto";
        const groupClass =
          `scene-reveal my-8 grid gap-4 sm:grid-cols-2 ${groupSizeClass}`.trim();
        const groupCaptionText = cleanCaption(
          caption || scenes[indexes[0]]?.caption || "",
        );

        const groupedScenes = indexes
          .map((sceneIndex: number) => {
            const scene = scenes[sceneIndex];
            if (!scene?.image) return "";

            const aspectClass = getAspectClass(scene.size ?? "auto");
            const figureClass =
              `my-0 overflow-hidden rounded-none border border-[color:var(--time-border-soft)] bg-[var(--time-page)] w-full ${aspectClass ? aspectClass : ""}`.trim();
            const imgClass = aspectClass
              ? "block h-full w-full object-cover object-center"
              : "block w-full h-auto";

            return `
              <figure class="${figureClass}">
                <img
                  src="${scene.image}"
                  alt="Scene ${sceneIndex}"
                  class="${imgClass}"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            `;
          })
          .filter(Boolean)
          .join("\n");

        const groupCaptionMarkup = groupCaptionText
          ? `
            <figcaption
              class="blog-figcaption"
            >
              ${groupCaptionText}
            </figcaption>
          `
          : "";

        return `<div class="${groupClass}">${groupedScenes}</div>${groupCaptionMarkup}`;
      })
    : videoHtml;
 // Every post opens with a [background[x]] marker on its own line, which markdown
 // wraps in a <p>. Two reasons to unwrap those:
 // - the wrapper added a full paragraph gap for an invisible anchor;
 // - it made the marker the article's first <p>, so the lede treatment
 // (and the drop cap on it) landed on an empty paragraph instead of the
 // opening sentence.
 // The span itself stays: scripts in pages/blog/[slug].astro measure its
 // position to drive the background crossfade.
const renderInlineMarkdown = (text: string) => {
  const inlinePattern = /(\*\*[^*]+\*\*|__[^_]+__|\*[^*]+\*|_[^_]+_|`[^`]+`)/g;
  const parts: Array<{ type: "text" | "strong" | "em" | "code"; value: string }> = [];
  let lastIndex = 0;

  for (const match of text.matchAll(inlinePattern)) {
    const start = match.index ?? 0;
    const value = match[0];

    if (start > lastIndex) {
      parts.push({ type: "text", value: text.slice(lastIndex, start) });
    }

    const inner = value.replace(/^\*\*|^__|^\*|^_|^`|\*\*$|__$|\*$|_$|`$/g, "");

    if (value.startsWith("**") || value.startsWith("__")) {
      parts.push({ type: "strong", value: inner });
    } else if (value.startsWith("*") || value.startsWith("_")) {
      parts.push({ type: "em", value: inner });
    } else {
      parts.push({ type: "code", value: inner });
    }

    lastIndex = start + value.length;
  }

  if (lastIndex < text.length) {
    parts.push({ type: "text", value: text.slice(lastIndex) });
  }

  return parts;
};


---

{/* Reading surface. The frame, plate and padding live in styles/article/blogArticle.css (`#blog-content`), which is also where the prose typography is: one file owns how an article reads. `pattern-plate--huge` carries the post's texture across the column: the biggest tile on the site, scrolling at about half the card speed and at a seventh of their opacity, so it registers as a surface and never as movement behind the words. The tile URL comes from the page, which owns the post's theme. */}
<div class="screen-grade-ring screen-grade-ring--hairline">
<div
  class="blog-article-body pattern-plate pattern-plate--text-backdrop pattern-plate--huge"
  id="blog-content"
>
  {/* Long-form body: Body.astro is sized for short copy and drops under the 16px the pixel face needs, so the article's text is rendered through CompactBody instead. No theme prop — the section already carries the post's accent and the body must inherit it. */}
  <CompactBody>
    <div>
      {blocks.map((block, blockIndex) => {
        if (block.type === "background") {
          return (
            <span
              class="bg-marker"
              data-bg-index={String(block.index)}
            />
          );
        }

        if (block.type === "heading") {
          const HeadingTag = `h${Math.min(6, Math.max(1, block.level))}` as keyof HTMLElementTagNameMap;

          return (
            <HeadingTag>
              {renderInlineMarkdown(block.text).map((part, index) => {
                if (part.type === "text") return <>{part.value}</>;
                if (part.type === "strong") return <strong key={index}>{part.value}</strong>;
                if (part.type === "em") return <em key={index}>{part.value}</em>;
                return <code key={index}>{part.value}</code>;
              })}
            </HeadingTag>
          );
        }

        if (block.type === "paragraph") {
          return (
            <p class={blockIndex === ledeIndex ? "blog-lede" : undefined}>
              {renderInlineMarkdown(block.text).map((part, index) => {
                if (part.type === "text") return <>{part.value}</>;
                if (part.type === "strong") return <strong key={index}>{part.value}</strong>;
                if (part.type === "em") return <em key={index}>{part.value}</em>;
                return <code key={index}>{part.value}</code>;
              })}
            </p>
          );
        }

        if (block.type === "list") {
          const ListTag = block.ordered ? "ol" : "ul";

          return (
            <div class="retro-contribution retro-contribution--listing">
              <ListTag>
                {block.items.map((item, index) => {
                  const itemText = renderInlineMarkdown(item).map((part, partIndex) => {
                    if (part.type === "text") return <>{part.value}</>;
                    if (part.type === "strong") return <strong key={partIndex}>{part.value}</strong>;
                    if (part.type === "em") return <em key={partIndex}>{part.value}</em>;
                    return <code key={partIndex}>{part.value}</code>;
                  });

                  if (block.ordered) {
                    return (
                      <li class="markdown-list-item" key={`${block.ordered ? "ol" : "ul"}-${index}`}>
                        <span class="list-number-icon" aria-hidden="true">
                          <img
                            src={asset(`images/Icons/${listIconColor}/Number ${index + 1}_${listIconColor}.webp`)}
                            alt=""
                            loading="lazy"
                            decoding="async"
                            class="list-number-icon-img"
                          />
                        </span>
                        <span class="markdown-list-text">{itemText}</span>
                      </li>
                    );
                  }

                  return (
                    <li class="markdown-list-item" key={`${block.ordered ? "ol" : "ul"}-${index}`}>
                      <span class="list-bullet-icon" aria-hidden="true">
                        <img
                          src={asset(`images/Icons/${listIconColor}/Circle Base_${listIconColor}.webp`)}
                          alt=""
                          loading="lazy"
                          decoding="async"
                          class="list-bullet-icon-img"
                        />
                      </span>
                      <span class="markdown-list-text">{itemText}</span>
                    </li>
                  );
                })}
              </ListTag>
            </div>
          );
        }

        if (block.type === "video") {
          /* Same markup the marker replacement has always produced — the frame, the aspect box and the caption come from renderVideo. */
          return (
            <Fragment
              set:html={renderVideo(block.index, block.size, block.caption)}
            />
          );
        }

        if (block.type === "image") {
          const images = [{ src: block.src, alt: block.alt || "" }];
          const firstTitleText = images[0].alt?.trim();
          const hasTitleText = Boolean(firstTitleText && firstTitleText.length > 0);

          return (
            <div class="project-gallery markdown-gallery markdown-gallery--single" data-gallery-ready="false" data-icon-color={galleryThemeIconColor} data-site-base-url={siteBaseUrl}>
              <div class="gallery-thumbnails-wrapper" data-carousel data-carousel-item=".gallery-project-item" data-carousel-label="Gallery" data-icon-color={galleryThemeIconColor}>
                <div class="gallery-thumbnails" data-carousel-track>
                  {images.map((image, index) => {
                    const titleText = image.alt?.trim();
                    const hasTitleText = Boolean(titleText && titleText.length > 0);

                    return (
                      <div class="gallery-project-item">
                        <button
                          class="gallery-thumb blog-card pixel-frame blog-inner-image-card"
                          aria-label={hasTitleText ? `View ${titleText}` : `View image ${index + 1}`}
                          title={titleText || undefined}
                          data-thumb-index={0}
                          data-lightbox-index={index}
                          data-lightbox-src={image.src}
                          data-lightbox-alt={titleText || image.alt || `Image ${index + 1}`}
                          style={galleryStyle}
                        >
                              <div
                                class="blog-card-image-wrap relative flex min-h-0 flex-col"
                              >
                                <div class="thumb-carousel">
                                  <img
                                    src={image.src}
                                    alt={titleText || ""}
                                    class="thumb-carousel-media thumb-carousel-img active"
                                    decoding="async"
                                  />
                                </div>
                                <div class="thumb-overlay" />
                              </div>
                              {hasTitleText && (
                                <div class="blog-card-bar blog-card-info-bar pattern-plate pattern-plate--small">
                                  <span class="gallery-thumb-desc">{titleText}</span>
                                </div>
                              )}
                        </button>
                      </div>
                    );
                  })}
                </div>
              </div>

              <div class="gallery-panels-container">
                <div class="blog-gallery-lightbox" aria-hidden="true" data-gallery-lightbox data-lightbox-single="true" style={galleryStyle}>
                  <div class="blog-gallery-lightbox__backdrop" data-lightbox-close></div>
                  <button type="button" class="blog-gallery-lightbox__close icon-button" aria-label="Close image preview" data-lightbox-close>
                    <Icon name="close" theme={theme} class="blog-gallery-lightbox__close-icon" />
                  </button>
                  <button type="button" class="blog-gallery-lightbox__nav blog-gallery-lightbox__nav--prev icon-button" aria-label="Previous image" data-lightbox-prev>
                    <Icon name="arrow-left" theme={theme} class="card-carousel-arrow-icon" />
                  </button>
                  <button type="button" class="blog-gallery-lightbox__nav blog-gallery-lightbox__nav--next icon-button" aria-label="Next image" data-lightbox-next>
                    <Icon name="arrow-right" theme={theme} class="card-carousel-arrow-icon" />
                  </button>
                  <div class="blog-gallery-lightbox__panel pattern-plate pattern-plate--medium" role="dialog" aria-modal="true" aria-label="Image preview" style={galleryStyle}>
                    <div class="blog-gallery-lightbox__media">
                      <img class="blog-gallery-lightbox__image" src={images[0].src} alt={images[0].alt || "Image preview"} loading="eager" decoding="async" />
                    </div>
                    <div class="blog-gallery-lightbox__meta">
                      <div class="blog-gallery-lightbox__dots card-carousel-dots" aria-label="Image index"></div>
                      {hasTitleText && <span class="blog-gallery-lightbox__caption blog-card-bar blog-card-info-bar pattern-plate pattern-plate--small">{firstTitleText}</span>}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          );
        }

        if (block.type === "gallery") {
          const items = block.items;
          const isSingleGallery = items.length === 1;
          const firstItem = items[0];

          return (
            <div class={`project-gallery markdown-gallery${isSingleGallery ? " markdown-gallery--single" : ""}`} data-gallery-ready="false" data-icon-color={galleryThemeIconColor} data-site-base-url={siteBaseUrl}>
              <div class="gallery-thumbnails-wrapper" data-carousel data-carousel-item=".gallery-project-item" data-carousel-label="Gallery" data-icon-color={galleryThemeIconColor}>
                <div class="gallery-thumbnails" data-carousel-track>
                  {items.map((item, index) => {
                    const titleText = item.kind === "image" ? item.alt?.trim() : (item.title?.trim() || `Media ${index + 1}`);
                    const hasTitleText = Boolean(titleText && titleText.length > 0);

                    const lightboxSrc = item.kind === "image" ? item.src : item.src;
                    const lightboxAlt = item.kind === "image" ? item.alt : (item.title || `Media ${index + 1}`);

                    return (
                      <div class="gallery-project-item">
                        <button
                          class="gallery-thumb blog-card pixel-frame blog-inner-image-card"
                          aria-label={hasTitleText ? `View ${titleText}` : `View media ${index + 1}`}
                          title={titleText || undefined}
                          data-thumb-index={0}
                          data-lightbox-index={index}
                          data-lightbox-src={lightboxSrc}
                          data-lightbox-kind={item.kind}
                          data-lightbox-alt={lightboxAlt}
                          data-lightbox-poster={item.kind === "video" ? (item.poster || "") : ""}
                          style={galleryStyle}
                        >
                          <div class="blog-card-image-wrap">
                            <div class="thumb-carousel">
                              {item.kind === "image" && (
                                <img src={item.src} alt={titleText || `Image ${index + 1}`} class="thumb-carousel-media thumb-carousel-img active" decoding="async" />
                              )}
                              {item.kind === "video" && (
                                <video src={item.src} poster={item.poster} class="thumb-carousel-media thumb-carousel-video active" controls playsinline preload="metadata" />
                              )}
                              {item.kind === "embed" && (
                                <iframe src={item.src} title={item.title || `Embed ${index + 1}`} class="thumb-carousel-media thumb-carousel-frame active" loading="lazy" allowfullscreen />
                              )}
                            </div>
                            <div class="thumb-overlay" />
                          </div>
                          {hasTitleText && (
                            <div class="blog-card-bar blog-card-info-bar pattern-plate pattern-plate--small">
                              <span class="gallery-thumb-desc">{titleText}</span>
                            </div>
                          )}
                        </button>
                      </div>
                    );
                  })}
                </div>
              </div>

              <div class="gallery-panels-container">
                <div class="blog-gallery-lightbox" aria-hidden="true" data-gallery-lightbox data-lightbox-single={isSingleGallery} style={galleryStyle}>
                  <div class="blog-gallery-lightbox__backdrop" data-lightbox-close></div>
                  <button type="button" class="blog-gallery-lightbox__close icon-button" aria-label="Close media preview" data-lightbox-close>
                    <Icon name="close" theme={theme} class="blog-gallery-lightbox__close-icon" />
                  </button>
                  <button type="button" class="blog-gallery-lightbox__nav blog-gallery-lightbox__nav--prev icon-button" aria-label="Previous media" data-lightbox-prev>
                    <Icon name="arrow-left" theme={theme} class="card-carousel-arrow-icon" />
                  </button>
                  <button type="button" class="blog-gallery-lightbox__nav blog-gallery-lightbox__nav--next icon-button" aria-label="Next media" data-lightbox-next>
                    <Icon name="arrow-right" theme={theme} class="card-carousel-arrow-icon" />
                  </button>
                  <div class="blog-gallery-lightbox__panel pattern-plate pattern-plate--medium" role="dialog" aria-modal="true" aria-label="Media preview" style={galleryStyle}>
                    <div class="blog-gallery-lightbox__media">
                      <div class="blog-gallery-lightbox__stage" data-lightbox-stage />
                    </div>
                    <div class="blog-gallery-lightbox__meta">
                      <div class="blog-gallery-lightbox__dots card-carousel-dots" aria-label="Media index"></div>
                      <span class="blog-gallery-lightbox__caption blog-card-bar blog-card-info-bar pattern-plate pattern-plate--small" data-lightbox-caption hidden />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          );
        }

        return null;
      })}
    </div>
  </CompactBody>
</div>
</div>

<script>
  // A bundled (not is:inline) script, so Astro resolves and ships these
     // imports. Inline scripts are copied verbatim, and their relative imports
     // 404'd in the browser, which stopped every gallery from opening.
  import { initGalleryEqualHeight } from "../../scripts/galleryEqualHeight.js";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/scripts/galleryEqualHeight.js
  import { initCardCarousels } from "../../scripts/cardCarousel.js";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/scripts/cardCarousel.js
  {
    const initMarkdownGalleries = () => {
      const galleries = document.querySelectorAll(".project-gallery[data-gallery-ready='false']");
      if (!galleries.length) return;

      galleries.forEach((gallery) => {
        gallery.dataset.galleryReady = "true";

        const thumbs = [...gallery.querySelectorAll(".gallery-thumb[data-lightbox-index]")];
        const lightbox = gallery.querySelector("[data-gallery-lightbox]");
        if (!lightbox || !thumbs.length) return;

        const stage = lightbox.querySelector("[data-lightbox-stage]");
        const captionEl = lightbox.querySelector("[data-lightbox-caption]");
        const dotsWrap = lightbox.querySelector(".blog-gallery-lightbox__dots");
        const closeButtons = lightbox.querySelectorAll("[data-lightbox-close]");
        const prevBtn = lightbox.querySelector("[data-lightbox-prev]");
        const nextBtn = lightbox.querySelector("[data-lightbox-next]");

        const themedColor = gallery.dataset.iconColor || document.documentElement.dataset.iconDay || "Lightblue";
        const baseUrl = gallery.dataset.siteBaseUrl || "/";

        const makeDot = (index) => {
          const dot = document.createElement("button");
          dot.type = "button";
          dot.className = "card-carousel-dot";
          dot.setAttribute("aria-label", `View media ${index + 1}`);

          const pair = document.createElement("span");
          pair.className = "card-carousel-dot-icon icon-mode";

          ["day", "night"].forEach((mode) => {
            const icon = document.createElement("img");
            icon.src = `${baseUrl}images/Icons/${themedColor}/Circle Base_${themedColor}.webp`;
            icon.alt = "";
            icon.setAttribute("aria-hidden", "true");
            icon.decoding = "async";
            icon.className = `icon-mode-img icon-mode-img--${mode}`;
            pair.appendChild(icon);
          });

          dot.appendChild(pair);
          dot.addEventListener("click", () => openLightbox(index));
          return dot;
        };

        let items = [];
        let dotButtons = [];
        let currentIndex = 0;

        // Build a media list from the thumbnails in this gallery. Each thumb
           // carries data-lightbox-kind ("image", "video", or "embed") so the
           // lightbox stage can render the correct element type.
        const itemsFor = (thumb) => {
          const owner = thumb?.closest(".project-gallery") || gallery;

          return [...owner.querySelectorAll(".gallery-thumb[data-lightbox-index]")].map((node) => ({
            kind: node.dataset.lightboxKind || "image",
            src: node.dataset.lightboxSrc,
            poster: node.dataset.lightboxPoster || "",
            alt: node.dataset.lightboxAlt || node.getAttribute("aria-label") || "Media preview",
          }));
        };

        // Render one media item into the lightbox stage. Mirrors the project
           // slug's render() so videos and embeds work identically.
        const render = (index) => {
          const item = items[index];
          if (!item || !stage) return;

          let node;

          if (item.kind === "embed") {
            node = document.createElement("iframe");
            node.src = item.src;
            node.title = item.alt || "Media";
            node.referrerPolicy = "strict-origin-when-cross-origin";
            node.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
            node.setAttribute("allowfullscreen", "");
          } else if (item.kind === "video") {
            node = document.createElement("video");
            node.src = item.src;
            if (item.poster) node.poster = item.poster;
            node.controls = true;
            node.playsInline = true;
            node.preload = "metadata";
          } else {
            node = document.createElement("img");
            node.src = item.src;
            node.alt = item.alt;
            node.loading = "eager";
            node.decoding = "async";
          }

          node.className = "blog-gallery-lightbox__image";
          stage.replaceChildren(node);

          if (captionEl) {
            captionEl.textContent = item.alt;
            captionEl.hidden = !item.alt;
          }

          dotButtons.forEach((dot, dotIndex) => {
            dot.setAttribute("aria-current", dotIndex === index ? "true" : "false");
          });
        };

        const updateLightbox = (index) => {
          if (!items.length) return;

          const normalizedIndex = ((index % items.length) + items.length) % items.length;
          currentIndex = normalizedIndex;
          render(currentIndex);
        };

        // One panel on screen at a time: a gallery opened while another panel is
           // still up would otherwise show through behind it.
        const closeOtherLightboxes = () => {
          document.querySelectorAll(".blog-gallery-lightbox.is-open").forEach((other) => {
            if (other === lightbox) return;
            other.classList.remove("is-open");
            other.setAttribute("aria-hidden", "true");
          });
        };

        const openLightbox = (index, thumb) => {
          items = itemsFor(thumb);
          dotButtons = items.map((_item, dotIndex) => makeDot(dotIndex));
          if (dotsWrap) {
            dotsWrap.replaceChildren(...dotButtons);
          }

          // A one-item gallery has nowhere to go: the CSS hides the arrows and
             // the dot index from this flag.
          lightbox.dataset.lightboxSingle = items.length <= 1 ? "true" : "false";

          closeOtherLightboxes();
          // Opened from <body> so no transformed or clipping ancestor (the
             // gallery strip, a plate, a reveal animation) can trap the
             // fixed-position overlay inside the page.
          if (lightbox.parentElement !== document.body) document.body.appendChild(lightbox);
          lightbox.classList.add("is-open");
          lightbox.setAttribute("aria-hidden", "false");
          document.body.classList.add("lightbox-open");
          updateLightbox(index);
        };

        const closeLightbox = () => {
          lightbox.classList.remove("is-open");
          lightbox.setAttribute("aria-hidden", "true");

          // Unmount the stage to stop any playing video or embed.
          stage?.replaceChildren();

          if (!document.querySelector(".blog-gallery-lightbox.is-open")) {
            document.body.classList.remove("lightbox-open");
          }
        };

        // The thumbnail's own index inside its strip is what opens it, so the
           // number of galleries above it on the page cannot shift the picture.
        thumbs.forEach((thumb) => {
          thumb.addEventListener("click", (event) => {
            event.preventDefault();
            openLightbox(Number(thumb.dataset.lightboxIndex) || 0, thumb);
          });
        });

        closeButtons.forEach((button) => {
          button.addEventListener("click", closeLightbox);
        });

        prevBtn?.addEventListener("click", () => openLightbox(currentIndex - 1));
        nextBtn?.addEventListener("click", () => openLightbox(currentIndex + 1));

        lightbox.addEventListener("click", (event) => {
          if (event.target === lightbox || event.target.closest("[data-lightbox-close]")) {
            closeLightbox();
          }
        });

        document.addEventListener("keydown", (event) => {
          if (!lightbox.classList.contains("is-open")) return;

          if (event.key === "Escape") closeLightbox();
          if (event.key === "ArrowRight") openLightbox(currentIndex + 1);
          if (event.key === "ArrowLeft") openLightbox(currentIndex - 1);
        });
      });
    };

    const initReveal = () => {
      const figures = document.querySelectorAll(".scene-reveal");
      if (!figures.length) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("revealed");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: "0px 0px -50px 0px" },
      );

      figures.forEach((fig) => observer.observe(fig));
    };

    document.addEventListener("astro:page-load", () => {
      initMarkdownGalleries();
      initCardCarousels();
      initReveal();
      initGalleryEqualHeight();
    });
    document.addEventListener("DOMContentLoaded", () => {
      initMarkdownGalleries();
      initCardCarousels();
      initReveal();
      initGalleryEqualHeight();
    });
    initMarkdownGalleries();
    initCardCarousels();
    initReveal();
    initGalleryEqualHeight();
  }
</script>
