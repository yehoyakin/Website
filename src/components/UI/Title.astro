---
// Purpose: Component - src/components/UI/Title.astro (UI Title component)
import {
  getThemeConfig,
  resolveThemeToken,
  toThemeName,
  toThemeToken,
} from "../../config/uiDictionary";

interface Props {
  class?: string;
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  outline?: boolean;
  /** Theme name — controls font, color and transition. Any string works. */
  theme?: string;
  /** Add subtle text shadow for readability against blurred backgrounds. */
  shadow?: boolean;
}

const {
  class: customClass = "",
  level = 2,
  outline = false,
  theme: rawTheme,
  shadow = false,
} = Astro.props;

const themeName = toThemeName(rawTheme);
const config = getThemeConfig(themeName);
const themeToken = resolveThemeToken(themeName);

// Only an explicitly assigned theme swaps the typeface. Without one the
// heading keeps the page's font, which is the previous behaviour.
const hasTheme = typeof rawTheme === "string" && rawTheme.trim() !== "";
const themeAttribute = hasTheme ? toThemeToken(themeName) : undefined;

const Tag = `h${level}` as any;

// Fluid handling rules using container queries (cqw) so text adapts to card size, not screen size
const fluidSizing = {
  1: "text-[clamp(1.5rem,12cqw,3rem)] leading-none",
  2: "text-[clamp(1.1rem,10cqw,2rem)] leading-tight",
  3: "text-xl leading-tight",
  4: "text-lg",
  5: "text-base",
  6: "text-sm",
};

const defaultFluidClass =
  fluidSizing[level as keyof typeof fluidSizing] || "text-lg";

// Outline class: thicker for h1, standard for others
const outlineClass = outline ? (level === 1 ? "outline-3" : "outline-2") : "";
---

<Tag
  class:list={[
    config.text.base,
    config.text.hover,
    "transition-colors font-bold break-normal whitespace-normal tracking-wide",
    defaultFluidClass,
    "theme-color",
    shadow && "readable-text",
    outlineClass,
    customClass,
  ]}
  data-theme={themeAttribute}
  style={`--project-tag-color: ${themeToken}`}
>
  <slot />
</Tag>
