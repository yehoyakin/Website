---
// Purpose: Component - src/components/shared/Link.astro (Retro link button)
import Icon from "./Icon.astro";
import { netIconForUrl } from "../../config/icons";
import { resolveThemeToken, toThemeName } from "../../config/uiDictionary";

interface Props {
  href: string;
  text?: string;
  external?: boolean;
  class?: string;
  style?: string;
  /** Icon name from the shared registry, e.g. "Handbag". */
  icon?: string;
  /** Theme name — picks the icon colour that matches the card/page. */
  theme?: string;
  /**
   * Take the themed tile — accent fill, white outline — when the host has no
   * theme of its own and paints the accent through `style` instead (the
   * landing's contacts panel). `theme` does the same thing by naming one.
   */
  tinted?: boolean;
}

const {
  href,
  text = "",
  external,
  class: extraClass = "",
  style,
  icon,
  theme,
  tinted,
} = Astro.props;

// Buttons with an icon pin it to the left edge so icons line up in a stack,
// even when the labels are different lengths. Text-only buttons stay centred.
// Outbound links use the brand glyph from the PixelNetIcons set (detected
// from the host); `icon` stays the fallback for everything else.
const resolvedIcon = netIconForUrl(href) ?? icon;

const alignment = resolvedIcon ? "justify-start" : "justify-center";

/* The button must take the host's contextual accent when placed in a themed
   card or panel, while still accepting an explicit theme override when a link
   is used outside that context. */
const themeName = theme ? toThemeName(theme) : undefined;
const themeToken = themeName ? resolveThemeToken(themeName) : undefined;
const hasExplicitThemeColor = style?.includes("--project-tag-color");
const inlineThemeStyle = [
  !hasExplicitThemeColor && themeToken
    ? `--project-tag-color: ${themeToken}; --project-tag-color-dark: var(--theme-${themeName}-dark);`
    : undefined,
  style,
].filter(Boolean).join("; ");

const classes = [
  "retro-link pixel-frame group relative overflow-hidden flex items-center gap-2",
  alignment,
  "rounded-none px-2.5 py-1 text-xs uppercase tracking-[0.12em] text-[color:var(--time-ink)]",
  "bg-transparent",
  "transition-all duration-100 ease-[var(--ease-press)]",
  extraClass,
]
  .filter(Boolean)
  .join(" ");
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class={classes}
  style={inlineThemeStyle}
  /* Marks a THEMED button: styles/chrome/pixelChrome/tintedButtons.css lights
     it in its own accent instead of the day / night tint, and paints the border
     and the type white over that tile. Unthemed buttons have no marker and keep
     following the mode. */
  data-link-theme={themeName || (tinted ? "tinted" : undefined)}
>
  {
    resolvedIcon && (
      <Icon
        name={resolvedIcon}
        theme={theme}
        /* A themed tile is filled with the theme's own colour, so a glyph in
           that same colour would disappear into it: the label is white over
           the tile, and the glyph keeps it company. */
        color={themeName || tinted ? "White" : undefined}
        class="relative z-10 h-5 w-5 shrink-0"
      />
    )
  }
  <span class="relative z-10">{text}</span>
  <span class="pixel-highlight"></span>
</a>
