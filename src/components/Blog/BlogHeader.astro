---
// Purpose: Component - src/components/Blog/BlogHeader.astro (Blog post header: title, date, description)
import Title from "../UI/Title.astro";
import Body from "../UI/Body.astro";
import Icon from "../shared/Icon.astro";
import { patternForTheme } from "../../config/patterns";

interface Props {
  title: string;
  description: string;
  date: Date;
  theme?: string;
}

const { title, description, date, theme = "orange" } = Astro.props as Props;

/* The title panel wears the post's pattern, the same scrolling tile the
   project and blog cards use (styles/components/pixelFrame.css). */
const panelStyle = `--plate-pattern: url('${patternForTheme(theme)}')`;
---

<header
  class="pixel-frame pattern-plate pattern-plate--big space-y-6 rounded-none border border-[color:var(--time-border-soft)] bg-[var(--time-panel)] p-8 sm:p-10 md:p-12 backdrop-blur-2xl shadow-[inset_0_0_80px_var(--time-shadow)] text-center relative overflow-hidden"
  style={panelStyle}
>
  <Title
    level={1}
    theme={theme}
    class="text-4xl sm:text-5xl md:text-6xl mx-auto tracking-tight font-bold readable-text"
  >
    {title}
  </Title>

  <Body
    theme={theme}
    class="mx-auto max-w-3xl text-[color:var(--time-ink-muted)] text-center text-sm sm:text-base readable-text"
  >
    {description}
  </Body>

  <time
    class="flex items-center justify-center gap-2 tracking-wider"
    datetime={date.toISOString()}
  >
    <Icon name="Calendar" theme={theme} class="h-10 w-10" />
    {date.toLocaleDateString()}
  </time>
</header>
