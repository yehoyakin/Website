---
// Purpose: Section - src/components/sections/ContactPanel.astro (Top-right contact quicklinks)
//
// A rail panel (shared/RailPanel.astro) filled with the site's contact links.
// It is the same control a blog post uses for its links: one component, one
// behaviour (scripts/railPanel.js), one stylesheet (chrome/sideRails.css).
import SocialLink from "../shared/Link.astro";
import RailPanel from "../shared/RailPanel.astro";
import { netIconPath } from "../../config/icons";
import { patternForTheme } from "../../config/patterns";

/* This panel is site chrome, not content, so it wears the MODE base colour
   rather than a theme: `--icon-accent` is the day base colour by day and the
   night one at night (base/timeColors.css), the same token the unthemed icons
   are drawn in. A fixed theme here painted the links purple in both modes and
   on every page it floated over. */

const links = [
  { href: "mailto:joaquinignacio.herrerabriones@email.com", text: "Email", external: false, icon: "email" },
  { href: "https://github.com/yehoyakin", text: "GitHub", external: true, icon: netIconPath("github") },
  { href: "https://gitlab.com/yehoyakin", text: "GitLab", external: true, icon: "internet" },
  { href: "https://www.linkedin.com/in/joaquín-herrera-366b2a175", text: "LinkedIn", external: true, icon: "internet" }
];
---

<RailPanel
  id="contacts"
  label="Toggle contact links"
  icon="contacts"
  /* Same texture recipe as the landing credits bar: the white motif, tinted by
     the mode base colour, so the panel follows day / night rather than a theme. */
  style={`--project-tag-color: var(--icon-accent); --plate-pattern: url('${patternForTheme("white")}')`}
  panelClass="bg-[var(--time-panel)] backdrop-blur-md p-6 border border-[color:var(--time-border-soft)] shadow-2xl w-64"
>
  <div class="space-y-3">
    {
      links.map((link) => (
        <SocialLink
          href={link.href}
          text={link.text}
          external={link.external}
          icon={link.icon}
        />
      ))
    }
  </div>
</RailPanel>
