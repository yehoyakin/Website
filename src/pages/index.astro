---
// Purpose: Page - src/pages/index.astro (Home / landing)
import MyLayout from "../layouts/MyLayout.astro";
import SplitLanding from "../components/sections/SplitLanding.astro";
import ContactPanel from "../components/sections/ContactPanel.astro";
import HeaderInfo from "../components/sections/InfoHeader.astro";
import PageBackdrop from "../components/shared/PageBackdrop.astro";
import { asset } from "../utils/asset";
---

<MyLayout title="Home">
  {/* Full-screen backdrop for the landing experience. */}
  <div
    id="landing-viewport"
    class="fixed inset-0 w-full h-screen overflow-y-auto md:overflow-hidden bg-[var(--time-page)]"
  >
    {/* Background image layer with a soft blur effect. */}
    <PageBackdrop
      day="images/pageBackgrounds/MainDay.gif"
      night="images/pageBackgrounds/MainNight.jpg"
    />

    {/* Split layout for the hero and supporting content. */}
    <div
      id="landing-content"
      class="relative z-20 flex flex-col h-auto md:h-screen md:max-h-screen w-full overflow-hidden min-h-screen pb-20 md:pb-0"
    >
      <header class="absolute top-0 right-0 px-8 py-6 z-50">
        <ContactPanel />
      </header>

      {
        /* HEADER SECTION: Max height limits keep it from drowning out the splits */
      }
      <div
        class="w-full md:max-h-[75vh] md:min-h-[50vh] flex items-center justify-center overflow-hidden p-2 pt-16 md:pt-2"
      >
        <HeaderInfo
          name="Joaquin Herrera"
          description="
           Game Dev: Unreal Engine C++ & Unity"
          portraitSrc={asset("images/frontPage/mypixelart.webp")}
          theme="purple"
        />
      </div>

      {
        /* SPLIT CONTENT: Takes up the entire remaining vertical viewport portion */
      }
      <div
        class="w-full flex-1 md:flex-1 flex items-center justify-center overflow-hidden px-2 pb-2 md:p-2"
      >
        <SplitLanding
          left={{
            href: `${import.meta.env.BASE_URL}portfolio/`,
            tag: "My projects",
            title: "Portfolio",
            description: "Take a look at my Unity and Unreal Engine projects.",
            actionText: "View projects",
            theme: "orange",
            imageSrc: asset("images/pageBackgrounds/PortfolioDay.gif"),
            imageSrcNight: asset("images/pageBackgrounds/PortfolioNight.gif"),
          }}
          right={{
            href: `${import.meta.env.BASE_URL}blog/`,
            tag: "My thoughts",
            title: "Blog",
            description:
              "Just my thoughts on videogames, game development and movies.",
            actionText: "Read articles",
            theme: "lightgreen",
            imageSrc: asset("images/pageBackgrounds/BlogDay.gif"),
            imageSrcNight: asset("images/pageBackgrounds/BlogNight.gif"),
          }}
          credits={[
            {
              href: "https://www.deviantart.com/kirokaze/gallery",
              text: "Pixel-art by Kirokaze",
            },
            { href: "https://yukipixels.itch.io", text: "Font by Yukipixels" },
            {
              href: "https://kenney-assets.itch.io",
              text: "Patterns by Kenney",
            },
          ]}
        />
      </div>
    </div>
  </div>
</MyLayout>
