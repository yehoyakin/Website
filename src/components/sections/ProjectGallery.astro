---
import { asset } from "../../utils/asset";
import { resolveThemeToken, toThemeName } from "../../config/uiDictionary";
import { patternForTheme } from "../../config/patterns";
import Title from "../UI/Title.astro";
import Body from "../UI/Body.astro";

interface Props {
  projects: {
    id: string;
    data: any;
  }[];
}

const { projects } = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<div id="project-gallery" class="project-gallery">
  <div
    class="gallery-thumbnails-wrapper"
    data-carousel
    data-carousel-item=".gallery-project-item"
    data-carousel-label="Projects"
  >
    <div class="gallery-thumbnails" data-carousel-track>
      {
        projects.map((project, index) => {
          const themeName = toThemeName(project.data.theme);
          const themeToken = resolveThemeToken(themeName);
          const projectHref = `${baseUrl}portfolio/${project.id}/`;

          const hasDescription = Boolean(
            project.data.description && project.data.description.trim().length > 0,
          );

          return (
            <div class="gallery-project-item">
              <a
                href={projectHref}
                class="gallery-thumb blog-card pixel-frame group"
                aria-label={`Open project ${project.data.title ?? index + 1}`}
                title={project.data.title}
                style={`--thumb-theme-color: ${themeToken}; --project-tag-color: ${themeToken}; --project-tag-color-dark: var(--theme-${themeName}-dark); --plate-pattern: url('${patternForTheme(themeName)}')`}
              >
                <div class="blog-card-bar pattern-plate pattern-plate--small flex items-center gap-2">
                  <Body theme={themeName} class="blog-card-date text-xs sm:text-sm">
                    {project.data.tag}
                  </Body>
                </div>

                <div class="blog-card-image-wrap">
                  <div class="thumb-carousel">
                    <img
                      src={asset(project.data.cardBackground)}
                      alt={project.data.title ?? `Project ${index + 1}`}
                      class="thumb-carousel-media thumb-carousel-img active"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="thumb-overlay" />
                </div>

                {hasDescription && (
                  <div class="blog-card-bar blog-card-info-bar pattern-plate pattern-plate--small">
                    <Title level={3} theme={themeName} class="blog-card-title">
                      {project.data.title}
                    </Title>

                    <Body
                      theme={themeName}
                      class="blog-card-desc mt-2 text-sm sm:text-base text-[color:var(--time-ink-muted)] group-hover:text-[color:var(--time-ink)] readable-text"
                    >
                      {project.data.description}
                    </Body>
                  </div>
                )}
              </a>
            </div>
          );
        })
      }
    </div>
  </div>
</div>

<script>
  import { initCardCarousels } from "../../scripts/cardCarousel.js";

  /* The strip is server-rendered above; build its controls on load. The module
     registers its own `astro:page-load` listener, so client-side navigations
     back to the listing rebuild them too. */
  initCardCarousels();
</script>
