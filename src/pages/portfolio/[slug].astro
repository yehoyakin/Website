---
import MyLayout from "../../layouts/MyLayout.astro";
import BackLink from "../../components/shared/BackLink.astro";
import Title from "../../components/UI/Title.astro";
import Body from "../../components/UI/Body.astro";
import CompactBody from "../../components/UI/CompactBody.astro";
import Link from "../../components/shared/Link.astro";
import Icon from "../../components/shared/Icon.astro";
import PageBackdrop from "../../components/shared/PageBackdrop.astro";

import { getCollection } from "astro:content";
import { asset } from "../../utils/asset";
import { isExternalUrl, videoEmbedUrl } from "../../utils/video";
import { resolveThemeToken, toThemeName } from "../../config/uiDictionary";
import { patternForTheme } from "../../config/patterns";
import { defaultIconColor, defaultIconColorNight, iconColorForTheme } from "../../config/icons";
import "../../styles/portfolio/galleryThumbnailSlide.css";
import "../../styles/carousel/carouselLayout.css";

type ProjectRole =
  | "lead_programmer"
  | "ui"
  | "game_design"
  | "art"
  | "audio"
  | "tech_art"
  | "systems"
  | "tools"
  | "developer";

const roleLabels: Record<ProjectRole, string> = {
  lead_programmer: "Lead Programmer",
  ui: "UI",
  game_design: "Game Design",
  art: "Art",
  audio: "Audio",
  tech_art: "Tech Art",
  systems: "Systems",
  tools: "Tools",
  developer: "Developer",
};

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { slug: project.id },
  }));
}

const slug = Astro.params.slug;
const projects = await getCollection("projects");
const project = projects.find((entry) => entry.id === slug);

if (!project) {
  throw new Response("Project not found", { status: 404 });
}

const themeName = toThemeName(project.data.theme);
const themeToken = resolveThemeToken(themeName);
const galleryThemeIconColor = iconColorForTheme(themeName);
const galleryStyle = `--thumb-theme-color: ${themeToken}; --project-tag-color: ${themeToken}; --project-tag-color-dark: var(--theme-${themeName}-dark); --plate-pattern: url('${patternForTheme(themeName)}')`;

const projectScenes = (project.data.scenes ?? []).map((scene) => ({
  image: asset(scene.image),
  caption: scene.caption ?? "",
}));
const scenes = projectScenes.map((s) => s.image);
const videos = project.data.videos ?? [];
const projectLinks = project.data.links ?? [];

/**
 * Clean up a caption string: strip quotes (straight or curly), HTML entities, trim.
 */
function cleanCaption(raw: string): string {
  return raw
    .replace(/^[\s,]*/, "")
    .replace(/&quot;/g, '"')
    .replace(/&ldquo;/g, '"')
    .replace(/&rdquo;/g, '"')
    .replace(/&apos;/g, "'")
    .replace(/&lsquo;/g, "'")
    .replace(/&rsquo;/g, "'")
    .replace(/&amp;/g, "&")
    .replace(/^["""\u201c\u201d]/, "")
    .replace(/["""\u201c\u201d]$/, "")
    .replace(/^['''\u2018\u2019]/, "")
    .replace(/['''\u2018\u2019]$/, "")
    .trim();
}

/**
 * Extract captions from [scene[N], "caption"] markers in the raw Markdown body
 * so gallery thumbnails can display them, then remove the markers from the body
 * so images only appear in the right-side gallery.
 */
const markdownBody = project.body ?? "";
const SCENE_MARKER_RE = /\[scene\[([0-9,\s]+)(?:,\s*(wide|large|full))?\](?:,\s*([^\]]*))?\]/g;
const GALLERY_VIDEO_MARKER_RE = /\[gallery:video\[(\d+)\](?:,\s*([^\]]*))?\]/g;

const bodySceneCaptions = {};
const bodyGalleryVideoCaptions = {};
const bodyCaptionRe = /\[scene\[([0-9,\s]+)(?:,\s*(wide|large|full))?\](?:,\s*([^\]]*))?\]/g;
let captionMatch;
let sceneMarkerCount = 0;
while ((captionMatch = bodyCaptionRe.exec(markdownBody)) !== null) {
  sceneMarkerCount++;
  const [, rawIndexes = "", , rawCaption = ""] = captionMatch;
  const caption = cleanCaption(rawCaption);
  if (caption) {
    rawIndexes.split(",")
      .map((v) => Number.parseInt(v.trim(), 10))
      .filter((v) => Number.isInteger(v) && v >= 0)
      .forEach((idx) => { bodySceneCaptions[idx] = caption; });
  }
}

/* Parse [gallery:video[N]] and [gallery:video[N], "caption"] markers so we can
   strip them from the body HTML and use their inline captions for gallery items. */
const galleryVideoRe = /\[gallery:video\[(\d+)\](?:,\s*([^\]]*))?\]/g;
let galleryVideoMatch;
let galleryVideoMarkerCount = 0;
while ((galleryVideoMatch = galleryVideoRe.exec(markdownBody)) !== null) {
  galleryVideoMarkerCount++;
  const index = Number.parseInt(galleryVideoMatch[1], 10);
  const rawCaption = galleryVideoMatch[2];
  const caption = cleanCaption(rawCaption);
  if (caption) {
    bodyGalleryVideoCaptions[index] = caption;
  }
}

// Only show gallery if there are scene markers, gallery video markers, or videos in frontmatter
const hasGalleryContent = sceneMarkerCount > 0 || galleryVideoMarkerCount > 0 || videos.length > 0;

// Remove scene and gallery:video markers from the body HTML so they only appear in the gallery
let processedHtml = (project.rendered?.html ?? "").replace(SCENE_MARKER_RE, "").replace(GALLERY_VIDEO_MARKER_RE, "");

// Wrap ##### (h5) heading sections in <div class="retro-contribution">
// This allows markdown files to use "##### Contribution" instead of explicit div wrappers
processedHtml = processedHtml.replace(/<h5>(.*?)<\/h5>(.*?)(?=<h[1-6]>|<div|<p|<ul|<ol|<blockquote|<pre|<figure|$)/gs, (match, headingText, bodyContent) => {
  // Trim trailing whitespace from body content
  const trimmedBody = bodyContent.replace(/\s*$/, '');
  if (trimmedBody) {
    return `<div class="retro-contribution"><h5>${headingText}</h5>${trimmedBody}</div>`;
  }
  return `<div class="retro-contribution"><h5>${headingText}</h5></div>`;
});

const bodyHtml = processedHtml;

const mediaItems = [
  ...projectScenes.map((s, i) => ({ kind: "image" as const, src: s.image, alt: bodySceneCaptions[i] || s.caption || `${project.data.title} screenshot ${i + 1}` })),
  ...videos.map((video, i) => {
    const embed = videoEmbedUrl(video.src, video.type);
    const caption = bodyGalleryVideoCaptions[i] || bodySceneCaptions[i] || video.title;

    if (embed) {
      return {
        kind: "embed" as const,
        src: embed,
        title: caption ?? `${project.data.title} video`,
      };
    }

    return {
      kind: "file" as const,
      src: isExternalUrl(video.src) ? video.src : asset(video.src),
      poster: video.poster ? asset(video.poster) : undefined,
      title: caption,
    };
  }),
];

/* The page backdrop is the project's OWN artwork. It used to fall back to
   `cardBackground`, which meant a project that never set a backdrop showed its
   card art blown up behind the page; `background` is required in the schema
   now, so the two images can never stand in for each other. */
const backgroundImage = asset(project.data.background);
/* Preload only what this page actually paints: the backdrop and the gallery.
   The card cover is not shown on a slug, so it is no longer in this list. */
const preloadImages = [
  backgroundImage,
  ...scenes,
  ...videos
    .filter((video) => !isExternalUrl(video.src))
    .map((video) => asset(video.src)),
  ...videos
    .map((video) => video.poster)
    .filter(Boolean)
    .map((poster) => asset(poster as string)),
];

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<MyLayout title={`${project.data.title} | Portfolio`} preloadImages={preloadImages}>
  <div class="relative w-full min-h-screen bg-[var(--time-page)]">
    <PageBackdrop
      day={project.data.background}
      night={project.data.background}
    />

    <div class="absolute inset-0 z-10 pointer-events-none"></div>

    <div
      class="project-page pattern-plate pattern-plate--medium pattern-plate--ghost relative z-20 mx-auto w-full px-4 sm:px-6 md:px-8"
      style={`--project-tag-color: ${themeToken}; --project-tag-color-dark: var(--theme-${themeName}-dark); --plate-pattern: url('${patternForTheme(themeName)}')`}
    >
      <BackLink href={`${baseUrl}portfolio/`} text="Back to portfolio" />

      <section class="project-page-shell pt-20 pb-8 md:pt-24 md:pb-12">
        <header class="project-page-header project-page-masthead pixel-frame pattern-plate pattern-plate--medium">
          <p class="project-page-tag">{project.data.tag}</p>
          <Title level={1} theme={themeName} class="project-page-title">
            {project.data.title}
          </Title>

          <Body theme={themeName} class="project-page-description">
            {project.data.description}
          </Body>

          <div class="project-page-roles">
            {(project.data.roles ?? []).map((role) => (
              <span class="project-role">{roleLabels[role as ProjectRole] ?? role}</span>
            ))}
          </div>
        </header>

        <div class="project-page-lower-grid">
          <section class="project-page-left-stack">
            <section class="project-page-links-panel pixel-frame pattern-plate pattern-plate--small">
              <div class="project-page-links">
                {projectLinks.map((link, index) => (
                  <Link
                    href={link.href}
                    text={link.text?.trim() || `Project link ${index + 1}`}
                    external={true}
                    theme={themeName}
                  />
                ))}
              </div>
            </section>

            <CompactBody
              theme={themeName}
              class="project-page-content-panel blog-article-body pattern-plate pattern-plate--text-backdrop pattern-plate--huge"
            >
              <div id="blog-content" set:html={bodyHtml} />
            </CompactBody>
          </section>

          {
            hasGalleryContent && (
              <section class="project-page-gallery-plain" aria-label="Project media">
                <div class="project-gallery markdown-gallery" data-gallery-ready="false" data-icon-color={galleryThemeIconColor} data-site-base-url={baseUrl}>
                  <div class="gallery-thumbnails-wrapper" data-carousel data-carousel-item=".gallery-project-item" data-carousel-label="Gallery" data-icon-color={galleryThemeIconColor}>
                    <div class="gallery-thumbnails" data-carousel-track>
                      {mediaItems.map((item, index) => {
                        const titleText = item.kind === "image" ? (item.alt ?? `${project.data.title} screenshot ${index + 1}`) : (item.title ?? `Media ${index + 1}`);
                        const hasTitleText = Boolean(titleText && titleText.length > 0);

                        return (
                          <div class="gallery-project-item">
                            <button
                              class="gallery-thumb blog-card pixel-frame blog-inner-image-card"
                              aria-label={hasTitleText ? `View ${titleText}` : `View media ${index + 1}`}
                              title={titleText || undefined}
                              data-thumb-index={0}
                              data-lightbox-index={index}
                              data-lightbox-src={item.src}
                              data-lightbox-kind={item.kind}
                              data-lightbox-alt={titleText}
                              data-lightbox-poster={item.kind === "file" ? (item.poster || "") : ""}
                              style={galleryStyle}
                            >
                              <div class="blog-card-image-wrap">
                                <div class="thumb-carousel">
                                  {item.kind === "image" && (
                                    <img
                                      src={item.src}
                                      alt={titleText || `Image ${index + 1}`}
                                      class="thumb-carousel-media thumb-carousel-img active"
                                      loading="lazy"
                                      decoding="async"
                                    />
                                  )}
                                  {item.kind === "embed" && (
                                    <iframe
                                      src={item.src}
                                      title={item.title || `Embed ${index + 1}`}
                                      class="thumb-carousel-media thumb-carousel-frame active"
                                      loading="lazy"
                                      allowfullscreen
                                    />
                                  )}
                                  {item.kind === "file" && (
                                    <video
                                      src={item.src}
                                      poster={item.poster}
                                      class="thumb-carousel-media thumb-carousel-video active"
                                      controls
                                      playsinline
                                      preload="metadata"
                                    />
                                  )}
                                </div>
                                <div class="thumb-overlay" />
                              </div>
                              {hasTitleText && (
                                <div class="blog-card-bar blog-card-info-bar pattern-plate pattern-plate--small">
                                  <span class="gallery-thumb-desc">{titleText}</span>
                                </div>
                              )}
                            </button>
                          </div>
                        );
                      })}
                    </div>
                  </div>

                  <div class="gallery-panels-container">
                {/* THE SAME OVERLAY A POST'S GALLERY OPENS.

                    One panel per page, holding only this project's media: the
                    list is read from the thumbnails, at the moment a thumb is
                    clicked, so it can never show another gallery's picture.
                    The stage is filled in by the script — an image, a
                    <video> or an embed — because this gallery contains all three. */}
                <div
                  class="blog-gallery-lightbox"
                  aria-hidden="true"
                  data-gallery-lightbox
                  style={galleryStyle}
                >
                  <div class="blog-gallery-lightbox__backdrop" data-lightbox-close></div>
                  <button type="button" class="blog-gallery-lightbox__close icon-button" aria-label="Close media preview" data-lightbox-close>
                    <Icon name="close" theme={themeName} class="blog-gallery-lightbox__close-icon" />
                  </button>
                  <button type="button" class="blog-gallery-lightbox__nav blog-gallery-lightbox__nav--prev icon-button" aria-label="Previous media" data-lightbox-prev>
                    <Icon name="arrow-left" theme={themeName} class="card-carousel-arrow-icon" />
                  </button>
                  <button type="button" class="blog-gallery-lightbox__nav blog-gallery-lightbox__nav--next icon-button" aria-label="Next media" data-lightbox-next>
                    <Icon name="arrow-right" theme={themeName} class="card-carousel-arrow-icon" />
                  </button>
                  <div class="blog-gallery-lightbox__panel pattern-plate pattern-plate--medium" role="dialog" aria-modal="true" aria-label="Media preview" style={galleryStyle}>
                    <div class="blog-gallery-lightbox__media">
                      <div class="blog-gallery-lightbox__stage" data-lightbox-stage />
                    </div>
                    <div class="blog-gallery-lightbox__meta">
                      <div class="blog-gallery-lightbox__dots card-carousel-dots" aria-label="Media index"></div>
                      <span class="blog-gallery-lightbox__caption" data-lightbox-caption hidden />
                    </div>
                  </div>
                </div>
                  </div>
                </div>
              </section>
            )
          }
        </div>
      </section>
    </div>
  </div>
</MyLayout>

<script is:inline>
  (async function () {
    const { initGalleryEqualHeight } = await import("../../scripts/galleryEqualHeight.js");
    const { initCardCarousels } = await import("../../scripts/cardCarousel.js");
    const initMarkdownGalleries = () => {
      const galleries = document.querySelectorAll(".project-gallery[data-gallery-ready='false']");
      if (!galleries.length) return;

      galleries.forEach((gallery) => {
        gallery.dataset.galleryReady = "true";

        const thumbs = [...gallery.querySelectorAll(".gallery-thumb[data-lightbox-index]")];
        const lightbox = gallery.querySelector("[data-gallery-lightbox]");
        if (!lightbox || !thumbs.length) return;

        const stage = lightbox.querySelector("[data-lightbox-stage]");
        const captionEl = lightbox.querySelector("[data-lightbox-caption]");
        const dotsWrap = lightbox.querySelector(".blog-gallery-lightbox__dots");
        const closeButtons = lightbox.querySelectorAll("[data-lightbox-close]");
        const prevBtn = lightbox.querySelector("[data-lightbox-prev]");
        const nextBtn = lightbox.querySelector("[data-lightbox-next]");

        const themedColor = gallery.dataset.iconColor || document.documentElement.dataset.iconDay || "Lightblue";
        const baseUrl = gallery.dataset.siteBaseUrl || "/";

        const makeDot = (index) => {
          const dot = document.createElement("button");
          dot.type = "button";
          dot.className = "card-carousel-dot";
          dot.setAttribute("aria-label", `View media ${index + 1}`);

          const pair = document.createElement("span");
          pair.className = "card-carousel-dot-icon icon-mode";

          ["day", "night"].forEach((mode) => {
            const icon = document.createElement("img");
            icon.src = `${baseUrl}images/Icons/${themedColor}/Circle Base_${themedColor}.webp`;
            icon.alt = "";
            icon.setAttribute("aria-hidden", "true");
            icon.decoding = "async";
            icon.className = `icon-mode-img icon-mode-img--${mode}`;
            pair.appendChild(icon);
          });

          dot.appendChild(pair);
          dot.addEventListener("click", () => openLightbox(index));
          return dot;
        };

        let items = [];
        let dotButtons = [];
        let currentIndex = 0;

        /* Build a media list from the thumbnails in this gallery. Each thumb
           carries data-lightbox-kind ("image", "file", or "embed") so the
           lightbox stage can render the correct element type. */
        const itemsFor = (thumb) => {
          const owner = thumb?.closest(".project-gallery") || gallery;

          return [...owner.querySelectorAll(".gallery-thumb[data-lightbox-index]")].map((node) => ({
            kind: node.dataset.lightboxKind || "image",
            src: node.dataset.lightboxSrc,
            poster: node.dataset.lightboxPoster || "",
            alt: node.dataset.lightboxAlt || node.getAttribute("aria-label") || "Media preview",
          }));
        };

        /* Render one media item into the lightbox stage. Mirrors the blog
           gallery's render() so videos and embeds work identically. */
        const render = (index) => {
          const item = items[index];
          if (!item || !stage) return;

          let node;

          if (item.kind === "embed") {
            node = document.createElement("iframe");
            node.src = item.src;
            node.title = item.alt || "Media";
            node.referrerPolicy = "strict-origin-when-cross-origin";
            node.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
            node.setAttribute("allowfullscreen", "");
          } else if (item.kind === "file") {
            node = document.createElement("video");
            node.src = item.src;
            if (item.poster) node.poster = item.poster;
            node.controls = true;
            node.playsInline = true;
            node.preload = "metadata";
          } else {
            node = document.createElement("img");
            node.src = item.src;
            node.alt = item.alt;
            node.loading = "eager";
            node.decoding = "async";
          }

          node.className = "blog-gallery-lightbox__image";
          stage.replaceChildren(node);

          if (captionEl) {
            captionEl.textContent = item.alt;
            captionEl.hidden = !item.alt;
          }

          dotButtons.forEach((dot, dotIndex) => {
            dot.setAttribute("aria-current", dotIndex === index ? "true" : "false");
          });
        };

        const updateLightbox = (index) => {
          if (!items.length) return;

          const normalizedIndex = ((index % items.length) + items.length) % items.length;
          currentIndex = normalizedIndex;
          render(currentIndex);
        };

        /* One panel on screen at a time: a gallery opened while another panel is
           still up would otherwise show through behind it. */
        const closeOtherLightboxes = () => {
          document.querySelectorAll(".blog-gallery-lightbox.is-open").forEach((other) => {
            if (other === lightbox) return;
            other.classList.remove("is-open");
            other.setAttribute("aria-hidden", "true");
          });
        };

        const openLightbox = (index, thumb) => {
          items = itemsFor(thumb);
          dotButtons = items.map((_item, dotIndex) => makeDot(dotIndex));
          if (dotsWrap) {
            dotsWrap.replaceChildren(...dotButtons);
          }

          closeOtherLightboxes();
          lightbox.classList.add("is-open");
          lightbox.setAttribute("aria-hidden", "false");
          document.body.classList.add("lightbox-open");
          updateLightbox(index);
        };

        const closeLightbox = () => {
          lightbox.classList.remove("is-open");
          lightbox.setAttribute("aria-hidden", "true");

          /* Unmount the stage to stop any playing video or embed. */
          stage?.replaceChildren();

          if (!document.querySelector(".blog-gallery-lightbox.is-open")) {
            document.body.classList.remove("lightbox-open");
          }
        };

        /* The thumbnail's own index inside its strip is what opens it, so the
           number of galleries above it on the page cannot shift the picture. */
        thumbs.forEach((thumb) => {
          thumb.addEventListener("click", (event) => {
            event.preventDefault();
            openLightbox(Number(thumb.dataset.lightboxIndex) || 0, thumb);
          });
        });

        closeButtons.forEach((button) => {
          button.addEventListener("click", closeLightbox);
        });

        prevBtn?.addEventListener("click", () => openLightbox(currentIndex - 1));
        nextBtn?.addEventListener("click", () => openLightbox(currentIndex + 1));

        lightbox.addEventListener("click", (event) => {
          if (event.target === lightbox || event.target.closest("[data-lightbox-close]")) {
            closeLightbox();
          }
        });

        document.addEventListener("keydown", (event) => {
          if (!lightbox.classList.contains("is-open")) return;

          if (event.key === "Escape") closeLightbox();
          if (event.key === "ArrowRight") openLightbox(currentIndex + 1);
          if (event.key === "ArrowLeft") openLightbox(currentIndex - 1);
        });
      });
    };

    document.addEventListener("astro:page-load", () => {
      initMarkdownGalleries();
      initCardCarousels();
      initGalleryEqualHeight();
    });
    document.addEventListener("DOMContentLoaded", () => {
      initMarkdownGalleries();
      initCardCarousels();
      initGalleryEqualHeight();
    });
    initMarkdownGalleries();
    initCardCarousels();
    initGalleryEqualHeight();
  })();
</script>

<style>
  .project-page-shell {
    max-width: 64rem;
    margin-inline: auto;
  }

  .project-page-header {
    padding: clamp(0.9rem, 1.8vw, 1.5rem);
    margin-bottom: 0.9rem;
  }

  .project-page-masthead {
    padding: clamp(1rem, 2vw, 1.6rem);
    margin-bottom: 0.9rem;
    max-width: 64rem;
    margin-inline: auto;
  }

  .project-page-tag {
    margin: 0;
    color: var(--project-tag-color, var(--theme-orange));
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: clamp(0.72rem, 1vw, 0.9rem);
    text-shadow: 1px 2px 0 var(--time-shadow);
  }

  :global(.project-page-title) {
    margin-top: 0.3rem;
    font-size: clamp(1.35rem, 2.6vw, 2.35rem) !important;
    line-height: 1.06;
  }

  .project-page-description {
    margin-top: 0.45rem;
    max-width: 62rem;
  }

  .project-page-roles {
    margin-top: 0.65rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .project-page-lower-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: 0.9rem;
    align-items: start;
    max-width: 64rem;
    margin-inline: auto;
  }

  .project-page-left-stack {
    display: grid;
    gap: 0.65rem;
    align-items: start;
  }

  .project-page-panel-label,
  .project-page-aside-label {
    margin: 0;
    font-size: clamp(0.66rem, 0.9vw, 0.8rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--project-tag-color, var(--theme-orange));
    text-shadow: 1px 2px 0 var(--time-shadow);
  }

  .project-page-links-panel {
    /* The links panel is a plate, and a plate draws its motif with absolutely
       positioned layers at `inset: 0` while leaving `position` to its host.
       Without this they anchored to `.project-page`, so the links texture was
       sized to the page instead of the panel and spilled out of it. */
    position: relative;
    padding: 1rem;
  }

  .project-page-links {
    margin-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }

  .project-page-links :global(.retro-link) {
    min-height: 2rem;
    font-size: clamp(0.7rem, 0.9vw, 0.86rem);
    letter-spacing: 0.09em;
    justify-content: flex-start;
  }

  :global(.project-page-content-panel) {
    /* A plate's motif is drawn by its `::before` / `::after`, which are
       absolutely positioned at `inset: 0` — `.pattern-plate` deliberately
       leaves `position` to its host. This panel had none, so those two layers
       anchored to the nearest positioned ancestor, `.project-page`, and the
       write-up's texture painted the WHOLE page (the pattern showing between
       the panels). Relative here keeps the texture inside the panel's box. */
    position: relative;
    padding: 1rem;
    --plate-pattern-size: max(1600px, calc(var(--pattern-size-huge, 1024px) * 1.5));
    --plate-pattern-opacity: 0.09;
    max-width: none;
    --frame-bevel: none;
    border: none !important;
    border-image: none !important;
    outline: none !important;
