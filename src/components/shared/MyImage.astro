---
// Purpose: Component - src/components/shared/MyImage.astro (Responsive image wrapper)
import { Image } from "astro:assets";

interface Props {
  src: any;
  /** Optional night-time artwork. When given, the two cross-fade by mode. */
  srcNight?: string;
  alt?: string;
  size?: "sm" | "md" | "lg" | "xl";
  /** Wrap the image in the pixel-tile chrome used by the icon buttons. */
  frame?: boolean;
}

const {
  src,
  srcNight,
  alt = "Portrait",
  size = "md",
  frame = false,
} = Astro.props;

/* Corners are square across the site, so the frame is always squared off. */
const baseClasses =
  "relative overflow-hidden bg-[var(--time-page)] isolate box-border rounded-none";

const sizeMap = {
  sm: "w-32 h-32 md:w-40 md:h-40",
  md: "w-56 h-56 md:w-72 md:h-72",
  lg: "w-72 h-72 md:w-96 md:h-96",
  xl: "w-full h-full absolute inset-0",
};

/* Critical: forces width/height over the image and resets the inline
   aspect-ratio Astro's asset optimization adds. */
const imgClasses =
  "absolute inset-0 !w-full !h-full !max-w-none !max-h-none block !object-cover select-none pointer-events-none";

/* Day / night pair: both images are rendered and exactly one is visible, driven
   by `data-mode` on <html> (rules in styles/base/layout.css). Only applied when
   a night source is supplied, so plain images keep a single element. */
const modeClasses = (which: "day" | "night") =>
  srcNight ? `mode-img mode-img--${which}` : "";
---

<div
  class:list={[
    baseClasses,
    sizeMap[size],
    frame && "pixel-frame portrait-frame",
  ]}
>
  {
    typeof src === "string" ? (
      <img src={src} alt={alt} class={`${imgClasses} ${modeClasses("day")}`} />
    ) : (
      <Image
        src={src}
        alt={alt}
        class={`${imgClasses} ${modeClasses("day")}`}
      />
    )
  }

  {
    srcNight && (
      <img
        src={srcNight}
        alt=""
        aria-hidden="true"
        class={`${imgClasses} ${modeClasses("night")}`}
      />
    )
  }
</div>
