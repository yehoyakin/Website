---
// Purpose: Page - src/pages/portfolio.astro (Portfolio listing)
// See: file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/site/listingMasthead.css, file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/portfolio/galleryThumbnailSlide.css, file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/styles/blogCard/blogCardTile.css
import MyLayout from "../layouts/MyLayout.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/layouts/MyLayout.astro
import Title from "../components/UI/Title.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/UI/Title.astro
import Body from "../components/UI/Body.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/UI/Body.astro
import BackLink from "../components/shared/BackLink.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/shared/BackLink.astro
import ProjectGallery from "../components/sections/ProjectGallery.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/sections/ProjectGallery.astro
import PageBackdrop from "../components/shared/PageBackdrop.astro";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/components/shared/PageBackdrop.astro

import { getCollection } from "astro:content";
import { asset } from "../utils/asset";  // file:///C:/Users/UsuarioCompuElite/Documents/ForkRepositories/Website/src/utils/asset.ts

const rawProjects = await getCollection("projects");

const projects = await Promise.all(
  rawProjects.map(async (project) => ({
    ...project,
    rendered: project.rendered?.html ?? "",
  })),
);

const bgDay = asset("images/pageBackgrounds/PortfolioDay.webp");
const bgNight = asset("images/pageBackgrounds/PortfolioNight.webp");

const cardPreviews = projects.map((p) => asset(p.data.cardBackground)).filter(Boolean);

const imagesToPreload = [bgDay, bgNight, ...cardPreviews];
---

<MyLayout title="Portfolio | JoacoDev" preloadImages={imagesToPreload}>
  {/* `relative` (not `absolute inset-0`): the page box has to grow with the content so the project band below can run to its real bottom edge. No `overflow-x-hidden` here either — the band is wider than this box so it can reach past the layout gutter to the viewport edges; `main` above already clips that overflow. */}
  <div
    class="relative w-full min-h-screen bg-[var(--time-page)]"
  >
    <PageBackdrop
      day="images/pageBackgrounds/PortfolioDay.webp"
      night="images/pageBackgrounds/PortfolioNight.webp"
    />

    <div class="absolute inset-0 z-10 pointer-events-none"></div>

    <div class="listing-shell relative z-20 px-4 sm:px-6 md:px-8 w-full">
      <BackLink />

      <section class="mt-2 md:mt-4 w-full text-center">
        <Title class="mt-2 text-4xl md:text-6xl" level={1} theme="orange">
          Portfolio
        </Title>

        <Body theme="purple" class="mt-2 max-w-2xl mx-auto" shadow={true}>
          Browse through my projects. Click on the cards for more details!
        </Body>

        <div class="listing-gap">
          <ProjectGallery projects={projects} />
        </div>
      </section>
    </div>
  </div>
</MyLayout>
