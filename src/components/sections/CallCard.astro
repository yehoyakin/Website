---
// Purpose: Section - src/components/sections/CallCard.astro (Expandable project call card)
import Title from "../UI/Title.astro";
import Body from "../UI/Body.astro";
import {
  resolveThemeToken,
  toThemeName,
  toThemeToken,
} from "../../config/uiDictionary";
import type { ProjectRole } from "../../config/uiDictionary";

interface Props {
  tag: string;
  title: string;
  shortDescription: string;
  fullDescription?: string;
  roles?: ProjectRole[];
  /** Theme name — any string works. Controls font, color, and transition. */
  theme?: string;
  class?: string;
  backgroundImage?: string;
}

const roleLabels: Record<ProjectRole, string> = {
  lead_programmer: "Lead Programmer",
  ui: "UI",
  game_design: "Game Design",
  art: "Art",
  audio: "Audio",
  tech_art: "Tech Art",
  systems: "Systems",
  tools: "Tools",
  developer: "Developer",
};

const {
  tag,
  title,
  shortDescription,
  fullDescription = "",
  roles = [],
  theme: rawTheme = "primary",
  class: extraClass = "",
  backgroundImage,
} = Astro.props;

const themeName = toThemeName(rawTheme);
const dynamicToken = resolveThemeToken(themeName);

// The card's own theme token: makes fonts.css resolve this project's font set
// for the whole card (title, body, role chips, expanded prose).

// Use the per-card CSS variable so the color follows `--project-tag-color`.
const themeColorClass = "text-[color:var(--project-tag-color)]";

// Only the values that change per card are written inline; every other
// custom property the card needs is declared in styles/components/callCard.css.
const cardVars = [
  `--project-tag-color: ${dynamicToken}`,
  backgroundImage ? `--card-bg-url: url('${backgroundImage}')` : "",
]
  .filter(Boolean)
  .join("; ");

const baseText =
  "transition-colors duration-150 ease-[steps(200)] drop-shadow-[0_0.125rem_0.25rem_rgba(0,0,0,1)] readable-text";

const cardClasses = [
  "group retro-expandable-card relative rounded-none border",
  "w-full overflow-hidden select-none",
  extraClass,
].join(" ");
---

<div
  class={cardClasses}
  data-theme={toThemeToken(themeName)}
  data-active="false"
  style={cardVars}
>
  {
    backgroundImage && (
      <div class="callcard-bg" aria-hidden="true">
        <div class="callcard-bg-inner">
          <img src={backgroundImage} alt="" class="callcard-bg-img" />
        </div>
        <div class="callcard-overlay" />
      </div>
    )
  }
  <div class="card-main-layout">
    <!-- LEFT INFORMATION AREA (text + expanded content) -->

    <div class="card-info-panel">
      {
        backgroundImage && (
          <div class="info-panel-bg" aria-hidden="true">
            <img src={backgroundImage} alt="" class="info-panel-bg-img" />
          </div>
        )
      }
      <div class="card-title-area">
        {
          tag && (
            <span class={`card-tag ${baseText} ${themeColorClass}`}>{tag}</span>
          )
        }

        <Title
          theme={themeName}
          class={`card-project-title text-white ${baseText}`}
        >
          {title}
        </Title>

        {
          roles.length > 0 && (
            <div class="project-role-list">
              {roles.map((role) => (
                <span class="project-role">{roleLabels[role]}</span>
              ))}
            </div>
          )
        }

        <Body theme={themeName} class={`card-description ${baseText}`}>
          {shortDescription}
        </Body>
      </div>

      <div class="card-footer">
        <div class="card-links">
          <slot name="links" />
        </div>

        <div class={`project-description-hint ${baseText} ${themeColorClass}`}>
        </div>
      </div>

      <!-- EXPANDED CONTENT — lives inside the left column -->
      <div class="card-expanded-content">
        {
          fullDescription && (
            <div class="project-preview">
              <div class="project-description-preview">
                <div
                  class="prose prose-invert max-w-none text-sm sm:text-base text-zinc-300 drop-shadow-[0_1px_3px_rgba(0,0,0,1)] theme-color readable-text"
                  style={`--project-tag-color: ${dynamicToken}`}
                  set:html={fullDescription}
                />
              </div>
            </div>
          )
        }

        {
          fullDescription && (
            <div class="project-drawer">
              <div class="project-drawer-inner">
                <div
                  class="prose prose-invert max-w-none text-sm sm:text-base text-zinc-200 theme-color readable-text"
                  style={`--project-tag-color: ${dynamicToken}`}
                  set:html={fullDescription}
                />
              </div>
            </div>
          )
        }
      </div>
    </div>

    <!-- RIGHT IMAGE AREA -->

    {
      backgroundImage && (
        <div class="card-preview-frame">
          <img src={backgroundImage} class="card-preview-image" alt="" />
        </div>
      )
    }
  </div>
</div>
