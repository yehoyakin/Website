---
// Purpose: Section - src/components/sections/InfoHeader.astro (Hero header info block)
import Title from "../UI/Title.astro";
import Portrait from "../shared/MyImage.astro";
import Body from "../UI/Body.astro";
import { resolveThemeToken } from "../../config/uiDictionary";

interface Props {
  name: string;
  description: string;
  portraitSrc: string;
  theme?: string;
}

const { name, description, portraitSrc, theme = "primary" } = Astro.props;

const dynamicStyle = `--project-tag-color: ${resolveThemeToken(theme)};`;
---

<div
  class="flex flex-col items-center justify-center text-center py-6 md:py-10 px-8 w-full theme-color"
  style={dynamicStyle}
>
  <Title
    level={1}
    theme={theme}
    class="text-2xl md:text-4xl tracking-[0.12em] uppercase"
  >
    {name}
  </Title>

  <div class="flex justify-center mt-4">
    <Portrait src={portraitSrc} size="md" />
  </div>

  <Body theme={theme} class="mt-3 text-sm tracking-widest uppercase">
    {description}
  </Body>
</div>
